{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// 设置项目默认编码为 GBK
		"files.encoding": "gbk",
		// 开启自动编码猜测（作为备用，提高兼容性）
		"files.autoGuessEncoding": true,
		// 针对 Python 文件单独设置为 UTF-8
		"[python]": {
			"files.encoding": "utf8",
			"files.autoGuessEncoding": false  // 关闭自动猜测，固定为 UTF-8
		},
		// 普通lua脚本：强制GBK
		"[lua]": {
			"files.encoding": "gbk",
			"files.autoGuessEncoding": false
		},
		"files.associations": {
			"*.jx3dat": "lua" // 将 *.jx3dat 文件关联为 Lua 类型
		},
		// 匹配包含 zhtw 的语言文件，强制UTF-8，支持glob匹配模式
		"encoding-guard.patternMap": {
			"**/*zhtw*.jx3dat": "utf8",
			"**/*zhcn*.jx3dat": "gbk",
			"**/*.formatted.jx3dat": "gbk",
			"**/*zhtw*.lua": "utf8",
			"**/*zhtw*.txt": "utf8",
			"**/*.ini.zh_TW": "utf8",
			"**/*.ini": "gbk",
			"**/*.txt": "gbk",
		},
	}
}