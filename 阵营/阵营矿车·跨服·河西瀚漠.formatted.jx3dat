	TALK = {
		[697] = {
			{col={255,100,100},szContent="【恶人·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。",tCountdown={{key="恶人·矿车",nClass=14,nFrame=7,nIcon=13,nTime=59,szName="浩气·劫车奖励"}}},
			{col={100,100,255},szContent="【浩气·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。",tCountdown={{key="浩气·矿车",nClass=14,nFrame=3,nIcon=13,nTime=59,szName="恶人·劫车奖励"}}},
			{col={255,100,100},szContent="不好！物资车被砸！这里不宜久留，大家先撤，待重整旗鼓再来一番！",szTarget="宋道希",tCountdown={{key="恶人·矿车",nClass=14,nFrame=7,nIcon=13,nRefresh=10,nTime=60,szName="浩气·劫车奖励"}}},
			{col={100,100,255},szContent="不好！物资车被劫！这里不宜久留，大家先撤，待重整旗鼓再来一番！",szTarget="吴宿知",tCountdown={{key="浩气·矿车",nClass=14,nFrame=3,nIcon=13,nRefresh=10,nTime=60,szName="恶人·劫车奖励"}}},
			{col={255,100,100},szContent="恶人谷的老伙计们！一路上可算没有出啥岔子。这是洒家给伙计们的报酬，且拿好。",szTarget="宋道希",tCountdown={{key="恶人·矿车",nClass=14,nFrame=3,nIcon=13,nRefresh=10,nTime=90,szName="恶人·跟车奖励"}}},
			{col={100,100,255},szContent="浩气盟的众兄弟们，辛苦了！这是盟里给众兄弟们的奖赏，请各位收下。",szTarget="吴宿知",tCountdown={{key="浩气·矿车",nClass=14,nFrame=7,nIcon=13,nRefresh=10,nTime=90,szName="浩气·跟车奖励"}}},
			{col={255,100,100},szContent="老伙计们！这一车可得小心点，这路上可有不少浩气盟的探子，有劲的一会使出来！",szTarget="宋道希",tCountdown={{key="恶人·矿车",nClass=14,nFrame=3,nIcon=13,nTime=292,szName="恶人·护送矿车"}}},
			{col={100,100,255},szContent="诸位兄弟们，这些银钱可壮大我方势力，请与我一道运送回浩气盟！",szTarget="吴宿知",tCountdown={{key="浩气·矿车",nClass=14,nFrame=7,nIcon=13,nTime=292,szName="浩气·护送矿车"}}},
