			{szContent="你在货物中发现了一把精致的琵琶与货物单不符，去问问舒归言。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·觅知音·聆聆;15,奇遇不封印·约10分钟完成;30,1.对话·舒归言;90,2.前往最高山·地图顶部中偏右",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·舒归言·前往·地图顶部"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·最高山·地图顶部中右方"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·乐笔芯·前往·碧霄海右"}}},
