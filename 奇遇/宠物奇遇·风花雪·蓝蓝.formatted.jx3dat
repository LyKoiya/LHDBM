	TALK = {
		[666] = {
			{szContent="附近似乎有人在呼唤你。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·风花雪·蓝蓝;15,奇遇不封印·约10分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·元五·出云寨与石林中间"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·段明燕·背后山顶的光圈"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往·大理山庄"}}},
			{szContent="旁边似乎有人在欣赏风景，去问问看或许能得到线索。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往大理山庄"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·段明燕·身边·光圈点"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往·晚山镇"}}},
			{szContent="你们找到了小猫的线索，但小猫仍然不见踪迹，不若再去问问一旁的段明燕。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往·晚山镇"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·段明燕·身边·光圈点"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往溶洞入口"}}},
			{szContent="苇草素白，与晚山镇的小桥流水交相映衬，但小猫仍不见踪影，还会去哪儿呢？不若再去与段明燕讨论一番。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·前往溶洞入口"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="靠近·溶洞里面的石台·剧情"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·段明燕·返回·摸宠点"}}},
			{szContent="小猫咪静静地望着荧荧的湖水。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=120,szName="对话·段明燕·返回·出云寨"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=120,szName="对话·元五·完成·宠物奇遇"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=120,szName="获得·风花雪·小猫咪·蓝蓝"}}},
