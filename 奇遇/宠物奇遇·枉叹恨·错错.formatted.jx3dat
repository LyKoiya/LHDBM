	TALK = {
		[156] = {
			{szContent="小狗朝你吠叫了两声，奔跑起来，似乎想要你跟上去。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·枉叹恨·错错;15,奇遇不封印·约10分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="跟随·错错·交互·光圈"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="打开·背包·使用·盒子"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·茶馆·对话·陈氏"}}},
			{szContent="去挖出银子的地方看看吧。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·天都镇·对话·行医学徒"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·砍柴人·对话·老妪"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·天都镇·南门·光圈"}}},
			{szContent="跟上小狗。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="跟随·错错·交互·尸体"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·茶馆·对话·陈氏"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="完成·宠物奇遇·枉叹恨"}}},
