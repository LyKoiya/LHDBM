	TALK = {
		[581] = {
			{szContent="今天姜堰似乎还有很多话想同你说，再和他聊聊吧。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·授太平·十四;15,奇遇不封印·约10分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·姜堰·前往·山阳村内"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·光圈·等待·剧情结束"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·姜通·交互·严辽"}}},
			{szContent="远处忽然传来吵闹声，去看看。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·山阳村内·交互·光圈"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="等待·剧情结束·对话·姜通"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·严辽·等待·剧情结束"}}},
			{szContent="山阳村竟敢杀害朝廷命官，弟兄们，快回去禀告刺史！撤！",szTarget="随行小吏",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·姜通·交互·严辽"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="等待剧情·对话·韦应物"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·江天夜宴·沧浪洲"}}},
			{szContent="那真是可惜。",szTarget="陌生男子",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·韦应物·前往·江天夜宴"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="神行·江天夜宴·车夫·沧浪洲"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·光圈点·等待·剧情结束"}}},
			{szContent="让贵人放心便是。",szTarget="翼奴",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·翼奴·前往·住宅东南"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·镜归渊·等待剧情结束"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·山阳村内·对话·姜堰"}}},
			{szContent="在下韦应物。",szTarget="韦应物",tCountdown={{key="奇遇提示0",nClass=14,nIcon=13,nTime=75,szName="剧情·结束剩余"}}},
			{szContent="先生所求，当会如愿。",szTarget="镜归渊",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=120,szName="返回·山阳村·对话·姜堰"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=120,szName="完成·奇遇·授太平·十四"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=-1,szName="奇遇提示3"}}},
