	TALK = {
		[-1] = {
			{szContent="你接到封演的飞鸽传书，邀你前往晟江黄槲镇西北面一会。",tCountdown={{bHold=true,key="奇遇提示1",nClass=14,nFrame=7,nIcon=12371,nTime=60,szName="前往·晟江·黄槲镇·封演"},{bHold=true,key="奇遇提示2",nClass=14,nFrame=7,nIcon=12371,nTime=60,szName="前往·晟江·茶馆·纪小橙"}}},
		},
		[582] = {
			{szContent="此后我也到了差不多能收个徒弟的年纪，虽然没有名气响亮的门派，我自己也没有厉害的称号，但我运气可好了，收到了一大堆不嫌弃我的徒弟。",szTarget="纪小橙",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12371,nRefresh=0,nTime="5,恭喜触发·侠者成歌;15,奇遇不封印·约10分钟完成;30,1.对话封演·前往晟江茶馆;120,2.对话纪小橙·前往兴威寨;150,3.靠近司空淮·攻击喽啰;160,4.对话司空淮·前往白菰里;210,5.名望区域信使旁·寻找苏舒;240,6.进入光圈·对话苏舒;420,7.对话苏舒·等待剧情;450,8.返回黄槲镇·对话封演;470,完成奇遇·侠者成歌",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="对话·纪小橙·前往·兴威寨"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="靠近·司空淮·攻击·喽啰"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="对话·司空淮·前往·白菰里"}}},
			{szContent="打不过！快跑！",szTarget="喽啰",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12371,nRefresh=0,nTime="10,4.对话司空淮·前往白菰里;60,5.名望区域信使旁·寻找苏舒;90,6.进入光圈·对话苏舒;270,7.对话苏舒·等待剧情;300,8.返回黄槲镇·对话封演;320,完成奇遇·侠者成歌",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="对话·司空淮·前往·白菰里"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="寻找·苏舒·名望区域信使旁"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="进入·光圈·对话·苏舒"}}},
			{szContent="哎……别提了……",szTarget="苏舒",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12371,nRefresh=0,nTime="30,6.进入光圈·对话苏舒;210,7.对话苏舒·等待剧情;240,8.返回黄槲镇·对话封演;260,完成奇遇·侠者成歌",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="对话·苏舒·等待剧情"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="返回·黄槲镇·封演"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12371,nTime=600,szName="完成·奇遇·侠者成歌"}}},
