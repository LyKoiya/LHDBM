	TALK = {
		[578] = {
			{szContent="旁边好像有情况，快过去看看吧！",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·重洋客·索索;15,奇遇不封印·约15分钟完成;30,对话波塔·沿西北小路走;60,对话刀宗打扫弟子;120,前往云宽村·村字南·溪水岸边",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·波塔·前往·西北小路"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·刀宗打扫弟子·云宽村"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·村字南·溪水岸·阿莱"}}},
			{szContent="发现散落的白色羽毛，在附近问问他人吧！",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·刀宗打扫弟子·云宽村"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·村字南·溪水岸·阿莱"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·渔具·对话阿莱·上山"}}},
			{szContent="似有黑衣人闪过，不如前去山上看看！",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="沿路·上山·对话·阿莱两次"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·山下·西边小岛·钓者"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="伪装·送饭之人·暗号选项一"}}},
			{szContent="看到没？就是那片海滩！那位爷爷也在那个方向上！你去看看吧！",szTarget="阿莱",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·山下·西边小岛·钓者"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="伪装·送饭之人·暗号选项一"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·小的箱子·返回·阿莱"}}},
			{szContent="你被丢了出来",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·钓者·伪装·送饭之人"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="暗号·选项一·交互·小箱子"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·云宽村·云字北·阿莱"}}},
			{szContent="快去海食湾找阿莱汇合吧。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·云宽村·云字北桥"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·阿莱·获得·药物"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·索索·对话·阿莱"}}},
			{szContent="诺~那我先走啦，谢谢你！大侠！",szTarget="波塔",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="对话·阿莱·获得·药物"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="交互·索索·对话·阿莱"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="完成·奇遇重洋客·索索"}}},
