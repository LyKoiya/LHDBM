	TALK = {
		[701] = {
			{szContent="突然一只老鼠窜了出来！看看它窜去哪儿了？",szNote="触发·宠物奇遇·妖与狸·一团黑大人",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·妖与狸·一团黑大人;15,奇遇不封印·约5分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·林清·对话·张大"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·划痕·毛发·老鼠"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·张大·互动·杂物堆"}}},
			{szContent="怎么看着像狸子，回去找张大问问。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·张大·互动·杂物堆"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="获得·捕鼠笼·对话·张大"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·光圈·使用·捕鼠笼"}}},
			{szContent="吱——吱吱！",szTarget="老鼠",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·捕鼠笼·对话·张大"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·林清·前往·马厩处"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·大猫·对话·林清"}}},
			{szContent="张大，你可知何处老鼠出没最多？",szNote="完成·宠物奇遇·妖与狸",szTarget="林清",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="完成·宠物奇遇·妖与狸"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="获得·宠物·一团黑大人"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=0,szName="奇遇提示3"}}},
