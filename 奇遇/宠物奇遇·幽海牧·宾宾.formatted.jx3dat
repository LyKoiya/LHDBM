		[217] = {
			{szContent="唉......昨天突然有沙暴来袭，把毡房刮得东倒西歪，这可怎么收拾啊。",szTarget="沙木沙克",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·幽海牧·宾宾;15,奇遇不封印·约10分钟完成;60,1.对话沙木沙克·交互光圈;90,2.等待剧情·返回沙木沙克;150,3.对话玛伊莎·前往苦海西边;180,4.对话夏哈甫·交互山上光圈;200,5.返回夏哈甫·与夏哈甫找羊;300,6.半月湖·星星海·大蛇冢;360,7.前往苦海打水·返回夏哈甫;420,8.前往地图最下方中间·光圈;480,9.跟随夏哈甫·等待剧情;530,10.前往幽幽海·对话许库尔;580,11.返回夏哈甫;600,完成奇遇·幽海牧·宾宾",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·沙木沙克·交互·光圈"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="等待·剧情·返回·沙木沙克"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·玛伊莎·前往·苦海西"}}},
