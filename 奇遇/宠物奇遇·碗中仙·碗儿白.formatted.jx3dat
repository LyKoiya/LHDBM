	TALK = {
		[718] = {
			{szContent="刘一竿似乎有话要说。",szNote="恭喜触发·宠物奇遇·碗中仙·碗儿白",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·宠物奇遇·碗中仙·碗儿白;15,奇遇不封印·约5分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·刘一竿·对话·阿镯"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·千舟镇·对话·余德厚"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="采集·骨碎补·对话·余德厚"}}},
			{szContent="这碗是我的宝贝，不是你的窝。你倒一屁股占得严实，半点不客气。",szTarget="阿镯",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·阿镯·前往·千舟镇"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·余德厚·采集·骨碎补"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·余德厚·返回·刘一竿"}}},
			{szContent="老朽这就出诊，稍后去白鹭处寻老朽便是。",szTarget="余德厚",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·刘一竿·对话·余德厚"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·千舟镇·对话·李闻宝"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·碗儿白·完成宠物奇遇"}}},
			{szContent="是时候了，上前质问李闻宝吧。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=30,szName="对话·李闻宝·对话·碗儿白"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=30,szName="完成·宠物奇遇·碗中仙"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=30,szName="宠物·奇遇奖励·碗儿白"}}},
