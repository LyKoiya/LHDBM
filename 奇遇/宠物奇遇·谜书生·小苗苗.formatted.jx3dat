	TALK = {
		[6] = {
			{szContent="这只毛丝鼠身上好像掉落了一支金钗。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·谜书生·小苗苗;15,奇遇不封印·约5分钟完成;40,1.交互带血的金钗·跟随血迹;60,2.前往西南树下·对话谢长安;120,3.前往再来镇药店·交易冯德;180,4.购买上品止血散·返回荀鸢;210,5.前往冯德身后·对话药店掌柜;240,6.前往武器商人·对话谢长安;270,7.前往萧白胭附近·对话荀鸢;300,8.前往扬州码头·对话荀鸢;320,完成奇遇·谜书生·小苗苗",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·带血的金钗·跟随·血迹"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·西南树下·对话·谢长安"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·再来镇药店·交易·冯德"}}},
