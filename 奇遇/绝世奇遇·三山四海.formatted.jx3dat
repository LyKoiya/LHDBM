		[100] = {
			{bSearch=true,szContent="{$me}， 快到我这里来，小心被封影发现了。",szNote="三山四海·靠近·附近·王志",szTarget="王志",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12372,nTime=10,szName="靠近·附近·王志"}}},
			{szContent="把我给你的丹药吃了吧，可在危难之时保你一命，就在你的背包里。",szNote="三山四海·步骤·护心丹",szTarget="王志",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12372,nTime=10,szName="三山四海·步骤·护心丹"}}},
			{szContent="看到没？我的妻子何嫣就在前面，被关在那个牢笼里。",szTarget="王志",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12372,nRefresh=0,nTime="26,等待剧情·呆在原地勿动;35,使用引爆器·交互牢笼",szName="奇遇提示0"}}},
