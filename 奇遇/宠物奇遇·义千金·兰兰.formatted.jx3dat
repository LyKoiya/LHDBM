	TALK = {
		[8] = {
			{szContent="你打算再叫一盘，却看掌柜娜姿愁容满面，并没有注意到你。",tCountdown={{key="奇遇提示0",nClass=14,nFrame=0,nIcon=12373,nRefresh=0,nTime="5,恭喜触发·义千金·兰兰;15,奇遇不封印·约10分钟完成",szName="奇遇提示0"},{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·娜姿·前往·风啸林"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="等待·剧情·对话·张野"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="带着·小驴·前往·风雨镇"}}},
			{szContent="大、大哥，这个人看起来是个能打的……",szTarget="王开",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·张野·带着·小驴"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="缓慢·前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{szContent="小驴很开心的跟着你。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="带着·小驴·缓慢·移动"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{[14]={bCenterAlarm=true},szContent="小驴停下脚步，它可能需要更多的鼓励，跟它聊聊天吧。",szNote="交互·小驴",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·小驴·缓慢·移动"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{szContent="小驴很开心，你去哪，它也去哪。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="带着·小驴·缓慢·移动"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{szContent="小驴跟丢了。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·张野·寻找·小驴"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{szContent="小驴跑远了，不见踪影，再回去找找吧。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="返回·张野·寻找·小驴"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="前往·风雨镇·入口"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="进入·剧情·对话·兰伊"}}},
			{szContent="兰伊似乎有些不情愿，不若再与她谈谈。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·兰伊·返回·娜姿"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·兰伊·对话·方旬"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="交互·秘方·对话·娜姿"}}},
			{szContent="兰伊擦着眼泪去找兰兰告别，不远处的一位白衣侠客却示意你过去。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·方旬·交互·秘方"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·娜姿·等待·剧情"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=600,szName="对话·方旬·返回·兰伊"}}},
			{szContent="娜姿生怕方旬反悔，当即在契上画了押，拿了金子。",tCountdown={{key="奇遇提示1",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="对话·方旬·返回·兰伊"},{key="奇遇提示2",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="对话·兰伊·完成·奇遇"},{key="奇遇提示3",nClass=14,nFrame=7,nIcon=12373,nTime=60,szName="奇遇·义千金·宠物兰兰"}}},
