	CHAT = {
		[2] = {
			{szContent="中原战乱数年未休，东方谷主感于天下不宁，百姓罹难，病症者缺医少药，朝不保夕。决定在今日开放万花谷，让百姓入谷就医。以一谷之清静，换万千百姓之安宁。万花药王孙思邈在此宣布：万花门派事件“开谷济苍生”正式开始，各位侠士可前来青岩万花施以援手！\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="万花·门派事件·星落湖"}}},
			{szContent="万花昨日开谷，毒人来犯，晴昼海意外被毁，狼牙贼心不死再度来袭，万花开谷能否顺利进行？花圣宇晴发起委托，各侠士可前往万花与万花弟子一起修复花海，抵御狼牙。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="万花·门派事件·星落湖"}}},
		},
		[5] = {
			{szContent="东瀛使团已上少林，两国高僧禅武相较。众侠士请速至少林寺观摩盛会，必能获益匪浅。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="少林·门派事件·少林寺前门"}}},
			{szContent="少林众僧慈悲为怀，正设法救治重伤的虚念大师，众侠士请速至少林与会，共结善缘。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="少林·门派事件·少林寺"}}},
		},
		[7] = {
			{szContent="你在【纯阳·星野剑阵·布阵】公共事件中的个人贡献度增加了10分。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=3,nIcon=13,nTime=2,szName="门派事件·星野剑阵·布阵+10分"}}},
			{szContent="纯阳观在太极广场搭起多座祭坛、并设香炉数座，侠士可焚香供奉老祖，亦或观摩、助纯阳炼丹，亦或是为族人、挚友刻下祈福锁祈福，纯阳观均有好礼相赠。此外，诸位侠士还可通过太极广场中三个祭坛，体验纯阳轻身秘术，若有能者摘得空中纸符，便可得老祖护佑。\
",tCountdown={{key="门派事件1",nClass=20,nIcon=13,nTime=10,szName="纯阳·门派事件·太极广场"}}},
			{szContent="诸侠士需协助纯阳修复、完成剑阵，并协力抵御星宿老仙的进攻。星宿老仙千秋子于小星宿海中获得武侯移星术以及上古毒经残卷的另外版本后，闭关潜心修炼秘术多年，如今实力更胜从先，侠士须得小心行事。\
",szNote="纯阳·门派事件",tCountdown={{key="门派事件1",nClass=20,nIcon=13,nTime=10,szName="纯阳·门派事件·太极广场"}}},
		},
		[16] = {
			{szContent="七秀正举行剑舞考核，侠士可前往七秀听香坊东侧水上舞台参与，观赏七秀剑舞考核。侠士可通过参与楚秀弟子夏年、绮秀弟子佟雅辰、燕秀弟子慕容晚的考核来获得奖励。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="七秀·门派事件·水上舞台"}}},
			{szContent="七秀坊坊主叶芷青邀请诸位侠士见证其为三位弟子授剑出师，侠士可前往七秀听香坊东侧水上舞台参与。中途若是遇上寻衅滋事之人，侠士可与三位弟子联手制伏。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="七秀·门派事件·水上舞台"}}},
		},
		[49] = {
			{szContent="藏锋十年刃方雪，乱世仍需铸仁心。每一把名剑的出世都同藏剑山庄的兴衰息息相关。今日，藏剑山庄与天下众侠士共襄盛举。请众位侠士速至藏剑山庄楼外楼，为名剑的诞生贡献自己的力量，莫要错过了这百年难逢的机会。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="藏剑·门派事件·楼外楼"}}},
			{szContent="十年磨一剑，霜刃未曾试。今日把示君，谁有不平事。新名剑其名为何，其锋何利？若想知道新一代名剑的秘密，可来藏剑山庄楼外楼同叶庄主一起参详一二。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="藏剑·门派事件·楼外楼"}}},
		},
		[102] = {
			{szContent="天一教余孽未平，曲云教主派出清缴的教众尚未返回，而公治菱在圣兽潭附近携植尸将结阵施法召来血魂巨蚊，望侠士前往相助，若稍有半分差池，引来天一教神秘植兽便不好办了。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="五毒·门派事件·圣兽潭"}}},
			{szContent="原来是乌缇夜昨夜趁乱乔装混入五毒总坛，用天一教邪术催熟血魂巨蚊虫卵，引来嗜食血蚊的植兽“噬魂金虎”，愿侠士出手相助，将此邪恶之物铲除。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="五毒·门派事件·五毒总坛"}}},
		},
		[122] = {
			{szContent="唐门的机甲之战方告一段落，今日狼牙军官拔野古寒上唐门欲取订好的机关暗器，只是唐门已无备好的暗器，此事要如何了结？诸位侠士可去唐家堡获知此事结果。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="唐门·门派事件·唐家堡"}}},
			{szContent="安禄山在范阳举起反旗，天下人人侧目。唐门门主唐傲天却甘冒天下之大不韪，偷偷贩售门中机关暗器予狼牙军和唐军两者，获得大批钱财。唐傲侠发现了他私底下的交易，不耻唐傲天所为，派大儿子唐无寻破坏门主准备好的机关。此事亦被掌管暗器的唐无乐发觉，两兄弟在唐门唐家堡用机甲对决，诸位侠士可前去一观输赢。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="唐门·门派事件·唐家堡"}}},
		},
		[150] = {
			{szContent="明教正在举行明尊大典，侠士可前往明教圣墓山参与盛会。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="明教·门派事件·圣墓山"}}},
			{szContent="明教正召集人手清剿红衣教势力，侠士可前往明教三生树附近参与。\
