		},
		[158] = {
			{szContent="安庆绪倒行逆施，欲派人出海寻找龙脉，天策密探阶苔获取关键情报，不料身份泄露被无名手下追杀。请诸位侠士速至战乱天策药师观接应阶苔归来。\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="天策·战乱·门派事件·药师观"}}},
			{szContent="天策密探阶苔屡次逃脱，无名震怒之下，亲自前来。此番，阶苔能否逃脱无名追杀呢？\
",tCountdown={{key="门派事件1",nClass=20,nFrame=0,nIcon=13,nTime=10,szName="天策·战乱·门派事件·药师观"}}},
		},
		[159] = {
			{szContent="波光鳞影鱼欢跃，湖边垂钓闲趣多。君山洞庭，尤鱼类繁多。还请各路侠士移驾君山丐帮洞庭水畔垂钓，一来为老帮主之寿宴做些准备，二来亦可广交天下之英杰！\
