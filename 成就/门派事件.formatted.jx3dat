	TALK = {
		[2] = {
			{[14]={bCenterAlarm=true},bReg=true,szContent="{$me}.-需要([包扎服用汤剂运气]+).-[。]+",szNote="医者仁心·{$1}",szTarget="裴元",tCountdown={{key="包扎",nClass=14,nFrame=-1,nIcon=13,nRefresh=600,nTime=-1,szName=" "},{key="服用汤剂",nClass=14,nFrame=-1,nIcon=13,nRefresh=600,nTime=-1,szName=" "},{key="运气",nClass=14,nFrame=-1,nIcon=13,nRefresh=600,nTime=-1,szName=" "},{key="{$1}",nClass=14,nFrame=-1,nIcon=1465,nTime=-2,szName=" "},{key="包扎",nClass=14,nFrame=6,nIcon=106,nRefresh=600,nTime=5,szName="医者仁心·包扎绷带"},{key="服用汤剂",nClass=14,nFrame=6,nIcon=4476,nRefresh=600,nTime=5,szName="医者仁心·服用汤剂"},{key="运气",nClass=14,nFrame=6,nIcon=1512,nRefresh=600,nTime=5,szName="医者仁心·运气通络"}}},
			{szContent="万花众弟子听命：青岩开谷，放开禁制，接引百姓入谷！",szTarget="东方宇轩",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件1·开谷济苍生·星落湖"}}},
			{szContent="万花弟子听令！立刻设防落星湖！不可使毒人侵扰就医百姓！",szTarget="东方宇轩",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件2·恶徒乱晴昼·晴昼海"}}},
			{szContent="速速通知孙先生和宇晴前往查看，万不可使毒雾外泄！",szTarget="东方宇轩",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件3·奇草化毒雾·晴昼海"},{key="门派事件3·提示",nClass=14,nFrame=3,nIcon=13,nTime=20.1,szName="拾取曦芜花放置在毒圈上"}}},
			{szContent="烦请各位侠士将大家带来的花草移植到花海深处。",szTarget="宇晴",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件1·献花复晴昼·星落湖"}}},
			{szContent="栽种花苗的位置已经标记，可打开中地图随时查看",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=20,nTime=30,szName="看小地图绿点·放置花苗"}}},
			{szContent="万花众弟子小心戒备！不可使其入山！",szTarget="东方宇轩",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件2·花海阻狼牙·晴昼海西南"}}},
			{szContent="传某将令！死士进击！",szTarget="令狐潮",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nRefresh=360,nTime=20,szName="门派事件2·晴昼海西南·令狐潮"}}},
			{szContent="谷主将在山门针对此次开谷进行训诫，谷内弟子速速前来。",szTarget="万花弟子",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nRefresh=360,nTime=5,szName="门派事件2·花海阻狼牙·结束"}}},
		},
		[5] = {
			{szContent="正合我意！",szTarget="仲虚念",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件1·禅斗较量·仲虚念"}}},
			{szContent="你烦不烦啊！",szTarget="仲虚念",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·禅斗较量·结束"}}},
			{szContent="大言不惭！",szTarget="仲虚念",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件2·武斗较量·仲虚念"}}},
			{szContent="大师，小心了！",szTarget="慧武",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·武斗较量·结束"}}},
			{szContent="好个金刚伏魔阵！可能及我万一！",szTarget="东瀛的自傲",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件2·荡除心魔·东瀛的自傲"}}},
			{szContent="不！",szTarget="东瀛的自傲",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·东瀛的自傲·结束"}}},
			{szContent="笑话，心境澄明之人世间又有几个！",szTarget="武士的尊严",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件3·荡除心魔·武士的尊严"}}},
			{szContent="这怎么可能！",szTarget="武士的尊严",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件3·武士的尊严·结束"}}},
			{szContent="一刀流岂是尔等所能企及！",szTarget="一刀流的荣耀",tCountdown={{key="门派事件4",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件4·荡除心魔·一刀流的荣耀"}}},
			{szContent="就这么......结束了么......",szTarget="一刀流的荣耀",tCountdown={{key="门派事件4",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件4·一刀流的荣耀·结束"}}},
			{szContent="论禅论武，我都绝对不会输！",szTarget="禅武的执念",tCountdown={{key="门派事件5",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件5·荡除心魔·禅武的执念"}}},
			{szContent="一念......放下......",szTarget="禅武的执念",tCountdown={{key="门派事件5",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件5·禅武的执念·结束"}}},
		},
		[7] = {
			{szContent="多谢诸位侠士，我和二位师弟先行回大殿议事。",szTarget="李忘生",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·西昇大典·结束"}}},
			{szContent="各位侠士请帮我们灭掉星宿据点！",szTarget="于睿",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·地图标记·攻击BOSS"}}},
			{szContent="区区星野剑阵，不过浪得虚名，如何能与我星宿派武侯移星术相比？",szTarget="千秋子",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·千秋子·刷新"}}},
			{szContent="我修习上古毒经与武侯移星术，今已大成，你们尽管一起上吧！哈哈哈哈！",szTarget="千秋子",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·千秋子·已刷新"}}},
			{szContent="此等恶人不除不快，诸位侠士，还请助我纯阳守护剑阵，灭了此人威风！",szTarget="卓凤鸣",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件·地图标记·攻击BOSS"}}},
			{szContent="多谢各位侠士仗义出手。",szTarget="李忘生",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·星野剑阵·结束"}}},
			{szContent="各位侠士需以自身精气养之，才可触发天玑剑气。",szTarget="李忘生",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=300,nTime=10,szName="门派事件1·星野剑阵·天玑剑"}}},
			{szContent="有劳各位侠士将吾身后剑匣中剑置于玉衡剑阵眼旁，让玉衡剑吸收其中罡气。",szTarget="李忘生",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=300,nTime=10,szName="门派事件1·星野剑阵·玉衡剑"}}},
			{szContent="还请诸位侠士相助，取三清符，然后到至高处汲取天地元气，并贴于摇光剑身，以激活摇光剑气。",szTarget="李忘生",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=300,nTime=10,szName="门派事件1·星野剑阵·摇光剑"}}},
			{szContent="多谢各位侠士！下一批物资将会在稍后运送！",szTarget="祁进",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件·山门卫道·结束"}}},
			{szContent="我纯阳宫运送西昇祭的物资车在往太极广场的路上，麻烦各位侠士前往护送！",szTarget="祁进",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·山门卫道·太极广场"}}},
			{szContent="我纯阳宫运送西昇祭的物资车应该在往老君宫的路上，麻烦各位侠士前往护送！",szTarget="祁进",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·山门卫道·老君宫"}}},
			{szContent="我纯阳宫运送西昇祭的物资车应该在往纯阳宫正门的路上，麻烦各位侠士前往护送！",szTarget="祁进",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·山门卫道·纯阳宫正门"}}},
			{szContent="不好！马车受了惊吓，劳烦各位侠士帮我们拾取掉落在地上的物资！",szTarget="纯阳弟子",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=120,nTime=2,szName="门派事件·山门卫道·拾取物资"}}},
		},
		[16] = {
			{szContent="【七秀·红袖飞花】事件已经结束，由于你没有贡献，没有获得奖励。",tCountdown={{key="门派事件1",nClass=14,nFrame=5,nIcon=13,nTime=5,szName="门派事件1·红袖飞花·结束"}}},
			{szContent="你获得了事件【七秀·红袖飞花】的奖励。",tCountdown={{key="门派事件1",nClass=14,nFrame=5,nIcon=13,nTime=5,szName="门派事件1·红袖飞花·结束"}}},
			{szContent="第二场比试开始，绮秀弟子佟雅辰出场。",szTarget="照萤",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·剑舞凝光·佟雅辰·开启"}}},
			{szContent="你可算是醒过来了！江湖险恶，一定要诸般小心。七秀坊的姐妹们会好生照应你的。",szTarget="瑾儿",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·剑舞凝光·佟雅辰·结束"}}},
			{szContent="第三场比试开始，燕秀弟子慕容晚出场。",szTarget="照萤",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件3·剑舞凝光·慕容晚·开启"}}},
			{szContent="二位以为如何？",szTarget="叶芷青",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件3·剑舞凝光·慕容晚·结束"}}},
			{szContent="第一场比试开始，楚秀弟子夏年出场。",szTarget="照萤",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·剑舞凝光·夏年·开启"}}},
			{szContent="！！",szTarget="白璃予",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·东海来客·白璃予·开启"}}},
			{szContent="哼，想不到你们还有点儿能耐，那我也就不客气了！",szTarget="白璃予",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·东海来客·白璃予·结束"}}},
			{szContent="结阵！",szTarget="佟雅辰",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·东海来客·结阵·开启"}}},
			{szContent="呃……",szTarget="白璃予",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·东海来客·结阵·结束"}}},
		},
		[49] = {
			{szContent="众弟子，随我迎敌！",szTarget="叶凡",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·抵御狼牙·慕容枯"}}},
			{szContent="大胆狂徒！今日天下英雄尽聚于此，尔等焉敢猖狂，众弟子迎敌！",szTarget="叶炜",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·名剑新生·开启"}}},
			{szContent="都来了？也好，让我领教领教藏剑山庄的绝技。",szTarget="慕容古",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·以贼试剑·慕容枯"}}},
			{szContent="这是……什么剑法……",szTarget="慕容古",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·以贼试剑·结束"}}},
		},
		[102] = {
			{szContent="我们不是这女人的对手,请侠士们出手相助!",szTarget="苗民卫兵",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=120,nTime=10,szName="门派事件1·圣兽潭·天一阴谋"}}},
			{szContent="这次多亏了侠士们及时赶到，才使我教免于一场劫难。",szTarget="曲云",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=120,nTime=5,szName="门派事件1·天一阴谋·结束"}}},
			{szContent="圣兽潭附近还有残余血蚊，望侠士们帮忙清理，此刻我还需带孙飞亮回总坛疗伤。",szTarget="曲云",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nRefresh=120,nTime=10,szName="门派事件2·圣兽潭·清除剩余血蚊"}}},
			{szContent="玛索师姐已去炼制血蚊丹，炼成后可以引走金虎，望众侠士相助五毒教，抵挡这植兽！",szTarget="五毒大师兄",tCountdown={{key="门派事件1",nClass=14,nFrame=0,nIcon=13,nTime=10,szName="门派事件1·五毒总坛·噬魂金虎"}}},
			{szContent="多亏侠士们拼死抵挡这植兽，刚才我用昨日侠士击杀血蚊炼成血蚊丹，已命教内轻功拔尖的教众携带这丹药向天一教老巢赶去。",szTarget="玛索",tCountdown={{key="门派事件1",nClass=14,nFrame=0,nIcon=13,nTime=5,szName="门派事件1·噬魂金虎·结束"}}},
			{szContent="我还要前去天一老巢打探一番，不要让我教众被这噬魂金虎误伤，告辞了！",szTarget="玛索",tCountdown={{key="门派事件2",nClass=14,nFrame=0,nIcon=13,nRefresh=120,nTime=10,szName="门派事件2·五毒总坛·清除剩余血蚊"}}},
		},
		[122] = {
			{szContent="无乐，过几年我也懒得再管你的事了，你自己好自为之。",szTarget="唐无寻",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·唐家堡·修复机甲"}}},
			{szContent="无乐，我方制造的机甲已成型，你可莫要逃了。",szTarget="唐无寻",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·修复机甲·结束"}}},
			{szContent="呵呵，大言不惭。胜负成败，就看此一战。上吧！",szTarget="唐无寻",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·唐家堡·机甲对决"}}},
			{szContent="竟是输你一成……没想到大哥你的机甲制造术又精进不少。",szTarget="唐无乐",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·机甲对决·结束"}}},
			{szContent="哼！诸位侠士请助我们护住机甲。",szTarget="唐无寻",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·唐家堡·对抗狼牙"}}},
			{szContent="好！多亏诸位侠士相助，机甲已经休整完毕，狼牙的末日到了！",szTarget="唐无乐",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·对抗狼牙·御敌·结束"}}},
			{szContent="看看是谁在说大话！",szTarget="跋野古寒",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·唐家堡·对抗狼牙·斩首"}}},
			{szContent="诸位侠士当心！机甲将会在十秒后自爆，唐门所属！准备撤！",szTarget="唐无寻",tCountdown={{key="门派事件2·提示",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="机甲自爆·远离"}}},
			{szContent="啊，我不甘心啊。",szTarget="跋野古寒",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·对抗狼牙斩首·结束"}}},
		},
		[150] = {
			{szContent="如此，我们就同心相祈，大会这便开始。",szTarget="陆烟儿",tCountdown={{key="门派事件1",nClass=14,nFrame=0,nIcon=13,nTime=20,szName="门派事件1·圣墓山·明尊大典·祈"}}},
			{szContent="杀掉那些中原人！！",szTarget="宫觥",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·圣墓山·宫觥"}}},
			{szContent="恐怕今日来的只是红衣教先遣教徒，明日还会有一场大战。",szTarget="丁君",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·宫觥·结束"}}},
			{szContent="果然不出所料，红衣教昨日只是派出刺客先行，捣乱祈愿大会。",szTarget="陆烟儿",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·三生树·血染红衣"}}},
			{szContent="红衣教徒已尽数消灭，多谢各位侠士仗义援手！",szTarget="陆烟儿",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·血染红衣·结束"}}},
		},
		[158] = {
			{szContent="走吧，曹将军还在等我们。",szTarget="阶苔",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件1·药师观·接应阶苔"}}},
			{szContent="多谢诸位侠士鼎立相助，阶苔在此谢过。",szTarget="阶苔",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·接应阶苔·结束"}}},
			{szContent="请诸位侠士为我守护片刻。",szTarget="阶苔",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件2·药师观·刺客袭击"}}},
			{szContent="大好头颅在此，尽管来拿！",szTarget="阶苔",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件3·药师观·游龙先生"}}},
			{szContent="人多势众，算什么好汉！我隐元会不会放弃的！",szTarget="游龙先生",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件3·游龙先生·结束"}}},
			{szContent="有点本事，那我来亲自会会你。",szTarget="无名",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件1·药师观·击退无名"}}},
			{szContent="今天我奈何不得你天策府，自然不会再纠缠此事。不过，我却做不了安将军的主，就此告辞。",szTarget="无名",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·击退无名·结束"}}},
		},
		[159] = {
			{szContent="请大家稍事休息，老夫这就酿下一桶！",szTarget="蒋方文",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·美酒飘香·备材·开启"}}},
			{szContent="感谢大家鼎力相助，老夫这就开始用内功催发酒力。不过此处经常会有棕熊前来偷酒，还请各位相助一二。",szTarget="蒋方文",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·美酒飘香·酿酒·开启"}}},
			{szContent="哈哈哈！这酒算是成了！感谢各位的鼎力相助，蒋某不胜感激！",szTarget="蒋方文",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件·美酒飘香·酿酒·结束"}}},
			{szContent="有刺客！！！保护师父！！",szTarget="郭岩",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·刺客来袭·开启"}}},
			{szContent="师弟，此处就交于我，你且护着师父师母退后！",szTarget="郭岩",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·沈眠风之乱·开启"}}},
			{szContent="我们追！",szTarget="尹放",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件·沈眠风之乱·结束"}}},
			{szContent="各位可以来我这里领取钓竿，然后就在我身边的浅滩上垂钓，莫要走远了。钓到了鱼儿便放入我身边的鱼篓中即可！",szTarget="尹小荷",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·洞庭虹影·开启"}}},
			{szContent="相传这水中有一只万年巨龟，莫不是惊动了它？真是天助我也，大家齐心斩了这巨龟，将其龟甲献给老帮主定是极好的！",szTarget="尹小荷",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·洞庭虹影·斩龟"}}},
			{[14]={bCenterAlarm=true},szContent="好像有鱼儿上钩了，快收杆！",szNote="有鱼咬钩",tCountdown={{key="钓鱼提示",nClass=14,nFrame=2,nIcon=2678,nTime=5,szName="快收杆"}}},
		},
		[193] = {
			{szContent="今日收获了如此之多的寒冰雪莲，众将士辛苦了！不过大敌当前，仍需加紧训练！",szTarget="燕安",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件·养兵千日·结束"}}},
			{szContent="探子来报，奚人近日恐是要进攻了，大家务必抓紧训练！通过苍云堡内的训练可获寒冰雪莲，上缴者有赏！",szTarget="燕安",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件·养兵千日·开启"}}},
			{szContent="我萨楚日率兵前来攻城！苍云小儿若是快快打开城门就放你们一条生路！哈哈哈哈！",szTarget="萨楚日",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·地图标记·萨楚日"}}},
			{szContent="今日东陉关得守，不仅是众苍云将士之功，更要多谢各位武林豪杰相助！",szTarget="申屠远",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·萨楚日·结束"}}},
			{szContent="想不到你们在如此情况下还能坚持这么久，看来是我们小瞧了你们！",szTarget="塔拉",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·地图标记·塔拉"}}},
			{szContent="多谢各路英豪前来相助，苍云的众将士也打起精神来，务必要守住这东陉关！",szTarget="申屠远",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·塔拉·结束"}}},
			{szContent="萨楚日和塔拉那两个废物真是给奚人丢脸，哼，受死吧！",szTarget="唐和斯",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件3·地图标记·唐和斯"}}},
			{szContent="真是废物，连这种小事都做不好！哼！",szTarget="库莫",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·锡喇·锡尔哈·结束"}}},
			{szContent="废话还真是多！众将士听令！",szTarget="长孙忘情",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·地图标记·库莫"}}},
			{szContent="哼！就凭你们便妄图灭我苍云军？真是自不量力！全军听令！今日便让这狂妄之徒有来无回！",szTarget="长孙忘情",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·库莫·结束"}}},
			{szContent="胆敢前来犯我苍云军者，诛！",szTarget="长孙忘情",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·锡喇·锡尔哈·结束"}}},
		},
		[213] = {
			{szContent="开始罢。",szTarget="韩非池",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·音律之试·琴·开启"}}},
			{szContent="壁垒的坚固程度往往与抚琴者的内力相合。众位侠士花了这许时间才破除壁垒，可见贤弟的弦歌比几月前又精进了。",szTarget="杨青月",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·音律之试·结束"}}},
			{szContent="好，这就开始。随我来!",szTarget="赵宫商",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·音律之试·幻影·开启"}}},
			{szContent="幻像已破，火候有欠。",szTarget="韩非池",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·音律之试·结束"}}},
			{szContent="宫商的《清弦引梦》现进入第二阶段，我们继续跟着。",szTarget="杨青月",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件3·音律之试·幻影·开启"}}},
			{szContent="嗯，待他从梦境中醒来细聊。",szTarget="杨青月",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件3·音律之试·结束"}}},
		},
		[243] = {
			{szContent="霜林出现了厉害的吊睛白虎，正在狩猎的侠士们可以找到这猛兽一试身手！",szTarget="柳辰苇",tCountdown={{key="门派事件·{$N55356}",nClass=14,nFrame=3,nIcon=13,nTime=20,szName="门派事件·{$N55356}·出现"}}},
			{szContent="你获得了事件【霸刀·杀意四伏】的奖励。",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·杀意四伏·结束"}}},
			{szContent="可惜尔等管了这不该管的闲事，我便留不得你们了！",szTarget="唐花",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件2·机关重重·唐花"}}},
			{szContent="咳咳……",szTarget="唐花",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件2·机关重重·结束"}}},
			{szContent="说甚么胡话！唐家妹子，你且先去！速速将此处情形告知蛇仙！咱尚能抵得一时！",szTarget="重楼子",tCountdown={{key="门派事件3",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件3·星暗长林·重楼子"}}},
			{szContent="咳咳……",szTarget="重楼子",tCountdown={{key="门派事件2",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件3·星暗长林·结束"}}},
			{szContent="哎呀哎呀，将军不要那么凶嘛。",szTarget="蛇仙女",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=10,szName="门派事件1·蛇魅狼影·蛇仙女"}}},
			{szContent="哎呀哎呀，原来是夫人来了。",szTarget="蛇仙女",tCountdown={{key="门派事件1",nClass=14,nFrame=3,nIcon=13,nTime=5,szName="门派事件1·蛇魅狼影·结束"}}},
		},
	},
