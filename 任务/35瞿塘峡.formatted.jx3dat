	TALK = {
		[35] = {
			{szContent="不好，水灵珠破裂了。我的幻身很快就会消失，快去下一个地点吧。",szTarget="源明雅",tCountdown={{key="寻龙勘脉窥天机·开启",nClass=14,nIcon=4975,nTime=10,szName="寻龙勘脉·水灵珠·破裂"}}},
			{szContent="今天就到此为止吧，有劳了。",szTarget="源明雅",tCountdown={{key="寻龙勘脉窥天机·开启",nClass=14,nIcon=4975,nTime=10,szName="寻龙勘脉·任务完成"}}},
			{szContent="竟然能打败守护灵，你的身手不错。现在去下一个地点吧。",szTarget="源明雅",tCountdown={{key="寻龙勘脉窥天机·开启",nClass=14,nIcon=4975,nTime=5,szName="寻龙勘脉·成功+1"}}},
			{szContent="不好，附近龙脉的守护灵被惊动了。",szTarget="源明雅",tCountdown={{key="寻龙勘脉窥天机·开启",nClass=14,nIcon=4975,nRefresh=0,nTime="6.6,食业朱猿·激活剩余;54,寻龙勘脉·结束剩余",szName="寻龙勘脉·地脉守护灵"}}},
			{szContent="我现在要使用这个水灵珠激活附近的地脉。",szTarget="源明雅",tCountdown={{key="寻龙勘脉窥天机·开启",nClass=14,nIcon=4975,nRefresh=0,nTime="10,寻龙勘脉·开启;63,食业朱猿·刷新剩余;69.6,食业朱猿·激活剩余;117,寻龙勘脉·结束剩余",szName="寻龙勘脉·开启"}}},
			{szContent="那个东瀛的小子你给我出来，带着人在我十二连环坞的地头上装神弄鬼，搞什么呢，弟兄们，砸了他们的场子！",szTarget="宇文画",tCountdown={{key="宇文画·刷新",nClass=14,nIcon=4891,nTime=10,szName="宇文画·已刷新"}}},
			{szContent="哼，东瀛的小子，算你们狠，弟兄们，我们撤！",szTarget="宇文画",tCountdown={{key="宇文画·刷新",nClass=14,nIcon=4891,nTime=5,szName="宇文画·已击退"}}},
		},
	},
