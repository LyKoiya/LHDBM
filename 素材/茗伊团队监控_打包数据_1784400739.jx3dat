		},
		[122] = {
			{szTarget="唐无寻",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·唐家堡·修复机甲",nTime=10,key="门派事件1"}},szContent="无乐，过几年我也懒得再管你的事了，你自己好自为之。"},
			{szTarget="唐无寻",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·修复机甲·结束",nTime=5,key="门派事件1"}},szContent="无乐，我方制造的机甲已成型，你可莫要逃了。"},
			{szTarget="唐无寻",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·唐家堡·机甲对决",nTime=10,key="门派事件2"}},szContent="呵呵，大言不惭。胜负成败，就看此一战。上吧！"},
			{szTarget="唐无乐",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·机甲对决·结束",nTime=5,key="门派事件2"}},szContent="竟是输你一成……没想到大哥你的机甲制造术又精进不少。"},
			{szTarget="唐无寻",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·唐家堡·对抗狼牙",nTime=10,key="门派事件1"}},szContent="哼！诸位侠士请助我们护住机甲。"},
			{szTarget="唐无乐",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·对抗狼牙·御敌·结束",nTime=5,key="门派事件1"}},szContent="好！多亏诸位侠士相助，机甲已经休整完毕，狼牙的末日到了！"},
			{szTarget="跋野古寒",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·唐家堡·对抗狼牙·斩首",nTime=10,key="门派事件2"}},szContent="看看是谁在说大话！"},
			{szTarget="唐无寻",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="机甲自爆·远离",nTime=10,key="门派事件2·提示"}},szContent="诸位侠士当心！机甲将会在十秒后自爆，唐门所属！准备撤！"},
			{szTarget="跋野古寒",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·对抗狼牙斩首·结束",nTime=5,key="门派事件2"}},szContent="啊，我不甘心啊。"},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nFrame=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·龟影锋·小师父;15,奇遇不封印·约15分钟完成",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·唐素娘·前往·饮露峡",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·唐幺曲·沿水流方向走",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="对话·唐幺曲·等待剧情结束",nTime=600,nClass=14}},szNote="触发·宠物奇遇·龟影锋·小师父",szContent="唐素娘似乎遇到了难事，不妨询问一二。"},
			{szContent="陆龟依旧埋于龟壳内，直至狐狸松懈回身，陆龟骤然探头，迅疾闪避。",tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·唐幺曲·交互·草丛",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="交互·石头·对话·唐幺曲",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="前往·三岔路口·触发剧情",nTime=600,nClass=14}}},
			{szContent="身旁的唐门侍女，站姿沉稳，不疾不徐地开口替你们解围。",tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·唐门侍女·对话·唐幺曲",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="返回·唐家集·对话·唐素娘",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="完成·宠物奇遇·龟影锋小师父",nTime=600,nClass=14}}},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="返回·唐家集·对话·唐素娘",nTime=60,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="完成·奇遇·龟影锋·小师父",nTime=60,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=-1,nClass=14}},szNote="完成·宠物奇遇·龟影锋·小师父",szContent="送唐幺曲回唐家集食摊。"},
			{szTarget="唐御御",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·烟花戏·风·鸿鸿;15,奇遇不封印·约5分钟完成",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·唐御御·前往·紫树下",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="拾取·竹叶青·返回·唐御御",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·嘉陵江水井·交互土堆",nTime=600,key="奇遇提示3"}},szContent="女侠，今夜月色正好，你我相逢也是有缘，何不把酒一叙？"},
			{szContent="一只小狗跑了过来，试图阻止你继续翻找。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="交互·小狗·返回·唐御御",nTime=120,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·唐御御·释放·烟花",nTime=120,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="完成·烟花戏·获得·鸿鸿",nTime=120,key="奇遇提示3"}}},
		},
		[193] = {
			{szTarget="燕安",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·养兵千日·结束",nTime=5,key="门派事件1"}},szContent="今日收获了如此之多的寒冰雪莲，众将士辛苦了！不过大敌当前，仍需加紧训练！"},
			{szTarget="燕安",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·养兵千日·开启",nTime=10,key="门派事件1"}},szContent="探子来报，奚人近日恐是要进攻了，大家务必抓紧训练！通过苍云堡内的训练可获寒冰雪莲，上缴者有赏！"},
			{szTarget="萨楚日",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·地图标记·萨楚日",nTime=10,key="门派事件1"}},szContent="我萨楚日率兵前来攻城！苍云小儿若是快快打开城门就放你们一条生路！哈哈哈哈！"},
			{szTarget="申屠远",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·萨楚日·结束",nTime=5,key="门派事件1"}},szContent="今日东陉关得守，不仅是众苍云将士之功，更要多谢各位武林豪杰相助！"},
			{szTarget="塔拉",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·地图标记·塔拉",nTime=10,key="门派事件1"}},szContent="想不到你们在如此情况下还能坚持这么久，看来是我们小瞧了你们！"},
			{szTarget="申屠远",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·塔拉·结束",nTime=5,key="门派事件1"}},szContent="多谢各路英豪前来相助，苍云的众将士也打起精神来，务必要守住这东陉关！"},
			{szTarget="唐和斯",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·地图标记·唐和斯",nTime=20,key="门派事件1"}},szContent="萨楚日和塔拉那两个废物真是给奚人丢脸，哼，受死吧！"},
			{szTarget="库莫",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·锡喇·锡尔哈·结束",nTime=5,key="门派事件1"}},szContent="真是废物，连这种小事都做不好！哼！"},
			{szTarget="长孙忘情",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·地图标记·库莫",nTime=10,key="门派事件1"}},szContent="废话还真是多！众将士听令！"},
			{szTarget="长孙忘情",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·库莫·结束",nTime=5,key="门派事件1"}},szContent="哼！就凭你们便妄图灭我苍云军？真是自不量力！全军听令！今日便让这狂妄之徒有来无回！"},
			{szTarget="长孙忘情",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·锡喇·锡尔哈·结束",nTime=5,key="门派事件1"}},szContent="胆敢前来犯我苍云军者，诛！"},
			{tCountdown={{nIcon=13,key="奇遇提示0",nRefresh=5,szName="左边·第一排·第二个",nTime=10,nClass=14}},szNote="故园风雨",szContent="再靠近秋叶华的墓碑一点。"},
			{tCountdown={{nIcon=13,key="奇遇提示0",nRefresh=5,szName="左边·第一排·第二个",nTime=10,nClass=14}},szNote="故园风雨",szContent="请在秋叶华附近使用。"},
			{szContent="你埋下了一个香囊。",tCountdown={{nIcon=13,key="奇遇提示0",szName="奇遇提示0",nTime=0,nClass=14}},[14]={bCenterAlarm=true},szNote="返回·沈园地牢·对话·受伤的女子"},
			{szTarget="白芷沅",tCountdown={{nClass=14,nIcon=12373,nFrame=0,bHold=true,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·戎马边·贵贵;15,奇遇封印3日;30,对话白芷沅·获得未完成的地图;180,前往以下地图·使用未完成的地图;600,前往太原·怀德门·栾志辉",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·白芷沅·20分钟内完成",nTime=1200,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="神行·龙门荒漠·玉门关",nTime=1200,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="神行·阴山大草原·沼泽驿站",nTime=1200,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="神行·黑戈壁·黑水城",nTime=1200,key="奇遇提示4"}},szContent="不错不错，你很有画地图的天赋。"},
		},
		[194] = {
			{tCountdown={{szName="23.55.07",nIcon=340,nTime=10,nClass=-1}},szContent="你获得了事件【抢夺木材】的奖励"},
			{tCountdown={{szName="23.54.11",nIcon=340,nTime=10,nClass=-1}},szContent="你获得了事件【进击·高秀岩营寨！】的奖励"},
			{szContent="你获得了事件【守卫伐木场】的奖励"},
			{tCountdown={{nFrame=4,nClass=14,nIcon=13,szName="德霄财·刷新剩余",nTime=600,key="公共事件2"}},szContent="你获得了事件【进击·蔡希德营寨！】的奖励"},
			{tCountdown={{nFrame=4,nClass=14,nIcon=13,szName="尤肖杰·刷新剩余",nTime=600,key="公共事件3"}},szContent="你获得了事件【进击·牛延阶营寨！】的奖励"},
			{szContent="你获得了事件【村民的暴动】的奖励"},
			{tCountdown={{szName="23.55.18",nIcon=340,nTime=10,nClass=-1}},szContent="你获得了事件【拦截天门关狼牙援军】的奖励"},
			{tCountdown={{szName="23.57.30",nIcon=340,nTime=10,nClass=-1}},szContent="你获得了事件【援助伐木场】的奖励"},
			{szContent="你获得了事件【重建杏花村】的奖励"},
			{tCountdown={{nFrame=4,nIcon=13,nClass=14,nRefresh=0,nTime="22,石萧翼·刷新剩余;37,石萧翼·延迟刷新",key="公共事件1"}},szContent="你获得了事件【守卫晋祠】的奖励"},
			{tCountdown={{nFrame=4,nClass=14,nIcon=13,szName="李怀仙|正直·刷新剩余",nTime=202,key="公共事件1"}},szContent="你获得了事件【进击·史朝义营寨！】的奖励"},
			{szContent="你获得了事件【援助晋祠】的奖励"},
			{szTarget="落难侠客",tCountdown={{nFrame=6,nIcon=726,key="落难侠客",szName="落难侠客·奖励包裹·出现",nTime=20,nClass=14}},szNote="落难侠客·奖励包裹",szContent="多谢各位仗义相助，在下的伤已经好的差不多了！"},
			{szTarget="王岳明",tCountdown={{nIcon=13,key="公共事件1",szName="李怀仙|正直·刷新",nTime=10,nClass=14}},szContent="狼牙军又来骚扰晋祠了，请侠士们帮助我们消灭他们！"},
			{szTarget="王苍浪",szContent="快点快点，早点儿走到高大帅的营寨还能赶上开伙吃饭！"},
			{szTarget="温茹",szContent="不好了！狼牙军又想占领杏花村了！快来人帮帮我们呀！"},
			{[14]={bCenterAlarm=true},szContent="至于我，就随你们处置好了。",szTarget="秋画扇",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=13,szName="苍云·明教·放过分支·4千侠行点",nTime=60,nClass=14}},szNote="苍云·明教·放过分支·4千侠行点"},
			{tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·雁难归·穗悠悠;15,奇遇不封印·约10分钟完成",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·流民老奶奶·向北城门",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·路平安·上城墙·东面",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·老雁·旧木笛·兵牌",nTime=600,key="奇遇提示3"}},szNote="恭喜触发·宠物奇遇·雁难归·穗悠悠",szContent="流民老奶奶似有话想对你说。"},
			{szContent="兵牌和木笛的组合还挺奇怪，不若跟路平安再讨论一番。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·路平安·对话·奚知明",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="等待·剧情·对话·老雁两次",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="背对·城墙·大树下拾取木料",nTime=600,key="奇遇提示3"}}},
			{szContent="老丈似有意动，再跟他聊聊。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="背对·城墙·大树下拾取木料",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·奚知明·对话·老雁",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="剧情·QTE·对话·老雁",nTime=600,key="奇遇提示3"}}},
			{szTarget="路平安",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·老雁·完成·奇遇",nTime=30,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="宠物奇遇·雁难归·穗悠悠",nTime=30,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=-1,key="奇遇提示3"}},szContent="过奖过奖。"},
			{szContent="半个时辰过去了，边澈还没有回来，还是去牛廷阶营寨看一下吧。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="交互·被抢夺的矿石箱",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·史思明营寨西北帐篷",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·边澈·返回·矿场",nTime=600,key="奇遇提示3"}}},
			{szContent="你没有看到边澈，只看到一串血迹往史思明营寨方向。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="交互·被抢夺的矿石箱",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·史思明营寨西北帐篷",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·边澈·返回·矿场",nTime=600,key="奇遇提示3"}}},
			{szContent="边澈往西边汾河方向去了，快跟上吧。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="前往·汾河·汾字上方岸边",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="准备·甘草x2·对话·边澈",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,bHold=true,szName="返回·霸刀山庄武器店掌柜",nTime=600,key="奇遇提示3"}}},
			{szContent="话音刚落，边澈就施展轻功消失在了你的面前。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="返回·霸刀山庄武器店掌柜",nTime=180,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="对话·边澈·对话·掌柜的",nTime=180,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,bHold=true,szName="对话·边澈·完成·太行道",nTime=180,key="奇遇提示3"}}},
		},
		[322] = {
			{szContent="毒圈即将出现",tCountdown={{nRefresh=0,nClass=14,nFrame=8,nIcon=10478,szName="毒圈·刷新剩余",nTime="120,毒圈·刷新剩余;240,毒圈·刷新剩余;360,毒圈·刷新剩余",key="毒圈"}},szNote="毒圈·即将出现",[14]={bCenterAlarm=true}},
