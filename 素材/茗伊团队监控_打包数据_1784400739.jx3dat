			{szTarget="重楼子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·星暗长林·重楼子",nTime=10,key="门派事件3"}},szContent="说甚么胡话！唐家妹子，你且先去！速速将此处情形告知蛇仙！咱尚能抵得一时！"},
			{szTarget="重楼子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·星暗长林·结束",nTime=5,key="门派事件2"}},szContent="咳咳……"},
