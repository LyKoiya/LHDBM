			{[14]={bCenterAlarm=true},tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·宠物奇遇·追光记;15,奇遇不封印·约5分钟完成;30,奖励·跟宠·光佑",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·米迦尔·前往·西岭驿",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·米护·前往·西边棚子",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·博鲁·返回·神行点北",nTime=600,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="采集·红景天·对话·博鲁",nTime=600,key="奇遇提示4"},{nIcon=12373,nClass=14,nFrame=7,szName="返回·米护·对话·库尔克",nTime=600,key="奇遇提示5"}},szNote="触发·宠物奇遇·追光记·光佑",szContent="米迦尔面带愁色，似乎遇到了麻烦事，不妨问问他。"},
