		[415] = {
			{[14]={bCenterAlarm=true},szContent="(.-)已达到(%d-)分！任意玩家达到(%d-)分将赢得胜利！",bReg=true,tCountdown={{nIcon=13,nClass=14,nFrame=0,szName="[{$1}]·{$2}/{$3}",nTime=30,key="战斗开始"}},szNote="【{$1}】·{$2}/{$3}"},
			{[14]={bCenterAlarm=true},szContent="^与第一名分差超过(%d-)，额外获得(%d-)分。",szTarget="%",tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="额外获得{$2}分",nTime=10,key="额外积分"}},szNote="额外获得{$2}分",bReg=true},
			{[14]={bCenterAlarm=true},szContent="^击伤积分前三名选手，额外获得(%d-)分。",bReg=true,tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="额外获得{$1}分",nTime=10,key="额外积分"}},szNote="额外获得{$1}分",szTarget="%"},
			{[14]={bScreenHead=true,szVoice="YiDong_T"},szContent="锁定狩猎目标——{$me}",col={255,50,255},szTarget="巡狩雷",szNote="巡狩雷·{$me}"},
			{[14]={bScreenHead=true},szContent="即将引爆——",col={255,0,85},szTarget="巡狩雷",szNote="即将引爆"},
			{szTarget="方缘音",szContent="有一批补给送达了！",[14]={bCenterAlarm=true},szNote="补给送达"},
			{szTarget="方缘音",szContent="这泼猴又来捣乱，侠士们当心！",[14]={bCenterAlarm=true},szNote="海岛野猴·捣乱"},
			{szTarget="方缘音",szContent="不好，砰砰兔暴走了！",[14]={bCenterAlarm=true},szNote="砰砰兔·暴走"},
			{szContent="海岛野猴丢出了香蕉皮。",[14]={bCenterAlarm=true},szNote="海岛野猴·香蕉皮"},
			{szContent="海岛野猴丢出了火药桶。",[14]={bCenterAlarm=true},szNote="海岛野猴·火药桶"},
			{szTarget="砰砰兔",szContent="流星火雨！",[14]={bCenterAlarm=true},szNote="砰砰兔·流星火雨！"},
			{szTarget="砰砰兔",szContent="烈焰风车！",[14]={bCenterAlarm=true},szNote="砰砰兔·烈焰风车！"},
			{szTarget="砰砰兔",szContent="窜天猴！",[14]={bCenterAlarm=true},szNote="砰砰兔·窜天猴！"},
		},
		[35] = {
			{szTarget="源明雅",tCountdown={{nIcon=4975,key="寻龙勘脉窥天机·开启",szName="寻龙勘脉·水灵珠·破裂",nTime=10,nClass=14}},szContent="不好，水灵珠破裂了。我的幻身很快就会消失，快去下一个地点吧。"},
			{szTarget="源明雅",tCountdown={{nIcon=4975,key="寻龙勘脉窥天机·开启",szName="寻龙勘脉·任务完成",nTime=10,nClass=14}},szContent="今天就到此为止吧，有劳了。"},
			{szTarget="源明雅",tCountdown={{nIcon=4975,key="寻龙勘脉窥天机·开启",szName="寻龙勘脉·成功+1",nTime=5,nClass=14}},szContent="竟然能打败守护灵，你的身手不错。现在去下一个地点吧。"},
			{szTarget="源明雅",tCountdown={{nRefresh=0,nIcon=4975,key="寻龙勘脉窥天机·开启",szName="寻龙勘脉·地脉守护灵",nTime="6.6,食业朱猿·激活剩余;54,寻龙勘脉·结束剩余",nClass=14}},szContent="不好，附近龙脉的守护灵被惊动了。"},
			{szTarget="源明雅",tCountdown={{nRefresh=0,nIcon=4975,key="寻龙勘脉窥天机·开启",szName="寻龙勘脉·开启",nTime="10,寻龙勘脉·开启;63,食业朱猿·刷新剩余;69.6,食业朱猿·激活剩余;117,寻龙勘脉·结束剩余",nClass=14}},szContent="我现在要使用这个水灵珠激活附近的地脉。"},
			{szTarget="宇文画",tCountdown={{nIcon=4891,key="宇文画·刷新",szName="宇文画·已刷新",nTime=10,nClass=14}},szContent="那个东瀛的小子你给我出来，带着人在我十二连环坞的地头上装神弄鬼，搞什么呢，弟兄们，砸了他们的场子！"},
			{szTarget="宇文画",tCountdown={{nIcon=4891,key="宇文画·刷新",szName="宇文画·已击退",nTime=5,nClass=14}},szContent="哼，东瀛的小子，算你们狠，弟兄们，我们撤！"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=6629,szName="蹲宠提示0",nTime="10,蹲宠·蟹仕·已捕获;20,蟹仕·CD·3-4小时",key="蹲宠提示0"}},szNote="蹲宠·蟹仕·已被捕获",szContent="不知道是谁丢失的《象棋谱·国士无双局上部》，已被好心侠士带走。"},
		},
		[163] = {
			{szTarget="王三金",tCountdown={{nIcon=1240,key="秘境剧情",szName="秘境剧情",nTime=0,nClass=14},{szName="小钟",nIcon=244,nTime=15,nClass=14},{szName="竹子",nIcon=244,nTime=15,nClass=14},{szName="十三根",nIcon=244,nTime=15,nClass=14}},szContent="各位大侠，请跟紧我！"},
