			{szTarget="唐花",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·机关重重·唐花",nTime=10,key="门派事件2"}},szContent="可惜尔等管了这不该管的闲事，我便留不得你们了！"},
