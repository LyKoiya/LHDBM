	CHAT = {
		[2] = {
			{tCountdown={{nFrame=0,nClass=20,nIcon=13,szName="万花·门派事件·星落湖",nTime=10,key="门派事件1"}},szContent="中原战乱数年未休，东方谷主感于天下不宁，百姓罹难，病症者缺医少药，朝不保夕。决定在今日开放万花谷，让百姓入谷就医。以一谷之清静，换万千百姓之安宁。万花药王孙思邈在此宣布：万花门派事件“开谷济苍生”正式开始，各位侠士可前来青岩万花施以援手！\
"},
			{tCountdown={{nFrame=0,nClass=20,nIcon=13,szName="万花·门派事件·星落湖",nTime=10,key="门派事件1"}},szContent="万花昨日开谷，毒人来犯，晴昼海意外被毁，狼牙贼心不死再度来袭，万花开谷能否顺利进行？花圣宇晴发起委托，各侠士可前往万花与万花弟子一起修复花海，抵御狼牙。\
"},
