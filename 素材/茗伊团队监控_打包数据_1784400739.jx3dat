		[673] = {
			{tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·匿沙影·阿泥;15,奇遇不封印·约5分钟完成",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·阿什利·等待·捉迷藏",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·阿什利·对话·阿泥",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="跟随·阿泥·阿泥的痕迹",nTime=600,key="奇遇提示3"}},szContent="阿什利戳了戳你。"},
