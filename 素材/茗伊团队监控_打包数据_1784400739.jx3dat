		[138] = {
			{[14]={bCenterAlarm=true},szContent="是浩气盟的特使，门主已待各位多时，请随我前来。",szTarget="唐某",tCountdown={{nIcon=13,key="剧情提示1",szName="交互·唐某·开剧情",nTime=10,nClass=14}},szNote="唐某·开剧情"},
