			{szTarget="狼牙先锋首领",szContent="你爷爷我年轻些时候，也是翻云覆雨的江湖响当当一号人物！",szNote="狼牙先锋首领·刷新喊话2",tCountdown={{nFrame=1,nClass=14,nRefresh=120,nIcon=3556,szName="狼牙先锋首领·已经刷新",nTime=10,key="狼牙先锋首领"},{nIcon=13,nClass=14,nRefresh=7200,szName="诛恶事件",nTime=-1,key="诛恶事件"},{nIcon=13,nClass=14,nRefresh=7200,szName="通用事件",nTime=-1,key="通用事件"},{nIcon=13,nClass=14,nRefresh=7200,szName="金水镇",nTime=-1,key="金水镇"},{nIcon=13,nClass=14,nRefresh=7200,szName="巴陵县",nTime=-1,key="巴陵县"},{nIcon=13,nClass=14,nRefresh=7200,szName="龙门荒漠",nTime=-1,key="龙门荒漠"},{nIcon=13,nClass=14,nRefresh=7200,szName="南屏山",nTime=-1,key="南屏山"},{nIcon=13,nClass=14,nRefresh=7200,szName="昆仑",nTime=-1,key="昆仑"},{nIcon=13,nClass=14,nRefresh=7200,szName="白龙口",nTime=-1,key="白龙口"},{nIcon=13,nClass=14,nRefresh=7200,szName="无量山",nTime=-1,key="无量山"},{nIcon=13,nClass=14,nRefresh=7200,szName="黑龙沼",nTime=-1,key="黑龙沼"},{nIcon=13,nClass=14,nRefresh=7200,szName="阴山大草原",nTime=-1,key="阴山大草原"},{nIcon=13,nClass=14,nRefresh=7200,szName="黑戈壁",nTime=-1,key="黑戈壁"},{nIcon=13,nClass=14,nRefresh=7200,szName="鲲鹏岛",nTime=-1,key="鲲鹏岛"}}},
			{szTarget="狼牙先锋首领",szContent="我竟然败给你们这群小辈！",szNote="防冲突禁用·击退·狼牙先锋首领",tCountdown={{nFrame=1,nClass=-1,nRefresh=2,nIcon=3556,szName="狼牙先锋首领·拾取掉落",nTime="10,狼牙先锋首领·已击退;300,狼牙先锋首领·拾取剩余;600,狼牙先锋首领·刷新剩余;620,狼牙先锋首领·即将刷新;627,狼牙先锋首领·延迟刷新",key="狼牙先锋首领"},{nIcon=13,nClass=14,nRefresh=7200,szName="诛恶事件",nTime=-1,key="诛恶事件"},{nIcon=13,nClass=14,nRefresh=7200,szName="通用事件",nTime=-1,key="通用事件"},{nIcon=13,nClass=14,nRefresh=7200,szName="金水镇",nTime=-1,key="金水镇"},{nIcon=13,nClass=14,nRefresh=7200,szName="巴陵县",nTime=-1,key="巴陵县"},{nIcon=13,nClass=14,nRefresh=7200,szName="龙门荒漠",nTime=-1,key="龙门荒漠"},{nIcon=13,nClass=14,nRefresh=7200,szName="南屏山",nTime=-1,key="南屏山"},{nIcon=13,nClass=14,nRefresh=7200,szName="昆仑",nTime=-1,key="昆仑"},{nIcon=13,nClass=14,nRefresh=7200,szName="白龙口",nTime=-1,key="白龙口"},{nIcon=13,nClass=14,nRefresh=7200,szName="无量山",nTime=-1,key="无量山"},{nIcon=13,nClass=14,nRefresh=7200,szName="黑龙沼",nTime=-1,key="黑龙沼"},{nIcon=13,nClass=14,nRefresh=7200,szName="阴山大草原",nTime=-1,key="阴山大草原"},{nIcon=13,nClass=14,nRefresh=7200,szName="黑戈壁",nTime=-1,key="黑戈壁"},{nIcon=13,nClass=14,nRefresh=7200,szName="鲲鹏岛",nTime=-1,key="鲲鹏岛"}}},
