			{szTarget="霸图",szContent="恶人谷老友们可在我这里传送到恶人谷！",col={255,100,100},tCountdown={{nFrame=7,nClass=-1,nRefresh=600,nIcon=2864,szName="霸图·已刷新",nTime=2,key="霸图"}}},
