			{[14]={bCenterAlarm=true},szContent="^门客(.-)身负重伤，不能再战，先行撤退",bReg=true,tCountdown={{nRefresh=1,nClass=14,nIcon=13,nFrame=1,szName="门客·{$1}·重伤",nTime=2,key="门客·{$1}"}},szNote="门客·{$1}·重伤"},
			{[14]={bCenterAlarm=true},szContent="^门客(.-)提升到了第(.-)。",bReg=true,szNote="门客·{$1}·{$2}",szTarget="%"},
			{[14]={bCenterAlarm=true},szContent="在下先行撤退！",szTarget="%",tCountdown={{nRefresh=1,nClass=14,nFrame=1,nIcon=13,szName="门客·{$sender}·撤退",nTime=2,key="门客·{$sender}"}},szNote="门客·{$sender}·撤退"},
			{szTarget="柴钗",tCountdown={{nRefresh=0,nClass=14,nIcon=13,nFrame=7,szName="柴钗",nTime="751,柴钗·采货剩余;760,柴钗·即将归来;856,柴钗·休息剩余;865,柴钗·休息结束",key="柴钗采货"}},szContent="小红，我要出门啦！外面太冷了你就乖乖在这里等我回来哦！"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="盐雁·特产总管·缺货",nTime=10,key="特产提示"}},szContent="土特产，土特殊，你们这特产是真的很土……已经卖光？那我岂不是失去了土的机会？"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nIcon=13,nFrame=4,szName="盐雁·特产总管·缺货",nTime=10,key="特产提示"}},szContent="家里还嘱咐我买点特产回去，结果竟然没有了？"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nIcon=13,nFrame=4,szName="苦酷·药材总管·缺货",nTime=10,key="药材提示"}},szContent="竟然连药包都没有？这儿是不是快要倒闭了啊……"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="苦酷·药材总管·缺货",nTime=10,key="药材提示"}},szContent="卖光了？！你们真的很不会做生意诶，我这样的人来买药包，是难得的好吗？！"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="苦酷·药材总管·缺货",nTime=10,key="药材提示"}},szContent="哎……没有药包就算了吧，想花银子都花不出去。"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="苦酷·药材总管·缺货",nTime=10,key="药材提示"}},szContent="汤药都没有你们还想不想做生意了？！"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="酸狻·衣饰总管·缺货",nTime=10,key="衣饰提示"}},szContent="你们这毫无设计感的衣服都能卖光？世间之大，无奇不有，绝了。"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nIcon=13,nFrame=4,szName="茶姹·茶水总管·缺货",nTime=10,key="茶水提示"}},szContent="连水都没有？！啊，我缺水了，有没有人给我浇浇水啊……"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="茶姹·茶水总管·缺货",nTime=10,key="茶水提示"}},szContent="没水喝吗？要渴死了！"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="醋簇·酒水总管·缺货",nTime=10,key="酒水提示"}},szContent="来两斤不掺水的好酒？啥？酒卖光了？行吧，你开心就好，再见吧。"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nIcon=13,nFrame=4,szName="醋簇·酒水总管·缺货",nTime=10,key="酒水提示"}},szContent="酒都没有，真无趣。"},
			{szTarget="游客",tCountdown={{nRefresh=900,nClass=14,nFrame=4,nIcon=13,szName="辛杏·厨房小吃·缺货",nTime=10,key="厨房提示"}},szContent="没吃的了吗？好饿啊。"},
		},
		[579] = {
			{tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·乱红鸾;15,奇遇不封印·全程5-10分钟;60,1.等待2次QTE",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="1.两次QTE",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="2.传送·婚宴·QTE",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="3.交互·小牛·前往·摸宠点附近",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="4.摸宠点后方·盆盆船附近·光圈",nTime=60,nClass=14}},szContent="你突然感觉后颈一痛"},
			{tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="奇遇提示1",nTime=0,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14}},szContent="不如先运气吐纳，试试能否冲破经络限制。"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="等待下一次QTE",nTime=10,nClass=14}},szContent="恭喜侠士，成功冲破经络限制！"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="等待·剧情·约3分钟",nTime=10,nClass=14}},szContent="恭喜侠士，成功冲破内府限制！"},
			{tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="15,互动·小牛;30,等待进度·归去来;60,前往摸宠点附近·盆盆船;90,盆盆船附近·交互·光圈;120,等待剧情·结束",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="互动·小牛",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="等待进度·归去来·前往摸宠点",nTime=60,nClass=14}},szContent="你冲破了无名毒药的束缚！趁此机会快去右边带着小牛前往白水村乘盆盆船逃跑吧！"},
			{szTarget="孙千琳",szContent="嘁，燕燕，走了。",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="宠物奇遇·乱红鸾·结束",nTime=10,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14}}},
			{szTarget="老书生",szContent="咳咳……咳……你们！",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·寓天涯·莓莓;15,奇遇不封印·约10分钟完成;30,1.对话·附近·老书生;90,2.前往·流木村·阿玉;150,3.前往·白水村·对话·老书生;210,4.礼礼附近黄圈·寻找海螺壳;240,5.返回白水村·交互莓莓;300,6.进入老书生家里等待剧情;330,7.杂货商卢芦取药返回老书生;360,8.附近靠近阿玉等待剧情;420,9.返回老书生家里等待剧情;440,完成奇遇·寓天涯·莓莓",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·老书生·流木村·阿玉",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·白水村·对话·老书生",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="寻找·海螺壳·礼礼附近黄圈",nTime=600,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="返回·白水村·交互·莓莓",nTime=600,key="奇遇提示4"}}},
			{szTarget="阿香",szContent="王老先生，我方才在船上干活，没看好阿玉。没承想这孩子居然又闯下祸事，是我疏忽了，平日没将他教好。在这儿给您赔罪了。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="60,6.进入老书生家里等待剧情;90,7.杂货商卢芦取药返回老书生;120,8.附近靠近阿玉等待剧情;180,9.返回老书生家里等待剧情;200,完成奇遇·寓天涯·莓莓",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="进入·老书生家里·等待剧情",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="附近·卢芦·取药·老书生",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="附近·阿玉·返回·老书生",nTime=600,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,szName="等待·剧情·完成·寓天涯",nTime=600,key="奇遇提示4"}}},
			{szTarget="阿玉",szContent="只会告状，有本事你便和我打一架！",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,7.杂货商卢芦取药返回老书生;90,8.附近靠近阿玉等待剧情;120,9.返回老书生家里等待剧情;140,完成奇遇·寓天涯·莓莓",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="附近·卢芦·取药·老书生",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="附近·阿玉·返回·老书生",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="等待·剧情·完成·寓天涯",nTime=600,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示4",nTime=0,key="奇遇提示4"}}},
			{szTarget="黄崎帮帮众",szContent="消消气儿消消气儿，您可千万别发火，（扯上同伴）咱们这就走，这就走。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="90,9.返回老书生家里等待剧情;110,完成奇遇·寓天涯·莓莓",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·老书生·等待·剧情",nTime=120,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{szTarget="老书生",szContent="有意气才可行江湖，待变成我这般枯槁老头子便来不及了……我时日不多，莓莓便托付给你照顾了。你云游四方，便带着它一同见识天涯海角盛景吧，它见了，便等同于我也见了……",tCountdown={{nIcon=12373,nClass=14,nFrame=0,szName="奇遇提示0",nTime=0,key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="完成奇遇·寓天涯·莓莓",nTime=20,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
