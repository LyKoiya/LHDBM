		[213] = {
			{szTarget="韩非池",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·音律之试·琴·开启",nTime=10,key="门派事件1"}},szContent="开始罢。"},
			{szTarget="杨青月",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·音律之试·结束",nTime=5,key="门派事件1"}},szContent="壁垒的坚固程度往往与抚琴者的内力相合。众位侠士花了这许时间才破除壁垒，可见贤弟的弦歌比几月前又精进了。"},
			{szTarget="赵宫商",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·音律之试·幻影·开启",nTime=10,key="门派事件2"}},szContent="好，这就开始。随我来!"},
			{szTarget="韩非池",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·音律之试·结束",nTime=5,key="门派事件2"}},szContent="幻像已破，火候有欠。"},
			{szTarget="杨青月",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·音律之试·幻影·开启",nTime=10,key="门派事件3"}},szContent="宫商的《清弦引梦》现进入第二阶段，我们继续跟着。"},
			{szTarget="杨青月",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·音律之试·结束",nTime=5,key="门派事件3"}},szContent="嗯，待他从梦境中醒来细聊。"},
			{[14]={bCenterAlarm=true},szContent="我知道我知道，先生说的是(.-)！",szTarget="睿儿",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="拾取·{$1}",nTime=30,key="系统事件"}},szNote="拾取·{$1}",bReg=true},
			{szTarget="阿秋",tCountdown={{nRefresh=0,key="奇遇提示0",nFrame=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·儿女事·小乌龟·星辰;15,奇遇不封印·约10分钟完成;45,1.对话阿秋·对话邓斌;90,2.前往怀仁斋·对话杜甫王维;120,3.前往碑铭·琴声十六法卷三·张九龄;150,4.前往翠湄居·对话崖牙;180,5.返回邓斌·获得地图和隐匿机关;210,6.打开背包使用地图;300,前往标记点·小地图有绿点",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·阿秋·对话·邓斌",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="崖牙·张九龄·杜甫·王维",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·邓斌·使用·地图",nTime=600,nClass=14}},szContent="侠士留步，我看看你钓上来的小乌龟。"},
			{tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="前往·标记·小地图·绿点",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="使用·隐匿机关·等待剧情",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="前往·思齐书院·对话高跖",nTime=600,nClass=14}},szContent="隐匿位置已经标记。"},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nFrame=0,nIcon=12373,szName="奇遇提示0",nTime="30,前往思齐书院·对话高跖;40,可提前打开快捷商城准备;60,各购买1个·[浣花笺][朱砂墨];90,可额外获得·六炉金龙丹;120,注意提交材料时选对选项",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="前往·思齐书院·对话·高跖",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="等待·剧情结束·对话·高跖",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="准备·浣花笺·朱砂墨·高跖",nTime=600,nClass=14}},szContent="那人似乎是往思齐书院的方向去了，快快去追"},
			{tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="准备·浣花笺·朱砂墨",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·高跖·前往·御射场",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="对话·石芊芊·返回·高跖",nTime=600,nClass=14}},szContent="他们果然就是行窃的人，且先前去试探一下口风，看能不能知道些来龙去脉"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·高跖·对话·邓斌",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="完成·宠物奇遇·儿女事",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="获得·小乌龟星辰·驯养",nTime=60,nClass=14}},szContent="看来他两人已重归于好，别忘了正事快去问一下吧"},
			{[14]={bCenterAlarm=true,szVoice="ZhuanJieDuan"},szContent="翠湄居出现了金翅雨蝶群，感兴趣的侠士们速去寻找吧！",szTarget="苏水心",tCountdown={{nIcon=10154,nClass=14,nFrame=7,szName="翠湄居·金翅雨蝶群·出现",nTime=30,key="节日活动1"}},szNote="翠湄居·金翅雨蝶群·出现"},
