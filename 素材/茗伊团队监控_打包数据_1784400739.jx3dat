			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·钓者·伪装·送饭之人",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="暗号·选项一·交互·小箱子",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·云宽村·云字北·阿莱",nTime=600,nClass=14}},szContent="你被丢了出来"},
