		[243] = {
			{szTarget="柳辰苇",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·{$N55356}·出现",nTime=20,key="门派事件·{$N55356}"}},szContent="霜林出现了厉害的吊睛白虎，正在狩猎的侠士们可以找到这猛兽一试身手！"},
