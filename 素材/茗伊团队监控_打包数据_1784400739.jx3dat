			{tCountdown={{nRefresh=0,key="奇遇提示0",nIcon=12373,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·露园事·瓜皮;15,奇遇不封印·约15分钟完成",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·林云飞·前往东边木屋",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·林文·等待·剧情结束",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·林文·再对话·康宴别",nTime=600,nClass=14}},szContent="你找到的这把骨杖似乎很合适。"},
			{szTarget="林英",tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·林文·对话·康宴别",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="前往·饮露园·对话康成功",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="等待·康宴别·布置完陷阱",nTime=600,nClass=14}},szContent="家主息怒，这是最后一根杖子了，折了……不太好……"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="返回·康成功·前往东边小路",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·康宴别·观看动画剧情",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·康宴别·服用·灵显丹",nTime=600,nClass=14}},szContent="陷阱遭到破坏，连接机关的绳子被咬断。"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="交互·坑洞·若消失则左右绕",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="观看·动画剧情·返回康宴别",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·瓜田处·使用·麻沸散",nTime=600,nClass=14}},szContent="药粉痕迹在这个坑洞处消失了，试试挖开看看吧。"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="返回·康成功·对话·康宴别",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="返回·云中谷·康宴别·剧情",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·康宴别·交互·丝绒鼠",nTime=600,nClass=14}},szContent="陷阱布置完毕，去饮露园和小别他们会合吧。"},
			{szTarget="丝绒鼠",tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·康宴别·交互·丝绒鼠",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·康宴别·完成·露园事",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="获得·偷瓜大盗·宠物·瓜皮",nTime=600,nClass=14}},szContent="吱——"},
