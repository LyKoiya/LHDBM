		[172] = {
			{szTarget="洞窟白蛇",szContent="嘶！",[14]={bScreenHead=true},col={255,50,50}},
			{szTarget="九隆神丐",szContent="还是记忆里的味道！好吃！好吃！",tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·荆轲刺·黑刺客;15,奇遇不封印·约5分钟完成;30,1.对话九隆神丐·前往朱雀大街;60,2.出门左拐·鼓楼附近;80,3.对话林暮昭·返回长安西市;120,4.慈幼坊对面·布衫老人;160,5.返回朱雀大街·对话林暮昭;180,6.对话谈亮亮·返回长安西市;210,7.靠近胡玉楼对面杂货商严曲;240,8.待奇遇状态为富商暴毙在家中;250,9.对话林暮昭·前往朱雀大街;280,10.对话林暮昭·等待剧情;300,11.再次对话林暮昭·完成奇遇",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·九隆神丐·前往·朱雀大街",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·林暮昭·返回·长安西市",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="对话·布衫老人·对话·林暮昭",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="对话·谈亮亮·返回·长安西市",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示5",nFrame=7,szName="靠近·胡玉楼严曲·对话·林暮昭",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示6",nFrame=7,szName="前往·朱雀大街·对话·林暮昭",nTime=600,nClass=14}}},
			{szTarget="谈亮亮",szContent="少侠，我们又见面了，真是有缘。少年，你看来已经知道那柳百万被杀一事了，我也不瞒你，那就是我做的。",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="等待·剧情结束·对话·林暮昭",nTime=33,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="完成宠物奇遇·荆轲刺·黑刺客",nTime=33,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14},{nFrame=7,key="奇遇提示5",nIcon=12373,szName="奇遇提示5",nTime=0,nClass=14},{nFrame=7,key="奇遇提示6",nIcon=12373,szName="奇遇提示6",nTime=0,nClass=14}}},
			{szTarget="六指乞丐",szContent="哎呀，这不是静静吗？大侠是从哪里得到的？"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,key="蹲宠提示0",nFrame=7,nIcon=6801,szName="蹲宠提示0",nTime="10,蹲宠·静静·已捕获;20,小静静·CD·8-9小时",nClass=14}},szNote="蹲宠·静静·已被捕获",szContent="静静已被好心侠士带走。"},
			{[14]={bScreenHead=true},szContent="{$me}，你的计谋被我识破了！",col={255,50,255},szTarget="狼牙铁勒兵",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手1",nTime=0,key="诱敌深入下暗手1"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手2",nTime=0,key="诱敌深入下暗手2"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手3",nTime=0,key="诱敌深入下暗手3"}},szNote="识破"},
			{[14]={bScreenHead=true},szContent="又是一个谎报军情的叛贼！",col={255,50,255},szTarget="狼牙铁勒兵",tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="诱敌深入下暗手1",nTime=0,key="诱敌深入下暗手1"},{nFrame=5,nClass=14,nIcon=13,szName="诱敌深入下暗手2",nTime=0,key="诱敌深入下暗手2"},{nFrame=5,nClass=14,nIcon=13,szName="诱敌深入下暗手3",nTime=0,key="诱敌深入下暗手3"}},szNote="识破"},
			{tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手1",nTime=0,key="诱敌深入下暗手1"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手2",nTime=0,key="诱敌深入下暗手2"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手3",nTime=0,key="诱敌深入下暗手3"}},szNote="信任",szContent="由于你的恭维,狼牙铁勒兵对你的信任加深了！"},
			{[14]={bScreenHead=true},szContent="怎么不见乞丐？看来只好把你的人头带回去领功了！",col={255,50,50},szTarget="狼牙铁勒兵",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手1",nTime=0,key="诱敌深入下暗手1"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手2",nTime=0,key="诱敌深入下暗手2"},{nIcon=13,nClass=14,nFrame=5,szName="诱敌深入下暗手3",nTime=0,key="诱敌深入下暗手3"}},szNote="攻击"},
			{[14]={bScreenHead=true},szContent="不对！此事必有蹊跷！",col={255,50,255},szTarget="狼牙铁勒兵",tCountdown={{nIcon=278,nClass=14,nFrame=0,szName="狼牙铁勒兵对话·送水果",nTime=20,key="诱敌深入下暗手1"},{nIcon=278,nClass=14,nFrame=0,szName="明日午时·天佑吾皇",nTime=20,key="诱敌深入下暗手2"},{nIcon=278,nClass=14,nFrame=0,szName="丐帮中人·追随宇文将军",nTime=20,key="诱敌深入下暗手3"}},szNote="猜忌"},
			{szTarget="狼牙军官",tCountdown={{nIcon=13,nClass=14,nFrame=3,szName="狼牙军官·赠送兵器222",nTime=10.31,key="死生之数犹未定"}},szContent="这手里的弯刀不怎么好使了，给我弄把锋利的长枪使使。"},
			{szTarget="狼牙军官",tCountdown={{nIcon=13,nClass=14,nFrame=7,szName="狼牙军官·赠送美酒333",nTime=10.31,key="死生之数犹未定"}},szContent="真是口干舌燥，给大爷我弄点酒水来，日后定在将军前替你美言几句。"},
			{szTarget="老和尚",tCountdown={{nIcon=13,nClass=14,nFrame=3,szName="死生之数犹未定·完成",nTime=5,key="死生之数犹未定"}},szContent="多行不义，施主你这是咎由自取啊..."},
			{szTarget="颜老太太",tCountdown={{nFrame=3,nClass=14,nIcon=3320,szName="颜老太太·成功营救",nTime=30,key="系统事件"}},szNote="颜老太太·成功营救",szContent="俺不姓颜，俺姓谢，不是颜老太太！你们都弄错了！"},
			{szTarget="颜老太太",tCountdown={{nIcon=3320,nClass=14,nFrame=3,szName="颜老太太·已解救",nTime=30,key="系统事件"}},szNote="颜老太太·已解救",szContent="俺不姓颜,俺姓谢,不是颜老太太！你们都弄错了！"},
			{[14]={bCenterAlarm=true,bScreenHead=true},szContent="龟年被困多日，最遗憾的是还没有将平生所长整理成籍，造福后人。幸得侠士相救！",col={0,255,0},szTarget="李龟年",szNote="李龟年·已解救"},
			{[14]={bCenterAlarm=true,bScreenHead=true},szContent="救命之恩，日后定当相报，多谢！",col={0,255,0},szTarget="舒尽忠",szNote="舒尽忠·已解救"},
			{szTarget="%",tCountdown={{nFrame=3,nClass=14,nIcon=3320,szName="长安城·搭救颜老太太",nTime=30,key="系统事件"}},szContent="隐元密报：狼牙军即将押送颜氏老妇到内城西市法场斩首示众！颜氏一门满门忠烈，还望各路侠士即刻前往搭救！"},
		},
