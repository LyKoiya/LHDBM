			{szTarget="照萤",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·剑舞凝光·佟雅辰·开启",nTime=10,key="门派事件2"}},szContent="第二场比试开始，绮秀弟子佟雅辰出场。"},
