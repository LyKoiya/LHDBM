		[302] = {
			{szTarget="雪雪",tCountdown={{nIcon=293,key="雪雪·旅行介绍1",szName="可以去周围商铺看看",nTime=20,nClass=14},{nIcon=293,key="雪雪·旅行介绍2",szName="可以去祈梦台大树下许愿",nTime=20,nClass=14}},szContent="这里能看见山下的村庄呢。"},
			{szTarget="雪雪",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="雪雪·剧情阶段3·停云居门口河边",nTime=10,key="雪雪·剧情"}},szContent="啊，雪雪的发簪不见了，可能是玩耍的时候弄丢了，雪雪要回去找找。大姐姐若是要找我的话，我就在停云居门口。"},
			{szTarget="雪雪",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="雪雪·剧情阶段2·停云居门口河边",nTime=10,key="雪雪·剧情"}},szContent="啊，雪雪突然想起来还有件要紧的事情要做。大姐姐若是要找我的话，我就在停云居门口的河边。"},
			{szTarget="雪雪",tCountdown={{nFrame=6,nIcon=7622,nClass=14,nRefresh=9,szName="冬瓜烧肉·根骨·熟练度+1",nTime=10.1,key="做菜提示·冬瓜烧肉"}},szContent="原来冬瓜烧肉是这样做的啊，我好像学到了一点呢。"},
			{szTarget="雪雪",tCountdown={{nFrame=0,nClass=14,nIcon=7622,szName="雪雪·学会·冬瓜烧肉·根骨",nTime=10.1,key="做菜提示·冬瓜烧肉"}},szContent="这冬瓜烧肉我终于学会啦！"},
