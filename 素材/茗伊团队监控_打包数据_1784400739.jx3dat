			{[14]={bCenterAlarm=true},szContent="{$me}.-需要([包扎服用汤剂运气]+).-[。]+",bReg=true,tCountdown={{nRefresh=600,nIcon=13,nFrame=-1,key="包扎",szName=" ",nTime=-1,nClass=14},{nRefresh=600,nIcon=13,nFrame=-1,key="服用汤剂",szName=" ",nTime=-1,nClass=14},{nRefresh=600,nIcon=13,nFrame=-1,key="运气",szName=" ",nTime=-1,nClass=14},{nFrame=-1,nIcon=1465,key="{$1}",szName=" ",nTime=-2,nClass=14},{nRefresh=600,nIcon=106,nFrame=6,key="包扎",szName="医者仁心·包扎绷带",nTime=5,nClass=14},{nRefresh=600,nIcon=4476,nFrame=6,key="服用汤剂",szName="医者仁心·服用汤剂",nTime=5,nClass=14},{nRefresh=600,nIcon=1512,nFrame=6,key="运气",szName="医者仁心·运气通络",nTime=5,nClass=14}},szNote="医者仁心·{$1}",szTarget="裴元"},
			{szTarget="宇晴",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·献花复晴昼·星落湖",nTime=20,key="门派事件1"}},szContent="烦请各位侠士将大家带来的花草移植到花海深处。"},
			{tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=20,szName="看小地图绿点·放置花苗",nTime=30,key="门派事件1"}},szContent="栽种花苗的位置已经标记，可打开中地图随时查看"},
			{szTarget="东方宇轩",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·花海阻狼牙·晴昼海西南",nTime=20,key="门派事件2"}},szContent="万花众弟子小心戒备！不可使其入山！"},
			{szTarget="令狐潮",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=360,szName="门派事件2·晴昼海西南·令狐潮",nTime=20,key="门派事件2"}},szContent="传某将令！死士进击！"},
			{szTarget="万花弟子",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=360,szName="门派事件2·花海阻狼牙·结束",nTime=5,key="门派事件2"}},szContent="谷主将在山门针对此次开谷进行训诫，谷内弟子速速前来。"},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nFrame=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·燕啼松·松居客;15,奇遇不封印·约10分钟完成",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·万松谦·前往·三星望月",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·王代·返回·万松谦",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="背包·使用·谷物·交互·光圈",nTime=600,nClass=14}},szContent="盆中现奇景，幼燕啼微林。"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·万松谦·前往·北面瀑布",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·若璃·返回·万松谦",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="前往·水月宫台阶·对话·逸尘",nTime=600,nClass=14}},szContent="小燕子们吃的很香，快回报万松谦吧"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="返回·仙迹岩·对话·万松谦",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="完成·宠物奇遇·燕啼松",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="获得·宠物·松居客",nTime=60,nClass=14}},szContent="把机关底座带回给万松谦吧"},
			{szTarget="赵小凯",szContent="好画！好画！",tCountdown={{nIcon=12373,key="奇遇提示0",nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发孩童书;15,奇遇不封印·约15分钟完成;30,1.对话赵小凯·三星望月找陈一;180,2.往长安方向寻找·散落的书页;240,3.返回对话陈一·楼外找徐书;150,4.采摘·止血草并使用;270,4.返回对话陈一·楼下找吴岱;360,5.吴岱身后山崖树边触发脚印剧情;420,6.落星湖对话葛晚星·花海东偷书小兽;480,7.返回找葛晚星·返回找陈一;600,8.仙迹岩寻找·颜真卿;720,9.等待剧情后·返回找陈一;780,10.对话颜真卿·返回对话陈一;840,11.下楼对话徐书;900,12.再次对话陈一·结束",nClass=14},{nIcon=12373,key="奇遇提示1",nRefresh=0,nFrame=7,nTime="180,1.对话赵小凯·三星望月找陈一;360,4.返回对话陈一·楼下找吴岱",nClass=14},{nIcon=12373,key="奇遇提示2",nRefresh=0,nFrame=7,nTime="180,2.往长安方向寻找·散落的书页;360,5.吴岱身后山崖树边触发脚印剧情",nClass=14},{nIcon=12373,key="奇遇提示3",nRefresh=0,nFrame=7,nTime="180,3.返回对话陈一·楼外找徐书;360,6.落星湖葛晚星·花海东偷书小兽",nClass=14}}},
			{szTarget="颜真卿",szContent="不仅是你们小师弟，尔等也须谨记。",tCountdown={{nIcon=12373,key="奇遇提示0",nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="60,10.对话颜真卿·返回对话陈一;120,11.下楼对话徐书;180,12.再次对话陈一·结束",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="奇遇提示1",nTime=0,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="10.对话颜真卿·返回对话陈一",nTime=300,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="11.下楼对话徐书",nTime=300,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="12.再次对话陈一·结束",nTime=300,nClass=14}}},
			{[14]={bCenterAlarm=true,szVoice="ZhuanJieDuan"},szContent="花海出现了金翅雨蝶群，感兴趣的侠士们速去寻找吧！",szTarget="苏水心",tCountdown={{nIcon=10154,nClass=14,nFrame=7,szName="花海·金翅雨蝶群·出现",nTime=30,key="节日活动1"}},szNote="花海·金翅雨蝶群·出现"},
		},
		[5] = {
			{szTarget="仲虚念",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·禅斗较量·仲虚念",nTime=20,key="门派事件1"}},szContent="正合我意！"},
			{szTarget="仲虚念",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·禅斗较量·结束",nTime=5,key="门派事件1"}},szContent="你烦不烦啊！"},
			{szTarget="仲虚念",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·武斗较量·仲虚念",nTime=20,key="门派事件2"}},szContent="大言不惭！"},
			{szTarget="慧武",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·武斗较量·结束",nTime=5,key="门派事件2"}},szContent="大师，小心了！"},
			{szTarget="东瀛的自傲",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·荡除心魔·东瀛的自傲",nTime=20,key="门派事件2"}},szContent="好个金刚伏魔阵！可能及我万一！"},
			{szTarget="东瀛的自傲",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·东瀛的自傲·结束",nTime=5,key="门派事件2"}},szContent="不！"},
			{szTarget="武士的尊严",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·荡除心魔·武士的尊严",nTime=20,key="门派事件3"}},szContent="笑话，心境澄明之人世间又有几个！"},
			{szTarget="武士的尊严",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·武士的尊严·结束",nTime=5,key="门派事件3"}},szContent="这怎么可能！"},
			{szTarget="一刀流的荣耀",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件4·荡除心魔·一刀流的荣耀",nTime=20,key="门派事件4"}},szContent="一刀流岂是尔等所能企及！"},
			{szTarget="一刀流的荣耀",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件4·一刀流的荣耀·结束",nTime=5,key="门派事件4"}},szContent="就这么......结束了么......"},
			{szTarget="禅武的执念",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件5·荡除心魔·禅武的执念",nTime=20,key="门派事件5"}},szContent="论禅论武，我都绝对不会输！"},
			{szTarget="禅武的执念",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件5·禅武的执念·结束",nTime=5,key="门派事件5"}},szContent="一念......放下......"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·道知·后方田里·清礼",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="前往·齐华村·采集·青菜*3",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·清礼·屋檐对话·蒋瀚",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="对话·慧毅·田里对话·清礼",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示5",nFrame=7,szName="前往·院外西北·对话·慧博",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示6",nFrame=7,szName="返回·清礼·伙房后用·薪柴",nTime=600,nClass=14}},szContent="少林寺伙房弟子道知似是有话要对你说。"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="返回·慧博·返回·清礼",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="返回·慧博·返回·清礼",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="等待·剧情·获得·饭盒",nTime=600,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14},{nFrame=7,key="奇遇提示5",nIcon=12373,szName="奇遇提示5",nTime=0,nClass=14},{nFrame=7,key="奇遇提示6",nIcon=12373,szName="奇遇提示6",nTime=0,nClass=14}},szContent="你已点燃了木柴，快去请慧博师伯吧。"},
			{szTarget="蒋瀚",szContent="哼，我也接着回屋顶晒太阳。",tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="交互·长老·品尝·斋饭",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="澄通·澄信·澄正·澄理",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·清礼·等待·剧情",nTime=600,nClass=14}}},
			{szTarget="慧博",szContent="清礼这孩子聪明伶俐，只是年纪尚幼缺些磨砺。麻烦了施主这么久，小僧这里道谢了。阿弥陀佛！至于这只小蟹，留在我少林寺伙房也多有不便，它亦是施主相助所救，皆为缘法！不如便交由施主保管吧！阿弥陀佛！",tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="完成奇遇·烹调法·将军客",nTime=20,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14}}},
			{szContent="查小娘似乎有话想对你说。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·查小娘·斜后草垛·貉",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·闰水·返回·查小娘",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·桥边树下·对话·闰水",nTime=600,key="奇遇提示3"}}},
			{szContent="查小娘来了，她和闰水似乎彼此认识，去问问查小娘怎么回事吧。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·查小娘·完成奇遇",nTime=60,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·闰水·后方山坡·水豚",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="前往·齐华村·对话·查小娘",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="返回·闰水·前往·桥边树下",nTime=600,nClass=14}},szContent="闰水似乎有话想对你说。"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·闰水·完成奇遇",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="奇遇提示2",nTime=0,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="奇遇提示3",nTime=0,nClass=14}},szContent="闰水来了，他和查姑娘似乎彼此认识，去问问闰水怎么回事吧。"},
		},
		[6] = {
			{szTarget="陈昊",tCountdown={{nFrame=4,nClass=14,nIcon=22,szName="狮王争霸战·开启",nTime=20,key="狮王争霸战"}},szContent="狮王争霸，能者独尊！陌路英雄八方临，以武会友天下名。十年苦修寒暑意，鱼跃龙门气冲庭！现在，狮王争霸战正式开始！大家准备！"},
			{szTarget="陈昊",tCountdown={{nFrame=4,nIcon=22,nClass=14,szName="狮王争霸战·结束剩余",nTime=30,key="狮王争霸战"}},szContent="本次狮王争霸战还有30秒结束，各位勇士可要加把劲了！"},
			{szTarget="陈昊",tCountdown={{nFrame=4,nClass=14,nIcon=22,szName="狮王争霸战·已经结束",nTime=5,key="狮王争霸战"}},szContent="本次狮王争霸战已结束。各位勇士大可勤加苦练，下次卷土重来。"},
			{szTarget="沈云鸢",tCountdown={{nIcon=12371,key="奇遇提示1",nFrame=7,szName="对话·沈云鸢·前往·杂货区",nTime=120,nClass=14},{nIcon=12371,key="奇遇提示2",nFrame=7,szName="对话·钱万和·前往·技艺区",nTime=120,nClass=14},{nIcon=12371,key="奇遇提示3",nFrame=7,szName="对话·沈云鸢·交互·小鹿摇",nTime=120,nClass=14},{nIcon=12371,key="奇遇提示4",nFrame=7,szName="码头·对话沈云鸢·食肆当家",nTime=120,nClass=14}},szContent="给钱！"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="返回·枫叶泊·1号宅邸·桥头",bHold=true,nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="使用·鸟笼·跟随·小寿带鸟",bHold=true,nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="前往·3号宅邸方向·大树下",bHold=true,nTime=600,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="交互·小寿带鸟·完成奇遇",bHold=true,nTime=600,nClass=14}},szContent="返回枫叶泊放飞这只鸟儿吧。"},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nIcon=12373,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·江湖录·香香;15,奇遇不封印·约3分钟完成",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="交互·几页书稿·对话·苏拂衣",nTime=120,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="前往·再来镇南边·对话·老仆",nTime=120,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="完成·宠物奇遇·江湖录·小羽",nTime=120,nClass=14}},szContent="小羽听到你的哨声飞了回来，还叼回了几页书稿，掉落在地上。"},
			{szContent="这只毛丝鼠身上好像掉落了一支金钗。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·谜书生·小苗苗;15,奇遇不封印·约5分钟完成;40,1.交互带血的金钗·跟随血迹;60,2.前往西南树下·对话谢长安;120,3.前往再来镇药店·交易冯德;180,4.购买上品止血散·返回荀鸢;210,5.前往冯德身后·对话药店掌柜;240,6.前往武器商人·对话谢长安;270,7.前往萧白胭附近·对话荀鸢;300,8.前往扬州码头·对话荀鸢;320,完成奇遇·谜书生·小苗苗",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="交互·带血的金钗·跟随·血迹",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·西南树下·对话·谢长安",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·再来镇药店·交易·冯德",nTime=600,key="奇遇提示3"}}},
			{szContent="这金钗上带着血迹，地上也有……顺着血迹去看看发生了什么吧。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="20,2.前往西南树下·对话谢长安;80,3.前往再来镇药店·交易冯德;140,4.购买上品止血散·返回荀鸢;170,5.前往冯德身后·对话药店掌柜;200,6.前往武器商人·对话谢长安;230,7.前往萧白胭附近·对话荀鸢;260,8.前往扬州码头·对话荀鸢;280,完成奇遇·谜书生·小苗苗",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·西南树下·对话·谢长安",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·再来镇药店·交易·冯德",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="购买·上品止血散·返回·荀鸢",nTime=600,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·冯德身后·对话药店掌柜",nTime=600,key="奇遇提示4"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·武器商人·对话·谢长安",nTime=600,key="奇遇提示5"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·萧白胭附近·对话·荀鸢",nTime=600,key="奇遇提示6"}}},
			{szContent="现在去扬州码头送别荀鸢姑娘吧。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,8.前往扬州码头·对话荀鸢;50,完成奇遇·谜书生·小苗苗",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·扬州码头·对话·荀鸢",nTime=60,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="完成·奇遇·谜书生·小苗苗",nTime=60,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示4",nTime=0,key="奇遇提示4"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示5",nTime=0,key="奇遇提示5"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示6",nTime=0,key="奇遇提示6"}}},
			{szTarget="罗岩成",szContent="不走是吧？！小五、小六，拿家伙什儿来，把它架走！",tCountdown={{nFrame=7,nClass=14,nIcon=12371,szName="对话·罗岩成·对话·大怪鼠",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12371,szName="击败·大怪鼠·对话·罗岩成",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12371,szName="对话·大怪鼠·完成·拜春擂",nTime=600,key="奇遇提示3"}}},
			{szTarget="罗岩成",szContent="那个……鹿鼠兄？你输了，可以下场了。",tCountdown={{nIcon=12371,nClass=14,nFrame=7,szName="对话·罗岩成·对话·大怪鼠",nTime=30,key="奇遇提示1"},{nIcon=12371,nClass=14,nFrame=7,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nIcon=12371,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{szTarget="赤兔",tCountdown={{nIcon=12371,nClass=14,nFrame=6,szName="再次对话·赤兔",bHold=true,nTime=300,key="奇遇提示2"},{nIcon=12371,nClass=14,nFrame=6,szName="对话完成·回到家园·裴草",bHold=true,nTime=300,key="奇遇提示3"}},szNote="白日梦",szContent="小浮云你刚才找我了吗？"},
			{tCountdown={{nIcon=12371,nClass=14,nFrame=7,szName="马商附近·使用·游梦仙枕",bHold=true,nTime=300,key="奇遇提示3"}},szNote="白日梦",szContent="还未到达指定地点！"},
			{szContent="你发现了卿重的玉佩。",tCountdown={{nClass=14,nIcon=12373,nFrame=0,szName="奇遇提示0",nRefresh=0,bHold=true,nTime="30,4.前往·藏剑·虎跑山庄·卿重;60,5.返回·七秀·卢蓉;90,6.返回·藏剑·卿重;100,完成奇遇·烟花戏·秋·瑞瑞",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·藏剑·虎跑山庄·卿重",bHold=true,nTime=300,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·七秀·卢蓉",bHold=true,nTime=300,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·藏剑·卿重",bHold=true,nTime=300,key="奇遇提示3"}}},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nIcon=6989,nFrame=7,szName="蹲宠提示0",nTime="10,蹲宠·蟹马·蓝·已捕获;20,蟹马·蓝·CD·3-4小时",key="蹲宠提示2"}},szNote="蹲宠·蟹马·蓝·已被捕获",szContent="不知道是谁丢失的《象棋谱·凡仙局下部》，已被好心侠士带走。"},
			{szTarget="横小五",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=6111,szName="蹲宠提示0",nTime="10,蹲宠·蟹卒·已捕获;20,蟹卒·CD·1.5-2小时",key="蹲宠提示1"}},szNote="蹲宠·蟹卒·已被捕获",szContent="我要去找螃蟹了，回头再见吧。"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nIcon=6111,nFrame=7,szName="蹲宠提示0",nTime="10,蹲宠·蟹卒·已捕获;20,蟹卒·CD·1.5-2小时",key="蹲宠提示1"}},szNote="蹲宠·蟹卒·已被捕获",szContent="蟹卒已被好心侠士带走照顾。"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=6100,szName="蹲宠提示0",nTime="10,蹲宠·大哈·已捕获;20,大哈·CD·1小时",key="蹲宠提示0"}},szNote="蹲宠·大哈·已被捕获",szContent="大哈已被好心侠士带走。"},
			{szContent="赶紧将听到的消息转述给成步堂吧。",tCountdown={{nFrame=0,key="奇遇·攻略1",nIcon=13,szName="金水镇·成步堂",nTime=20,nClass=14}}},
			{bReg=true,tCountdown={{nIcon=3140,key="{$2}·{$4}",nFrame=4,nRefresh=2,szName="{$3}·{$2}·[{$1}/{$4}]",nTime=30,nClass=14},{nIcon=13,key="{$2}·0",szName="{$2}·0",nTime=-2,nClass=14},{nFrame=2,key="{$2}·{$4}",nIcon=3140,nRefresh=1,szName="{$3}·{$2}·已达上限",nTime=30,nClass=14}},szContent="本次活动获得(%d-)份(.-)，今年(.-)还可通过活动获得(%d-)份(.-)。"},
			{bReg=true,tCountdown={{nFrame=7,nClass=14,nIcon=3314,nRefresh=11,szName="本轮得分·{$1}",nTime=60,key="断线的风筝"}},szContent="本轮得分为(%d-)分"},
		},
		[7] = {
			{szTarget="李忘生",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·西昇大典·结束",nTime=10,key="门派事件1"}},szContent="多谢诸位侠士，我和二位师弟先行回大殿议事。"},
			{szTarget="于睿",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·地图标记·攻击BOSS",nTime=10,key="门派事件1"}},szContent="各位侠士请帮我们灭掉星宿据点！"},
			{szTarget="千秋子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·千秋子·刷新",nTime=10,key="门派事件2"}},szContent="区区星野剑阵，不过浪得虚名，如何能与我星宿派武侯移星术相比？"},
			{szTarget="千秋子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·千秋子·已刷新",nTime=10,key="门派事件2"}},szContent="我修习上古毒经与武侯移星术，今已大成，你们尽管一起上吧！哈哈哈哈！"},
			{szTarget="卓凤鸣",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·地图标记·攻击BOSS",nTime=20,key="门派事件1"}},szContent="此等恶人不除不快，诸位侠士，还请助我纯阳守护剑阵，灭了此人威风！"},
			{szTarget="李忘生",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·星野剑阵·结束",nTime=10,key="门派事件1"}},szContent="多谢各位侠士仗义出手。"},
			{szTarget="李忘生",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=300,szName="门派事件1·星野剑阵·天玑剑",nTime=10,key="门派事件1"}},szContent="各位侠士需以自身精气养之，才可触发天玑剑气。"},
			{szTarget="李忘生",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=300,szName="门派事件1·星野剑阵·玉衡剑",nTime=10,key="门派事件1"}},szContent="有劳各位侠士将吾身后剑匣中剑置于玉衡剑阵眼旁，让玉衡剑吸收其中罡气。"},
			{szTarget="李忘生",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=300,szName="门派事件1·星野剑阵·摇光剑",nTime=10,key="门派事件1"}},szContent="还请诸位侠士相助，取三清符，然后到至高处汲取天地元气，并贴于摇光剑身，以激活摇光剑气。"},
			{szTarget="祁进",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·山门卫道·结束",nTime=5,key="门派事件1"}},szContent="多谢各位侠士！下一批物资将会在稍后运送！"},
			{szTarget="祁进",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·山门卫道·太极广场",nTime=10,key="门派事件1"}},szContent="我纯阳宫运送西昇祭的物资车在往太极广场的路上，麻烦各位侠士前往护送！"},
			{szTarget="祁进",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·山门卫道·老君宫",nTime=10,key="门派事件1"}},szContent="我纯阳宫运送西昇祭的物资车应该在往老君宫的路上，麻烦各位侠士前往护送！"},
			{szTarget="祁进",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·山门卫道·纯阳宫正门",nTime=10,key="门派事件1"}},szContent="我纯阳宫运送西昇祭的物资车应该在往纯阳宫正门的路上，麻烦各位侠士前往护送！"},
			{szTarget="纯阳弟子",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=120,szName="门派事件·山门卫道·拾取物资",nTime=2,key="门派事件1"}},szContent="不好！马车受了惊吓，劳烦各位侠士帮我们拾取掉落在地上的物资！"},
			{szTarget="雪雪",tCountdown={{nIcon=293,nClass=14,nRefresh=15,szName="太极广场东南·亭子·触发命途",nTime=20,key="雪雪·旅行介绍3"}},szContent="我们去旁边那个亭子看看嘛。"},
			{szTarget="雪雪",tCountdown={{nIcon=293,nClass=14,nRefresh=15,szName="太极广场·于睿",nTime=20,key="雪雪·旅行介绍1"},{nIcon=293,nClass=14,nRefresh=15,szName="太极广场东南·亭子·触发命途",nTime=20,key="雪雪·旅行介绍2"}},[14]={bTeamChannel=true},szContent="一起去哪玩？"},
			{tCountdown={{key="奇遇提示0",nFrame=0,nIcon=12373,bHold=true,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·白雪忆·丰丰;15,奇遇不封印·全程5-10分钟;60,1.对话步虚尘·往纯阳宫方向;120,2.对话苏卿若·返回步虚尘;180,3.前往巴陵·巴陵镇·说书人;210,4.油菜花田·季妍华·取灵芝;300,5.往苍山洱海方向山上·颜谷芝;360,6.对话叶颢轩·返回季妍华;420,7.返回纯阳·对话步虚尘·结束",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="1.对话步虚尘·往纯阳宫方向",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="2.对话苏卿若·返回步虚尘",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="3.前往巴陵·巴陵镇·说书人",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,bHold=true,szName="4.油菜花田·季妍华·取灵芝",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示5",nFrame=7,bHold=true,szName="5.往苍山洱海方向山上·颜谷芝",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示6",nFrame=7,bHold=true,szName="6.对话叶颢轩·返回季妍华",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示7",nFrame=7,bHold=true,szName="7.返回纯阳·对话步虚尘·结束",nTime=600,nClass=14}},szContent="纯阳弟子步虚尘好像有话对你说。"},
			{szTarget="步虚尘",szContent="十年离乱后，长大一相逢……"},
			{tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="奇遇提示1",nTime=0,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14},{nFrame=7,key="奇遇提示5",nIcon=12373,szName="奇遇提示5",nTime=0,nClass=14},{nFrame=7,key="奇遇提示6",nIcon=12373,szName="奇遇提示6",nTime=0,nClass=14},{nFrame=7,key="奇遇提示7",nIcon=12373,szName="奇遇提示7",nTime=0,nClass=14}},szContent="宠物已成功添加。"},
		},
		[8] = {
			{szContent="(.-)和(.-)在擂台比武，有兴趣的侠士可前往观看。",bReg=true,tCountdown={{nFrame=-1,nIcon=13,nClass=14,nRefresh=300,szName="比武·{$1}",nTime=-1,key="比武·{$1}"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=300,szName="比武·{$2}",nTime=-1,key="比武·{$2}"},{nFrame=-1,nIcon=1465,nClass=14,szName="比武·{$me}",nTime=0,key="比武·{$me}"},{nFrame=1,nIcon=1276,nClass=14,nRefresh=1,szName="【{$1}】·守擂开启",nTime=5.25,key="比武·{$1}"},{nFrame=1,nIcon=1276,nClass=14,nRefresh=1,szName="【{$2}】·挑战开启",nTime=5.25,key="比武·{$2}"}},szTarget="擂台裁判"},
			{szTarget="擂台裁判",tCountdown={{nFrame=6,nClass=14,nIcon=1952,szName="洛阳擂台·挑战间隔",nTime=42,key="比武·{$me}"}},szContent="{$me}在比武中技高一筹，各位向她祝贺。"},
			{szContent="你打算再叫一盘，却看掌柜娜姿愁容满面，并没有注意到你。",tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·义千金·兰兰;15,奇遇不封印·约10分钟完成",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·娜姿·前往·风啸林",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="等待·剧情·对话·张野",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="带着·小驴·前往·风雨镇",nTime=600,key="奇遇提示3"}}},
			{szTarget="王开",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·张野·带着·小驴",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="缓慢·前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}},szContent="大、大哥，这个人看起来是个能打的……"},
			{szContent="小驴很开心的跟着你。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="带着·小驴·缓慢·移动",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}}},
			{szNote="交互·小驴",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·小驴·缓慢·移动",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}},[14]={bCenterAlarm=true},szContent="小驴停下脚步，它可能需要更多的鼓励，跟它聊聊天吧。"},
			{szContent="小驴很开心，你去哪，它也去哪。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="带着·小驴·缓慢·移动",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}}},
			{szContent="小驴跟丢了。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="返回·张野·寻找·小驴",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}}},
			{tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="返回·张野·寻找·小驴",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·风雨镇·入口",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="进入·剧情·对话·兰伊",nTime=600,key="奇遇提示3"}},szContent="小驴跑远了，不见踪影，再回去找找吧。"},
			{szContent="兰伊似乎有些不情愿，不若再与她谈谈。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·兰伊·返回·娜姿",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·兰伊·对话·方旬",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·秘方·对话·娜姿",nTime=600,key="奇遇提示3"}}},
			{szContent="兰伊擦着眼泪去找兰兰告别，不远处的一位白衣侠客却示意你过去。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·方旬·交互·秘方",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·娜姿·等待·剧情",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·方旬·返回·兰伊",nTime=600,key="奇遇提示3"}}},
			{szContent="娜姿生怕方旬反悔，当即在契上画了押，拿了金子。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·方旬·返回·兰伊",nTime=60,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·兰伊·完成·奇遇",nTime=60,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇·义千金·宠物兰兰",nTime=60,key="奇遇提示3"}}},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=4989,szName="蹲宠提示0",nTime="10,蹲宠·稻稻·已捕获;20,果子狸·CD·1小时",key="蹲宠提示0"}},szNote="蹲宠·稻稻·已被捕获",szContent="稻稻已被好心侠士带走。"},
		},
		[9] = {
			{[14]={bCenterAlarm=true},szContent="随着沐云冲被击退，地上出现了一块尘封之石，似乎记录着一些遗失的隐元秘鉴。",szTarget="%",tCountdown={{nIcon=13,nFrame=6,key="急报成就",szName="急报·沐云冲·拾取剩余",nTime=300,nClass=14}},szNote="急报成就·沐云冲"},
			{szTarget="老不知",tCountdown={{nIcon=12373,key="奇遇提示0",nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·红衣歌·红绸;15,奇遇不封印·约15分钟完成;30,1.对话·老不知;90,2.前往·天罚林·莫清尘;120,3.对话·莫清尘·寻找·水井;150,4.水井在东北方·泥娃娃树下;160,5.使用·一只小陶罐;180,6.返回·莫清尘·对话·墨漓;240,7.前往·洛道上游瀑布·打水;300,8.返回·墨漓·对话·莫清尘;360,9.寻找·小泥娃娃·东北方向;390,10.对话·小貂儿;450,11.赎罪林·桥下·墨漓;480,12.返回·莫清尘·返回·墨漓;540,13.返回·莫清尘·返回·老不知;600,14.返回·莫清尘·结束",nClass=14},{nIcon=12373,nClass=14,nFrame=7,szName="对话·老不知·天罚林·莫清尘",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·莫清尘·寻找·水井",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·莫清尘·寻找·净水",nTime=600,key="奇遇提示3"}},szContent="哈哈，出窑了！你烧了个不错的陶罐子。"},
			{szTarget="莫清尘",tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="30,3.对话·莫清尘·寻找·水井;90,4.水井在东北方·泥娃娃树下;120,5.使用·一只小陶罐;150,6.返回·莫清尘·对话·墨漓;240,7.前往·洛道上游瀑布·打水;300,8.返回·墨漓·对话·莫清尘;360,9.寻找·小泥娃娃·东北方向;390,10.对话·小貂儿;450,11.赎罪林·桥下·墨漓;480,12.返回·莫清尘·返回·墨漓;540,13.返回·莫清尘·返回·老不知;600,14.返回·莫清尘·结束",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="水井在东北方·泥娃娃树下",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="使用·一只小陶罐",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·莫清尘·对话·墨漓",nTime=600,key="奇遇提示3"}},szContent="水……水……"},
			{szTarget="墨漓",tCountdown={{nIcon=12373,key="奇遇提示0",nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·胜负局·蟹胜;15,奇遇封印3日·每日约5分钟完成;30,1.对话·航小婷;90,2.前往·隐贤居·封博安;120,3.对话·封博安;150,4.交互·棋盘;180,5.对话·云定风;210,6.对话·封博安;220,第一日·结束",nClass=14},{nIcon=12373,nClass=14,nFrame=7,szName="前往·洛道上游瀑布·打水",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="返回·墨漓·对话·莫清尘",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="寻找·小泥娃娃·东北方向",nTime=600,key="奇遇提示3"}},szContent="这症状……你，你竟然给清尘喝了井水！！"},
			{szTarget="墨漓",tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="60,9.寻找·小泥娃娃·东北方向;90,10.对话·小貂儿;180,11.赎罪林·桥下·墨漓;240,12.返回·莫清尘·返回·墨漓;300,13.返回·莫清尘·返回·老不知;330,14.返回·莫清尘·结束",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·莫清尘·寻找·小泥娃娃",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·莫清尘·对话·小貂儿",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="赎罪林桥下·墨漓·返回莫清尘",nTime=600,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·墨漓·返回·莫清尘",nTime=600,key="奇遇提示4"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·老不知·返回·莫清尘",nTime=600,key="奇遇提示5"}},szContent="{$me}，清尘就拜托你了！我寻解药去去就回！"},
			{szTarget="莫清尘",tCountdown={{nIcon=12373,nClass=14,nFrame=0,szName="完成奇遇·红衣歌·红绸",nTime=10,key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示1",nTime=0,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示4",nTime=0,key="奇遇提示4"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示5",nTime=0,key="奇遇提示5"}},szContent="嗯，我长大了也要打坏人。"},
			{szTarget="红师农",szContent="汝为男儿否？……不错，你便是圣教总教派遣来的吧！",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·尘网中·崽崽;15,奇遇不封印·约10分钟完成;30,1.对话·红师农;60,2.交互·两只猪仔;90,3.对话·红师农;120,4.再交互两只猪仔·对话红师农;180,5.枯木林·寻找·小猪崽·崽崽;210,6.使用小猪崽·寻找喂水点;270,7.对话红师农·返回崽崽;330,8.前往南屏山·天子峰桥下;390,9.拾取半本秘诀·返回洛道;450,10.对话红师农·使用崽崽;480,完成奇遇·尘网中·崽崽",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·红师农·交互·猪仔",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="寻找·枯木林·猪仔·崽崽",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="使用·小猪崽·寻找·喂水",nTime=600,key="奇遇提示3"}}},
			{szContent="此处还算安全，不如回去猪场问问红师农。",tCountdown={{nClass=14,nIcon=12373,nFrame=0,szName="奇遇提示0",nRefresh=0,bHold=true,nTime="60,7.对话红师农·返回崽崽;120,8.前往南屏山·天子峰桥下;180,9.拾取半本秘诀·返回洛道;210,10.对话红师农·使用崽崽;240,完成奇遇·尘网中·崽崽",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·红师农·返回·崽崽",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·南屏山·天子峰·桥下",bHold=true,nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="拾取·半本秘诀·返回·洛道",bHold=true,nTime=600,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·红师农·使用·崽崽",bHold=true,nTime=600,key="奇遇提示4"}}},
			{szContent="崽崽还在你的背包里，问问它愿不愿意和你走吧。",tCountdown={{nIcon=12373,nClass=14,nFrame=0,szName="奇遇提示0",nTime=0,key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="使用·崽崽·完成奇遇",nTime=20,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示2",nTime=0,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示4",bHold=true,nTime=0,key="奇遇提示4"}}},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=4989,szName="蹲宠提示0",nTime="10,蹲宠·稻稻·已捕获;20,果子狸·CD·1小时",key="蹲宠提示0"}},szNote="蹲宠·稻稻·已被捕获",szContent="稻稻已被好心侠士带走。"},
			{[14]={bCenterAlarm=true},szContent="增援已至红莲岗，速速进攻！",col={100,100,255},szTarget="浩气盟督廷卫",tCountdown={{nFrame=8,nClass=14,nRefresh=1,nIcon=8478,szName="浩气·兵符增援·红莲岗",nTime="10,浩气·兵符增援·红莲岗;300,浩气·红莲岗·兵符冷却;305,浩气·红莲岗·可用兵符",key="兵符·红莲岗"}},szNote="浩气·兵符增援·红莲岗"},
			{[14]={bCenterAlarm=true},szContent="增援已至秋雨堡，速速进攻！",col={100,100,255},szTarget="浩气盟督廷卫",tCountdown={{nFrame=8,nClass=14,nRefresh=1,nIcon=8478,szName="浩气·兵符增援·秋雨堡",nTime="10,浩气·兵符增援·秋雨堡;300,浩气·秋雨堡·兵符冷却;305,浩气·秋雨堡·可用兵符",key="兵符·秋雨堡"}},szNote="浩气·兵符增援·秋雨堡"},
