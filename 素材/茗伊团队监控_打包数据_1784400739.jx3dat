		[12] = {
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nIcon=6141,nFrame=7,szName="蹲宠提示0",nTime="10,蹲宠·蟹相·已捕获;20,蟹相·CD·2-3小时",key="蹲宠提示0"}},szNote="蹲宠·蟹相·已被捕获",szContent="不知道是谁丢失的《象棋谱·半仙局上部》，已被好心侠士带走。"},
