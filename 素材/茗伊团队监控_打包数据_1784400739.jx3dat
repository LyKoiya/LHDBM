			{szTarget="曾莲",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·捉贼记·吱吱;15,奇遇不封印·约5分钟完成",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·曾莲·前往·家园车夫处",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·严丫头·对话居业行伙计",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="回复·严丫头·交互·钱箱",nTime=600,key="奇遇提示3"}},szContent="这酒不错吧？我费了好大劲才从严丫头那儿买来的。"},
			{szContent="你仔细观察，发现了一些坚果碎屑。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·伙计·对话·老板",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="回复·严丫头·交互·树",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话小松鼠·返回严丫头",nTime=600,key="奇遇提示3"}}},
			{szContent="好像有一个小动物掉了下来。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·小松鼠·返回·严丫头",nTime=60,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="完成宠物奇遇·捉贼记·吱吱",nTime=60,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{szContent="掉下来的小动物又跑回了树上。",tCountdown={{nFrame=2,nIcon=13,szName="重新交互·一棵树",nTime=10,nClass=14}}},
