		[10] = {
			{[14]={bCenterAlarm=true},szContent="随着濯垢奇蛛被击退，地上出现了一块尘封之石，似乎记录着一些遗失的隐元秘鉴。",szTarget="%",tCountdown={{nFrame=6,nIcon=13,key="急报成就",szName="急报·濯垢奇蛛·拾取剩余",nTime=300,nClass=14}},szNote="急报成就·濯垢奇蛛"},
			{szTarget="猫猫",szContent="多谢少侠！",tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·破晓鸣·黄袍大统领;15,奇遇不封印·约10分钟完成;30,1.对话·猫猫;90,2.前往·车夫附近·韩惜辰;120,3.东边·椰子树下·诱捕的工具;150,4.交互·笼子·公鸡;210,5.前往·东侧·菊池岛;240,6.对话·一个晕倒的人;270,7.返回·韩惜辰·返回菊池岛;300,8.对话·顾释;310,完成奇遇·破晓鸣·黄袍大统领",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·猫猫·车夫附近·韩惜辰",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="东边·椰子树下·诱捕的工具",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="交互·笼子·前往·东侧菊池岛",nTime=600,nClass=14}}},
			{tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="30,6.对话·一个晕倒的人;60,7.返回·韩惜辰·返回菊池岛;120,8.对话·顾释;130,完成奇遇·破晓鸣·黄袍大统领",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·一个晕倒的人",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="返回·韩惜辰·返回菊池岛",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="对话·顾释·结束",nTime=600,nClass=14}},szContent="不远处好像有个人"},
			{szTarget="喜小乐",tCountdown={{nRefresh=0,nClass=14,nIcon=6110,nFrame=7,szName="蹲宠提示1",nTime="10,蹲宠·蟹兵·已捕获;20,喜小乐·CD·1-2小时",key="蹲宠提示1"}},szContent="我先回去了，我们有缘再见哦。"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=6110,szName="蹲宠提示0",nTime="10,蹲宠·蟹兵·已捕获;20,喜小乐·CD·1-2小时",key="蹲宠提示1"}},szNote="蹲宠·蟹兵·已被捕获",szContent="蟹兵已被好心侠士带走照顾。"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,key="蹲宠提示0",nFrame=7,nIcon=4988,szName="蹲宠提示0",nTime="10,蹲宠·蟹仔·已捕获;20,寄居蟹·CD·1-2小时",nClass=14}},szNote="蹲宠·蟹仔·已被捕获",szContent="蟹仔已被好心侠士带走。"},
