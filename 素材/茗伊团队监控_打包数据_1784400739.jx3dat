		[712] = {
			{szContent="已成功背起敌方旗帜，立刻将旗帜送回己方旗帜点！",[14]={bCenterAlarm=true,bTeamChannel=true},szNote="你背起敌方旗帜"},
		},
		[627] = {
			{szContent="老伙计们！这一车可得小心点，这路上可有不少浩气盟的探子，有劲的一会使出来！",col={255,100,100},szTarget="纪平",tCountdown={{nFrame=3,nClass=14,nIcon=15380,szName="恶人·护送矿车",nTime=347,key="押送物资"}},szNote="恶人·出车"},
			{szContent="诸位兄弟们，瓷器可换银钱，壮大我方势力，请与我一道运送回浩气盟！",col={100,100,255},szTarget="周也",tCountdown={{nFrame=7,nClass=14,nIcon=15384,szName="浩气·护送矿车",nTime=347,key="押送物资"}},szNote="浩气·出车"},
			{szContent="恶人谷的老伙计们！一路上可算没有出啥岔子。这是洒家给伙计们的报酬，且拿好。",col={255,100,100},szTarget="纪平",tCountdown={{nFrame=3,nIcon=2398,nClass=14,nRefresh=5,szName="恶人·跟车奖励",nTime=90,key="恶人事件"},{nFrame=3,nClass=14,nIcon=15380,szName="烂柯争锋拒鬼楼·押送物资",nTime=0,key="押送物资"}},szNote="恶人·跟车奖励"},
			{szContent="浩气盟的众兄弟们，辛苦了！这是盟里给众兄弟们的奖赏，请各位收下。",col={100,100,255},szTarget="周也",tCountdown={{nFrame=7,nIcon=2397,nClass=14,nRefresh=5,szName="浩气·跟车奖励",nTime=90,key="浩气事件"},{nIcon=15384,key="押送物资",szName="烂柯争锋拒鬼楼·押送物资",nTime=0,nClass=14}},szNote="浩气·跟车奖励"},
			{tCountdown={{nFrame=7,nClass=14,nIcon=2397,szName="浩气·劫车奖励",nTime=58,key="恶人事件"},{nIcon=15380,key="押送物资",szName="烂柯争锋拒鬼楼·押送物资",nTime=0,nClass=14}},col={255,100,100},szContent="【恶人·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。"},
			{tCountdown={{nFrame=3,nClass=14,nIcon=2398,szName="恶人·劫车奖励",nTime=58,key="浩气事件"},{nIcon=15384,key="押送物资",szName="烂柯争锋拒鬼楼·押送物资",nTime=0,nClass=14}},col={100,100,255},szContent="【浩气·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。"},
			{szTarget="谢烟客",tCountdown={{nFrame=7,nClass=14,nIcon=10449,nRefresh=2,szName="浩气盟·拾取·隐樵关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="吾奉盟主之令，特来镇守此处关隘。"},
			{szTarget="谢烟客",tCountdown={{nFrame=3,nClass=14,nIcon=10450,nRefresh=2,szName="恶人谷·拾取·隐樵关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={100,100,255},szContent="我浩气儿郎，必会拿回此关！"},
			{szTarget="司空仲平",tCountdown={{nFrame=7,nIcon=10449,nClass=14,nRefresh=2,szName="浩气盟·拾取·天生关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="司空仲平在此，尔等还不速速退去！"},
			{szTarget="司空仲平",tCountdown={{nFrame=3,nIcon=10450,nClass=14,nRefresh=2,szName="恶人谷·拾取·天生关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={100,100,255},szContent="来日落雁城再会会你！"},
			{szTarget="穆玄英",tCountdown={{nFrame=7,nIcon=10449,nClass=14,nRefresh=2,szName="浩气盟·拾取·赤岩关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="浩气盟，浩气长存！"},
			{szTarget="穆玄英",tCountdown={{nFrame=3,nClass=14,nIcon=10450,nRefresh=2,szName="恶人谷·拾取·赤岩关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={100,100,255},szContent="阁下好武艺。"},
			{szTarget="顾延恶",tCountdown={{nFrame=3,nIcon=10450,nClass=14,nRefresh=2,szName="恶人谷·拾取·隐樵关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="终于出趟谷，不容易呀！寒鸦大人请放心，第一关隘就交给我吧！"},
			{szTarget="顾延恶",tCountdown={{nFrame=7,nIcon=10449,nClass=14,nRefresh=2,szName="浩气盟·拾取·隐樵关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={255,100,100},szContent="待我唤我平安客栈众兄弟们前来支援，哼，暂且后退！"},
			{szTarget="陶寒亭",tCountdown={{nFrame=3,nIcon=10450,nClass=14,nRefresh=2,szName="恶人谷·拾取·天生关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="此处关隘，至关重要，谷主请放心！"},
			{szTarget="陶寒亭",tCountdown={{nFrame=7,nClass=14,nIcon=10449,nRefresh=2,szName="浩气盟·拾取·天生关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={255,100,100},szContent="终究是我小觑了天下英豪。"},
			{szTarget="白某",tCountdown={{nFrame=3,nIcon=10450,nClass=14,nRefresh=2,szName="恶人谷·拾取·赤岩关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="承让了！恶人谷众兄弟们，安心开采矿产。"},
			{szTarget="白某",tCountdown={{nFrame=7,nClass=14,nIcon=10449,nRefresh=2,szName="浩气盟·拾取·赤岩关·宝堆",nTime=180,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={255,100,100},szContent="待我谷中兄弟前来支援。"},
			{tCountdown={{nFrame=3,nClass=14,nIcon=15380,szName="烂柯争锋拒鬼楼·浩气事件",nTime=0,key="浩气事件"},{nFrame=7,nClass=14,nIcon=15384,szName="烂柯争锋拒鬼楼·恶人事件",nTime=0,key="恶人事件"}},col={255,255,100},szContent="侠士所在阵营无法拾取此物。"},
