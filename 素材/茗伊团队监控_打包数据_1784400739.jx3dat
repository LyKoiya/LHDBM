		[647] = {
			{tCountdown={{nIcon=13,key="云从券",szName="云从券·陆·大树下上香3次",nTime=10,nClass=14}},szContent="不知道为什么，到了这里总想拜一拜。"},
			{szTarget="宋子尧",tCountdown={{nClass=14,nIcon=12373,nFrame=0,bHold=true,nRefresh=0,szName="恭喜触发奇遇·白日梦",nTime="5,恭喜触发·破巧言·蛋黄;15,奇遇不封印·约20分钟完成;30,1.对话·宋子尧·等待剧情;120,2.对话·宋子尧身后·赵诚;150,3.对话·客栈角落·大汉;180,4.返回·对话·宋子尧;300,5.前往·客栈外山崖·宋子尧;360,6.往孙易云方向走·等待剧情;420,7.前往对面山崖·对话·胡商;480,8.跟随·胡商·别跳崖;540,9.拾取·包裹·返回·客栈内;600,10.对话·宋子尧·对话·赵诚;660,11.前往·长生雪野·长生右边;720,12.两个帐篷前光圈·捕获小鸟边;780,13.使用·精致的盒子·跟随小鸟;840,13.前往·山洞·直行;900,14.对话·宋子尧·王必言;930,15.返回·客栈·闻千瞬;960,16.对话·闻千瞬·结束",key="奇遇监控0"},{nFrame=7,key="奇遇提示1",nIcon=12373,bHold=true,szName="对话·宋子尧·等待剧情",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,bHold=true,szName="对话·宋子尧身后·赵诚",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,bHold=true,szName="对话·客栈角落·大汉",nTime=600,nClass=14}},szNote="破巧言",szContent="我给你说！你猜我在客栈看到谁了？金虚子卓凤鸣！不过他身边跟着好多弟子，只能远远看一眼。有生之年居然能亲见武林高人风姿，真是不愧此行啊！"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,bHold=true,szName="对话·宋子尧身后·赵诚",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,bHold=true,szName="对话·客栈角落·大汉",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,bHold=true,szName="返回·对话·宋子尧",nTime=600,nClass=14}},szNote="破巧言",szContent="算了算了，还是去问问那位公子哥吧！"},
			{tCountdown={{nClass=14,nIcon=12373,nRefresh=0,bHold=true,nFrame=0,szName="奇遇监控0",nTime="30,4.返回·对话·宋子尧;150,5.前往·客栈外山崖·宋子尧;240,6.往孙易云方向走·等待剧情;300,7.前往对面山崖·对话·胡商;480,8.跟随·胡商·别跳崖;540,9.拾取·包裹·返回·客栈内;600,10.对话·宋子尧·对话·赵诚;660,11.前往·长生雪野·长生右边;720,12.两个帐篷前光圈·捕获小鸟边;780,13.使用·精致的盒子·跟随小鸟;840,13.前往·山洞·直行;900,14.对话·宋子尧·王必言;930,15.返回·客栈·闻千瞬;960,16.对话·闻千瞬·结束",key="奇遇监控0"},{nFrame=7,key="奇遇提示1",nIcon=12373,bHold=true,szName="返回·对话·宋子尧",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,bHold=true,szName="前往·客栈外山崖·宋子尧",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,bHold=true,szName="往孙易云方向走·等待剧情",nTime=600,nClass=14}},szNote="破巧言",szContent="这王二很可疑！回去找宋子尧再商讨商讨。"},
