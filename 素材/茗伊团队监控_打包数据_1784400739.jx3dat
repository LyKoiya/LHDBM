			{szContent="你在挖掘宝藏时消耗了",szTarget="%",tCountdown={{nRefresh=59,nIcon=2409,key="挖宝·CD",szName="挖宝·CD",nTime="60,挖宝·CD;62,挖宝·冷却结束",nClass=14}},szNote="挖宝·CD",bSearch=true},
			{szTarget="%",tCountdown={{nIcon=3730,key="小猪快跑",szName="帮会领地·小猪快跑·活动开启",nTime=10,nClass=14}},szNote="帮会领地·小猪快跑·活动开启",szContent="【小猪快跑】活动正式开启，请众位侠士速回帮会协助三石叔赶回窜逃的小猪。若帮会总积分达到500分，则帮会和个人均会获得大量奖励！"},
			{szTarget="%",tCountdown={{nFrame=6,nIcon=3781,key="钓鱼活动",szName="帮会领地·钓鱼活动·40分钟",nTime=10,nClass=14}},szNote="帮会领地·钓鱼活动·正式开启",szContent="天上掉馅饼，鱼池落珍宝！刚得到可靠消息，韩非子夜观天象算准了在接下来的40分钟内，于唱晚池钓到稀有物品的概率将大幅增长，机不可失失不再来啊，速回帮会寻珍觅宝钓大鱼吧！"},
			{szTarget="%",tCountdown={{nIcon=3781,nFrame=6,key="钓鱼活动",szName="帮会领地·钓鱼活动·20分钟",nTime=10,nClass=14}},szNote="帮会领地·钓鱼活动·已经开启",szContent="据韩非子最新消息，唱晚池将于20分钟后归于平静。在此之前于唱晚池钓到稀有物品的概率将大幅增长，机不可失失不再来啊。"},
			{szTarget="%",tCountdown={{nIcon=3766,nFrame=6,key="菜园保卫战",szName="帮会领地·祝融山·猪九戒出现",nTime=10,nClass=14}},szNote="菜园保卫战·祝融山·猪九戒·出现",szContent="猪九戒出现祝融山，请大家速去阻止它破坏农田。"},
			{szTarget="%",tCountdown={{nFrame=6,nIcon=3766,key="菜园保卫战",szName="帮会领地·菜园保卫战·完满达成",nTime=20,nClass=14}},szNote="帮会领地·菜园保卫战·完满达成",szContent="本周帮会菜园保卫战完满达成，增加了70000点不占周上限的帮会资金。"},
			{szContent="阴山商路运输物资已成功开启，请有权限的侠士速到黑戈壁帮会物资主簿处申请成为运货首领开始运送！",col={100,255,255},szTarget="%",tCountdown={{nFrame=3,nIcon=8004,nClass=14,szName="阴山商路·帮会大跑商·开启",nTime=10,key="阴山商路"}},szNote="阴山商路·开启"},
			{szContent="此次帮会通过阴山商路成功运抵",col={100,255,255},szTarget="%",tCountdown={{nFrame=3,nIcon=8004,nClass=14,szName="阴山商路·成功运抵",nTime=20,key="阴山商路"},{nIcon=13,key="阴山商路·时限",szName="阴山商路·时限",nTime=-1,nClass=14}},szNote="阴山商路·成功运抵",bSearch=true},
			{[14]={bCenterAlarm=true},szContent="好像有鱼咬钩了，快收杆！",szTarget="%",tCountdown={{nFrame=2,nIcon=2678,key="钓鱼提示",szName="快收杆",nTime=5,nClass=14}},szNote="有鱼咬钩"},
			{szNote="恭喜触发·普通奇遇·寻猫记·夏夏",tCountdown={{nRefresh=0,key="奇遇提示0",nIcon=12371,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·普通奇遇·寻猫记;15,奇遇不封印·约5分钟完成;30,前往·扬州·活动区·夏夏",nClass=14}},[14]={bCenterAlarm=true},szContent="背包里不知何时多了一条小鱼干。"},
			{szTarget="%",tCountdown={{nIcon=12372,nClass=14,szName="奇遇提示",nTime=-2,key="奇遇提示"}},szContent="原来是天外陨石，去融天岭探听下消息。"},
			{szContent="发现一只迷途的小狗。",[14]={bCenterAlarm=true},szNote="触发·普通奇遇·故园风雨"},
			{szNote="恭喜触发·普通奇遇·金风倾楼",tCountdown={{nRefresh=0,nClass=14,nFrame=0,nIcon=12371,szName="恭喜触发·普通奇遇·金风倾楼",nTime="5,恭喜触发·普通奇遇·金风倾楼;10,奇遇奖励·[怜影·花仙]",key="奇遇提示0"}},[14]={bCenterAlarm=true},szContent="你收到了林若谷的传信。"},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nIcon=12371,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·乱世舞姬;15,奇遇不封印·约20分钟完成;30,奖励舞蹈动作·上元舞·庆云;60,前往·扬州杂货区·李亚仙侍女;80,前往·扬州擂台区·李亚仙;100,攻击·城门后·狼牙匿踪者",nClass=14}},szContent="你从花篮中拾取了一张小纸条。"},
