		[158] = {
			{szTarget="阶苔",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·药师观·接应阶苔",nTime=20,key="门派事件1"}},szContent="走吧，曹将军还在等我们。"},
			{szTarget="阶苔",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·接应阶苔·结束",nTime=5,key="门派事件1"}},szContent="多谢诸位侠士鼎立相助，阶苔在此谢过。"},
			{szTarget="阶苔",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·药师观·刺客袭击",nTime=20,key="门派事件2"}},szContent="请诸位侠士为我守护片刻。"},
			{szTarget="阶苔",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·药师观·游龙先生",nTime=20,key="门派事件3"}},szContent="大好头颅在此，尽管来拿！"},
			{szTarget="游龙先生",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件3·游龙先生·结束",nTime=5,key="门派事件3"}},szContent="人多势众，算什么好汉！我隐元会不会放弃的！"},
			{szTarget="无名",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·药师观·击退无名",nTime=20,key="门派事件1"}},szContent="有点本事，那我来亲自会会你。"},
			{szTarget="无名",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·击退无名·结束",nTime=5,key="门派事件1"}},szContent="今天我奈何不得你天策府，自然不会再纠缠此事。不过，我却做不了安将军的主，就此告辞。"},
			{tCountdown={{nIcon=947,nClass=14,szName="攻击·阿飞·接取任务",nTime=30,key="任务提示1"}},szContent="阿飞似乎嗅到了什么，吠叫着向你冲来……"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,nClass=14,nFrame=7,nIcon=4937,szName="蹲宠提示0",nTime="10,蹲宠·阿飞·已捕获;20,士兵的包裹·CD·2-3小时",key="蹲宠提示0"}},szNote="蹲宠·阿飞·已被捕获",szContent="士兵的包裹中的染血护甲残片已被好心侠士带走。"},
		},
		[159] = {
			{szTarget="蒋方文",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·美酒飘香·备材·开启",nTime=10,key="门派事件1"}},szContent="请大家稍事休息，老夫这就酿下一桶！"},
			{szTarget="蒋方文",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·美酒飘香·酿酒·开启",nTime=10,key="门派事件1"}},szContent="感谢大家鼎力相助，老夫这就开始用内功催发酒力。不过此处经常会有棕熊前来偷酒，还请各位相助一二。"},
			{szTarget="蒋方文",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·美酒飘香·酿酒·结束",nTime=5,key="门派事件1"}},szContent="哈哈哈！这酒算是成了！感谢各位的鼎力相助，蒋某不胜感激！"},
			{szTarget="郭岩",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·刺客来袭·开启",nTime=10,key="门派事件1"}},szContent="有刺客！！！保护师父！！"},
			{szTarget="郭岩",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·沈眠风之乱·开启",nTime=10,key="门派事件1"}},szContent="师弟，此处就交于我，你且护着师父师母退后！"},
			{szTarget="尹放",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·沈眠风之乱·结束",nTime=5,key="门派事件1"}},szContent="我们追！"},
			{szTarget="尹小荷",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·洞庭虹影·开启",nTime=10,key="门派事件1"}},szContent="各位可以来我这里领取钓竿，然后就在我身边的浅滩上垂钓，莫要走远了。钓到了鱼儿便放入我身边的鱼篓中即可！"},
			{szTarget="尹小荷",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件·洞庭虹影·斩龟",nTime=10,key="门派事件1"}},szContent="相传这水中有一只万年巨龟，莫不是惊动了它？真是天助我也，大家齐心斩了这巨龟，将其龟甲献给老帮主定是极好的！"},
			{szContent="好像有鱼儿上钩了，快收杆！",tCountdown={{nFrame=2,nIcon=2678,key="钓鱼提示",szName="快收杆",nTime=5,nClass=14}},[14]={bCenterAlarm=true},szNote="有鱼咬钩"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·郭珠·前往·关帝庙岛",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·龙俊华·前往·龙涎泉",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·洪笑尘·快捷商店·酒",nTime=600,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="赠予·今朝醉·送六炉金龙丹",nTime=600,nClass=14}},szContent="突然之间，你面前闪过一道黑影！"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="交互·面前美酒·等待·剧情",nTime=300,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="对话·郭珠·获得鲜美的小鱼",nTime=300,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="选中·小鳄鱼投喂鲜美的小鱼",nTime=300,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="对话·郭珠·完成奇遇醉烟波",nTime=300,nClass=14}},szContent="与面前的美酒交互即可饮酒。"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·郭珠·完成宠物奇遇",nTime=30,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="宠物·奇遇·醉烟波·饿饿",nTime=30,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14}},szContent="小鳄鱼一口吃掉了小鱼，看起来很开心。"},
