		[13] = {
			{szTarget="雪雪",tCountdown={{nIcon=293,nClass=14,nRefresh=15,szName="可以去广场戏台找熊爷",nTime=20,key="雪雪·旅行介绍1"},{nIcon=293,nClass=14,nRefresh=15,szName="可以去渡口刘理阳附近看湖",nTime=20,key="雪雪·旅行介绍2"}},szContent="一起去哪玩？"},
			{tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="神行·巴陵县·巴陵镇",nTime=20,key="江湖侠客·任务1"},{nFrame=6,nClass=14,nIcon=13,szName="小花猪·[接头]",nTime=20,key="江湖侠客·任务2"}},szContent="去往巴陵县的驿站寻找唐小珂的机关小猪。"},
			{[14]={bCenterAlarm=true},szContent="随着猿飞鬼助被击退，地上出现了一块尘封之石，似乎记录着一些遗失的隐元秘鉴。",szTarget="%",tCountdown={{nFrame=6,nIcon=13,key="急报成就",szName="急报·猿飞鬼助·拾取剩余",nTime=300,nClass=14}},szNote="急报成就·猿飞鬼助"},
