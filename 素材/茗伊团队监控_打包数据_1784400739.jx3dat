		[100] = {
			{szTarget="吉卓",tCountdown={{nIcon=13,nFrame=6,key="任务提示1",szName="黑天姬·剧情剩余",nTime=52,nClass=14}},szContent="明教以我为饵，目的就是引人来救，你们不可中计，速度离开！"},
			{szTarget="黑天姬",tCountdown={{nIcon=13,nFrame=6,key="任务提示1",szName="侠义！白龙口·黑天姬",nTime=10,nClass=14}},szContent="又冒出来几个不怕死的，口气还不小，那你们就一起上吧！"},
			{szTarget="吉卓",tCountdown={{nFrame=6,nIcon=13,key="任务提示1",szName="黑天姬·已败退",nTime=10,nClass=14}},szContent="黑天姬，你这又是何必？唉......"},
			{szContent="{$me}， 快到我这里来，小心被封影发现了。",szTarget="王志",tCountdown={{nIcon=12372,key="奇遇提示0",nFrame=0,szName="靠近·附近·王志",nTime=10,nClass=14}},szNote="三山四海·靠近·附近·王志",bSearch=true},
			{szTarget="王志",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12372,szName="三山四海·步骤·护心丹",nTime=10,nClass=14}},szNote="三山四海·步骤·护心丹",szContent="把我给你的丹药吃了吧，可在危难之时保你一命，就在你的背包里。"},
			{szTarget="王志",tCountdown={{nIcon=12372,key="奇遇提示0",nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="26,等待剧情·呆在原地勿动;35,使用引爆器·交互牢笼",nClass=14}},szContent="看到没？我的妻子何嫣就在前面，被关在那个牢笼里。"},
			{szTarget="王志",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12372,nRefresh=0,szName="奇遇提示0",nTime="7,等待剧情·呆在原地勿动;15,使用引爆器·交互牢笼",nClass=14}},szContent="好了，我去会会封影，你在此点等候，听指令行动。"},
			{szTarget="何嫣",tCountdown={{nIcon=12372,key="奇遇提示0",nFrame=0,szName="使用道具·[马哨·千里马]",nTime=10,nClass=14}},szContent="{$me}, 谢谢你与丈夫一同来救我。",bSearch=true},
			{szTarget="%",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12372,szName="交互·千里马·上马",nTime=10,nClass=14}},szNote="交互·千里马·上马",szContent="王志的千里马已出现，快上马！"},
			{szTarget="小诺",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="返回·高大胖·再取·烤羊腿",nTime=300,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·卧龙丘·对话·武大豪",nTime=300,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="修理·三处·捕收夹·武大豪",nTime=300,key="奇遇提示3"}},szContent="嗷唔~~~嗷唔~~嗷唔~~~"},
			{szContent="小心，前方出现一群恶狼！",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="等待·剧情结束·对话·小诺",nTime=300,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·卧龙丘·对话·武大豪",nTime=300,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="任务·寻药救小诺·日常10天",nTime=300,key="奇遇提示3"}}},
