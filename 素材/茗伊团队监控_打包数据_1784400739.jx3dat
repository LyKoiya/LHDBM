			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="前往·3号宅邸方向·大树下",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="交互·小寿带鸟·完成奇遇",nTime=60,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="奇遇提示3",nTime=0,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="奇遇提示4",nTime=0,nClass=14}},szContent="这只小寿带鸟绕着你飞了两圈，似乎在示意你跟它走。"},
		},
		[582] = {
			{szTarget="槲生",szContent="大侠，岁岁不见了！",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·故岁辞·岁岁;15,奇遇不封印·约10分钟完成;30,1.对话槲生·寻找散落的羽毛;60,2.羽毛在东南方屋子下;90,3.返回对话槲生;180,4.对话赵永·潘春·何实;210,5.对话槲生·前往光圈;240,6.光圈在散落的羽毛附近;300,7.对话龙俊华·等待剧情;330,8.对话龙俊华·前往车夫北面溪水;360,9.交互光圈·交互鸟笼;390,10.对话龙俊华·对话槲生;410,完成奇遇·故岁辞·岁岁",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·槲生·寻找·散落的羽毛",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·槲生·对话·赵永",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·潘春·对话·何实",nTime=600,key="奇遇提示3"}}},
			{szContent="去问问镇长吧。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,4.对话·何实;60,5.对话槲生·前往光圈;120,6.光圈在散落的羽毛附近;150,7.对话龙俊华·等待剧情;210,8.对话龙俊华·前往车夫北面溪水;240,9.交互光圈·交互鸟笼;270,10.对话龙俊华·对话槲生;290,完成奇遇·故岁辞·岁岁",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·何实·对话·槲生",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·光圈·等待·剧情",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="光圈·散落的羽毛·附近",nTime=600,key="奇遇提示3"}}},
			{szTarget="龙俊华",szContent="何人在此鬼鬼祟祟！",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,7.对话龙俊华·等待剧情;90,8.对话龙俊华·前往车夫北面溪水;120,9.交互光圈·交互鸟笼;150,10.对话龙俊华·对话槲生;170,完成奇遇·故岁辞·岁岁",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·龙俊华·等待·剧情",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="出门·龙俊华·交互·光圈",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="光圈·车夫北面溪水·附近",nTime=600,key="奇遇提示3"}}},
			{szTarget="龙俊华",szContent="爹娘也不会乐意我执着于仇恨的，那太傻了，人还是活的洒脱点好。",tCountdown={{nIcon=12373,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,8.对话龙俊华·前往车夫北面溪水;90,9.交互光圈·交互鸟笼;120,10.对话龙俊华·对话槲生;140,完成奇遇·故岁辞·岁岁",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="光圈·车夫北面溪水·附近",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·鸟笼·对话·龙俊华",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·槲生·完成·故岁辞",nTime=600,key="奇遇提示3"}}},
			{szTarget="龙俊华",szContent="这么多东西居然只有这几个人护送，也真够心大的。我不擅长匿形，把他们都打一顿算了，我来牵制看守，你去释放鸟兽？",tCountdown={{nIcon=12373,nClass=14,nFrame=0,szName="奇遇提示0",nTime=0,key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·鸟笼·对话·龙俊华",nTime=60,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·槲生·完成·故岁辞",nTime=60,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{szTarget="纪小橙",szContent="此后我也到了差不多能收个徒弟的年纪，虽然没有名气响亮的门派，我自己也没有厉害的称号，但我运气可好了，收到了一大堆不嫌弃我的徒弟。",tCountdown={{nIcon=12371,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="5,恭喜触发·侠者成歌;15,奇遇不封印·约10分钟完成;30,1.对话封演·前往晟江茶馆;120,2.对话纪小橙·前往兴威寨;150,3.靠近司空淮·攻击喽啰;160,4.对话司空淮·前往白菰里;210,5.名望区域信使旁·寻找苏舒;240,6.进入光圈·对话苏舒;420,7.对话苏舒·等待剧情;450,8.返回黄槲镇·对话封演;470,完成奇遇·侠者成歌",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12371,szName="对话·纪小橙·前往·兴威寨",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12371,szName="靠近·司空淮·攻击·喽啰",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12371,szName="对话·司空淮·前往·白菰里",nTime=600,key="奇遇提示3"}}},
			{szTarget="喽啰",szContent="打不过！快跑！",tCountdown={{nIcon=12371,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="10,4.对话司空淮·前往白菰里;60,5.名望区域信使旁·寻找苏舒;90,6.进入光圈·对话苏舒;270,7.对话苏舒·等待剧情;300,8.返回黄槲镇·对话封演;320,完成奇遇·侠者成歌",key="奇遇提示0"},{nIcon=12371,nClass=14,nFrame=7,szName="对话·司空淮·前往·白菰里",nTime=600,key="奇遇提示1"},{nIcon=12371,nClass=14,nFrame=7,szName="寻找·苏舒·名望区域信使旁",nTime=600,key="奇遇提示2"},{nIcon=12371,nClass=14,nFrame=7,szName="进入·光圈·对话·苏舒",nTime=600,key="奇遇提示3"}}},
			{szTarget="苏舒",szContent="哎……别提了……",tCountdown={{nIcon=12371,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,6.进入光圈·对话苏舒;210,7.对话苏舒·等待剧情;240,8.返回黄槲镇·对话封演;260,完成奇遇·侠者成歌",key="奇遇提示0"},{nIcon=12371,nClass=14,nFrame=7,szName="对话·苏舒·等待剧情",nTime=600,key="奇遇提示1"},{nIcon=12371,nClass=14,nFrame=7,szName="返回·黄槲镇·封演",nTime=600,key="奇遇提示2"},{nIcon=12371,nClass=14,nFrame=7,szName="完成·奇遇·侠者成歌",nTime=600,key="奇遇提示3"}}},
			{szContent="将收集到的三个故事交给封演。",tCountdown={{nIcon=12371,nClass=14,nRefresh=0,nFrame=0,szName="奇遇提示0",nTime="30,8.返回黄槲镇·对话封演;50,完成奇遇·侠者成歌",key="奇遇提示0"},{nIcon=12371,nClass=14,nFrame=7,szName="返回·黄槲镇·封演",nTime=60,key="奇遇提示1"},{nIcon=12371,nClass=14,nFrame=7,szName="完成·奇遇·侠者成歌",nTime=60,key="奇遇提示2"},{nIcon=12371,nClass=14,nFrame=7,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
