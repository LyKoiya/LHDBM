		},
		[101] = {
			{szTarget="沈笑颜",szContent="真好吃！",tCountdown={{nFrame=0,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·竹马情·弈棋小龟;15,奇遇不封印·约10分钟完成;30,1.对话·沈笑颜;120,2.归林泽上括号一个闪闪发光的物件;180,3.返回归林泽·沈笑颜;240,4.万宝阁下括号·万福;300,5.南冥谷上括号左·向万景;360,6.万宝阁下括号右下·向万景;480,7.返回归林泽·沈笑颜·结束",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·沈笑颜",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="归林泽上·一个闪闪发光的物件",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="返回·沈笑颜·万宝阁下·万福",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示4",nFrame=7,szName="前往·南冥谷左·向万景",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示5",nFrame=7,szName="前往·万宝阁右下·向万景",nTime=600,nClass=14}}},
			{szTarget="向万景",szContent="果果，快来快来，快看我给你带了什么。",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime="60,等待剧情·对话·向万景;300,返回归林泽·沈笑颜·结束",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="等待剧情·对话·向万景",nTime=60,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="奇遇提示2",nTime=0,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="奇遇提示4",nTime=0,nClass=14},{nFrame=7,key="奇遇提示5",nIcon=12373,szName="奇遇提示5",nTime=0,nClass=14}}},
			{szTarget="向万景",szContent="原来只要这样，那这两样东西我立刻就去还了。",tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="返回归林泽·沈笑颜·结束",nTime=240,nClass=14}}},
			{tCountdown={{nIcon=12373,key="奇遇提示0",nFrame=0,szName="奇遇提示0",nTime=0,nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="奇遇提示1",nTime=0,nClass=14}},szContent="宠物已成功添加。"},
		},
		[102] = {
			{szTarget="苗民卫兵",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=120,szName="门派事件1·圣兽潭·天一阴谋",nTime=10,key="门派事件1"}},szContent="我们不是这女人的对手,请侠士们出手相助!"},
			{szTarget="曲云",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=120,szName="门派事件1·天一阴谋·结束",nTime=5,key="门派事件1"}},szContent="这次多亏了侠士们及时赶到，才使我教免于一场劫难。"},
			{szTarget="曲云",tCountdown={{nFrame=3,nIcon=13,nClass=14,nRefresh=120,szName="门派事件2·圣兽潭·清除剩余血蚊",nTime=10,key="门派事件1"}},szContent="圣兽潭附近还有残余血蚊，望侠士们帮忙清理，此刻我还需带孙飞亮回总坛疗伤。"},
			{szTarget="五毒大师兄",tCountdown={{nFrame=0,nClass=14,nIcon=13,szName="门派事件1·五毒总坛·噬魂金虎",nTime=10,key="门派事件1"}},szContent="玛索师姐已去炼制血蚊丹，炼成后可以引走金虎，望众侠士相助五毒教，抵挡这植兽！"},
			{szTarget="玛索",tCountdown={{nFrame=0,nClass=14,nIcon=13,szName="门派事件1·噬魂金虎·结束",nTime=5,key="门派事件1"}},szContent="多亏侠士们拼死抵挡这植兽，刚才我用昨日侠士击杀血蚊炼成血蚊丹，已命教内轻功拔尖的教众携带这丹药向天一教老巢赶去。"},
			{szTarget="玛索",tCountdown={{nFrame=0,nIcon=13,nClass=14,nRefresh=120,szName="门派事件2·五毒总坛·清除剩余血蚊",nTime=10,key="门派事件2"}},szContent="我还要前去天一老巢打探一番，不要让我教众被这噬魂金虎误伤，告辞了！"},
			{szTarget="苗淼尔",szContent="一件虽然不贵重但有特殊意义的饰品。",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·滇南行;15,奇遇不封印·全程5-10分钟;60,1.圣兽潭左上·小土堆;90,1.拾取·脏兮兮的纸条;120,1.返回·苗淼尔;180,2.溪山渡上方·小土堆;210,2.拾取·脏脏的衣角;240,2.返回·苗淼尔;270,3.幽魂草泽·乌苏;300,3.幽魂草泽·寻找·换颜草;360,3.返回·乌苏;390,4.被打晕后·对话·苗淼尔;400,结束·滇南行",nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="1.圣兽潭左上·小土堆·返回",nTime=60,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="2.溪山渡上方·小土堆·返回",nTime=60,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="3.幽魂草泽·乌苏·换颜草",nTime=60,nClass=14},{nFrame=7,key="奇遇提示4",nIcon=12373,szName="4.返回·乌苏·对话·苗淼尔",nTime=60,nClass=14}}},
			{szContent="你已经挖掘过这个土堆了"},
			{[14]={bCenterAlarm=true,szVoice="ZhuanJieDuan"},szContent="圣兽潭出现了金翅雨蝶群，感兴趣的侠士们速去寻找吧！",szTarget="苏水心",tCountdown={{nFrame=7,nClass=14,nIcon=10154,szName="圣兽潭·金翅雨蝶群·出现",nTime=30,key="节日活动1"}},szNote="圣兽潭·金翅雨蝶群·出现"},
