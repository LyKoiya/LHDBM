		[215] = {
			{szTarget="航小婷",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·胜负局·螃胜螃负;10,宠物奖励·螃胜螃负·需要驯养;15,奇遇封印3日·每日约5分钟完成;30,1.对话·航小婷;90,2.前往·隐贤居·封博安;120,3.对话·封博安;150,4.交互·棋盘;180,5.对话·云定风;210,6.对话·封博安;220,第一日·结束",key="奇遇提示0"},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·航小婷·隐贤居·封博安",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·封博安·交互·棋盘",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·云定风·对话·封博安",nTime=600,nClass=14}},szContent="你很厉害，不过不知道象棋是不是也厉害呢？"},
			{szTarget="封博安",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="30,4.交互·棋盘;60,5.对话·云定风;90,6.对话·封博安;100,第一日·结束",key="奇遇提示0"},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="交互·棋盘",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·云定风",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·封博安",nTime=600,nClass=14}},szContent="开局。"},
			{szTarget="封博安",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="30,5.对话·云定风;60,6.对话·封博安;70,第一日·结束",key="奇遇提示0"},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·云定风",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·封博安",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="奇遇提示3",nTime=0,nClass=14}},szContent="为兄惭愧……但永王恳切，云兄何不考虑考虑？"},
			{szTarget="封博安",tCountdown={{nFrame=0,key="奇遇提示0",nIcon=12373,szName="奇遇提示0",nTime=0,nClass=14},{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·封博安·第一日·结束",nTime=20,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="第二日·前往·隐贤居",nTime=20,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="第二日·交互·棋局",nTime=20,nClass=14}},szContent="哎，云兄，若我们能共享富贵，何必下棋争这一壶浊酒呢？"},
			{szTarget="封博安",tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·封博安·贺城·封博安",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="对话·封博安·对话·邢簿征",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="对话·云定风·对话·邢簿征",nTime=600,nClass=14}},szContent="局中棋势策略均无破绽，为何有……"},
