			{szTarget="%",szContent="【武林争霸赛】本届武林争霸赛正式已开启！风起云涌，一朝闻名天下知！已报名的帮会侠士，可前往各大主城或各门派，闻千瞬处对话进入参与对决！！！帮会帮主及核心成员优先进入，以免造成不便！！！",szNote="武林争霸赛·正式开启",tCountdown={{nIcon=13,key="武林争霸赛",nRefresh=1,nFrame=6,szName="武林争霸赛·正式开启",nTime=10,nClass=14}}},
			{szTarget="%",szContent="[帮会总管]邵卿城：诸位兄弟，愿此行战无不胜，扬我帮威！",szNote="武林争霸赛·已经报名",tCountdown={{nIcon=13,key="武林争霸赛",nRefresh=1,nFrame=6,szName="武林争霸赛·已经报名",nTime=10,nClass=14}}},
