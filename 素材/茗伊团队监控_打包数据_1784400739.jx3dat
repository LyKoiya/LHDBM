		[-20] = {
			{col={255,50,255},szContent="万水千山总是情，买满货物行不行？",[14]={bCenterAlarm=true,szVoice="ShiYongDaoJu",bFullScreen=true},szNote="据点贸易·货物不足"},
			{[14]={bCenterAlarm=true},szContent="因侠士近来行为异常，逐鹿中原期间，禁止参与，你即将被传送到百溪！",col={255,50,255},tCountdown={{nFrame=2,nClass=14,nIcon=13,bHold=true,szName="据点攻防·禁止参与本场",nTime=30,key="挂机检测"}},szNote="据点攻防·禁止参与"},
			{[14]={bCenterAlarm=true},szContent="侠士对抗类装分过低，请前往分流场景或黑戈壁参与。",col={255,50,255},tCountdown={{nFrame=2,nClass=14,nIcon=13,bHold=true,szName="据点攻防·装分过低",nTime=30,key="挂机检测"}},szNote="据点攻防·装分过低"},
			{[14]={bCenterAlarm=true,szVoice="DianMing_P",bTeamChannel=true,bFullScreen=true,bWhisperChannel=true},szContent="系统检测您有挂机行为，如果长期维持该状态将被传送出图！",col={255,50,255},tCountdown={{nIcon=13,nClass=14,nFrame=2,szName="挂机检测·动一动",nTime=30,key="挂机检测"}},szNote="挂机检测·快活跃起来"},
