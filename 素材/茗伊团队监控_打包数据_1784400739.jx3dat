		[150] = {
			{szTarget="雪雪",tCountdown={{nIcon=293,nClass=14,nRefresh=15,szName="三生树找·NPC波斯猫",nTime=20,key="雪雪·旅行介绍1"},{nIcon=293,nClass=14,nRefresh=15,szName="三生树东北找·两只贴贴的骆驼",nTime=20,key="雪雪·旅行介绍2"}},szContent="一起去哪玩？"},
			{szTarget="陆烟儿",tCountdown={{nFrame=0,nClass=14,nIcon=13,szName="门派事件1·圣墓山·明尊大典·祈",nTime=20,key="门派事件1"}},szContent="如此，我们就同心相祈，大会这便开始。"},
			{szTarget="宫觥",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·圣墓山·宫觥",nTime=10,key="门派事件2"}},szContent="杀掉那些中原人！！"},
			{szTarget="丁君",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件2·宫觥·结束",nTime=5,key="门派事件2"}},szContent="恐怕今日来的只是红衣教先遣教徒，明日还会有一场大战。"},
			{szTarget="陆烟儿",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·三生树·血染红衣",nTime=10,key="门派事件1"}},szContent="果然不出所料，红衣教昨日只是派出刺客先行，捣乱祈愿大会。"},
			{szTarget="陆烟儿",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="门派事件1·血染红衣·结束",nTime=5,key="门派事件1"}},szContent="红衣教徒已尽数消灭，多谢各位侠士仗义援手！"},
			{tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="对话·赫连别月·前往地图左下角",nTime=60,key="任务提示1"}},szContent="老伯似乎还有事相求。"},
			{tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="返回·赫连别月·家里·继续对话",nTime=60,key="任务提示1"}},szContent="老伯似乎心神不宁，回家里陪他一下吧。"},
			{szTarget="赫连别月",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="等等看·赫连鹰扬·是否回家",nTime=20,key="任务提示1"}},szContent="谢谢你吉言。"},
			{szTarget="赫连鹰扬",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="赫连鹰扬·回家了",nTime=10,key="任务提示1"}},szContent="我，回来了。"},
		},
		[151] = {
			{szTarget="曹炎烈",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="曹炎烈·激活剩余",nTime=102,key="公共事件2"}},szContent="来者可是藏剑的叶凡叶五少爷？果然大家之子，气度不凡。叶家五少真是名不虚传啊。"},
			{szTarget="曹炎烈",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="曹炎烈·免死剩余",nTime=300,key="公共事件2"}},szContent="可惜可惜！"},
			{szTarget="叶凡",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="曹炎烈·已击退",nTime=5,key="公共事件2"}},szContent="你已招架不住，还不束手就擒？"},
			{szTarget="藏剑弟子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="公共事件1·护卫除追兵·结束",nTime=5,key="公共事件1"}},szContent="多谢诸位侠士护送，我们在此稍作整顿即可自行前往目的地了。"},
			{szTarget="高级藏剑弟子",tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="公共事件1·护卫除追兵·结束",nTime=5,key="公共事件1"}},szContent="多谢诸位侠士护送，我们在此稍作整顿即可自行前往目的地了。"},
			{tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="公共事件1·护卫除追兵·结束",nTime=5,key="公共事件1"}},szContent="你获得了事件【护送除追兵】的奖励。"},
			{szTarget="求助的流民",tCountdown={{nFrame=0,nClass=14,nIcon=13,szName="成就·心慈手软·放走妇人",nTime=15.3,key="茶馆·成就"}},szContent="啊……"},
			{szTarget="求助的流民",tCountdown={{nFrame=0,nClass=14,nIcon=13,szName="成就·心慈手软·放走妇人",nTime=0,key="茶馆·成就"}},szContent="多谢大侠饶命！多谢大侠饶命！"},
			{szTarget="苏恨林",tCountdown={{nIcon=13,key="任务提示1",szName="任务提示1",nTime=0,nClass=14}},szContent="我不怕，娘说那些狼不会咬我！"},
			{szTarget="阎规",tCountdown={{nIcon=12372,key="奇遇提示2",nFrame=7,bHold=true,szName="洛阳·战乱·洛阳城门",nTime=600,nClass=14},{nIcon=12372,key="奇遇提示3",nFrame=7,bHold=true,szName="茶馆附近·对话·神秘人",nTime=600,nClass=14}},szContent="茶馆这么多人，要找谁打听呢……"},
			{szTarget="神秘人",tCountdown={{nFrame=7,key="奇遇提示2",nIcon=12372,bHold=true,szName="依次对话·阎规·鲁小兔",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12372,bHold=true,szName="结束对话后前往山顶结拜",nTime=600,nClass=14}},szContent="你的朋友已经先过去了。"},
			{szTarget="鲁小兔",tCountdown={{nIcon=12372,key="奇遇提示2",nFrame=7,bHold=true,szName="背对神秘人·走台阶·佛塔",nTime=600,nClass=14},{nIcon=12372,key="奇遇提示3",nFrame=7,bHold=true,szName="再次对话·鲁小兔·QTE",nTime=600,nClass=14}},szContent="东西我都准备妥当就差人了，快跟我来山顶。"},
			{szTarget="阎规",tCountdown={{nFrame=7,key="奇遇提示2",nIcon=12372,bHold=true,szName="结束QTE·再次对话·鲁小兔",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12372,bHold=true,szName="奇遇封印·次日7时",nTime=600,nClass=14}},szContent="咕噜…"},
			{szTarget="鲁小兔",tCountdown={{nIcon=12372,key="奇遇提示2",nFrame=7,bHold=true,szName="棚子后面小山丘·山谷中间",nTime=600,nClass=14},{nIcon=12372,key="奇遇提示3",nFrame=7,bHold=true,szName="对话·鲁小兔·QTE",nTime=600,nClass=14}},szContent="我在山下的小山谷当大侠，快来~"},
			{szTarget="鲁小兔",tCountdown={{nFrame=7,key="奇遇提示2",nIcon=12372,bHold=true,szName="再次对话·鲁小兔",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12372,bHold=true,szName="奇遇封印·次日7时",nTime=600,nClass=14}},szContent="举手之劳，何足挂齿！日后你再被人劫道，报本女侠的大名就好！"},
			{szTarget="鲁小兔",tCountdown={{nIcon=12372,key="奇遇提示2",nFrame=7,bHold=true,szName="棚子后面小山丘·下方",nTime=600,nClass=14},{nIcon=12372,key="奇遇提示3",nFrame=7,bHold=true,szName="对话·鲁小兔·QTE",nTime=600,nClass=14}},szContent="擂台就在山下，跟我来。"},
			{szTarget="鲁小兔",tCountdown={{key="奇遇提示2",nRefresh=600,nIcon=12372,bHold=true,nFrame=7,szName="佛塔·右后方",nTime=600,nClass=14},{key="奇遇提示3",nRefresh=600,nIcon=12372,bHold=true,nFrame=7,szName="对话·鲁小兔·使用包裹",nTime=600,nClass=14}},szContent="我选的山头在这边，跟我来。"},
			{szTarget="鲁小兔",tCountdown={{nFrame=7,key="奇遇提示2",nIcon=12372,bHold=true,szName="奇遇提示2",nTime=-2,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12372,bHold=true,szName="奇遇提示3",nTime=-2,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12372,bHold=true,szName="再次对话·鲁小兔",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12372,bHold=true,szName="随后对话·阎规",nTime=600,nClass=14}},szContent="嗯嗯不错不错，江湖儿女鲁小兔今日就正式退出江湖啦~"},
			{szTarget="鲁小兔",tCountdown={{key="奇遇提示2",nRefresh=600,nIcon=12372,bHold=true,nFrame=7,szName="对话·阎规",nTime=600,nClass=14},{key="奇遇提示3",nRefresh=600,nIcon=12372,bHold=true,nFrame=7,szName="次日7时·再来此处",nTime=600,nClass=14}},szContent="鲁小兔的两位结拜好兄弟，今日就到此处吧，两位明日来此墓前，小兔有要事相托。"},
			{szTarget="神秘人",tCountdown={{nRefresh=0,key="蹲宠提示0",nIcon=1898,nFrame=7,szName="蹲宠提示0",nTime="10,蹲宠·阿里·已捕获;20,奇怪的包袱·CD·2-3小时",nClass=14}},szNote="蹲宠·阿里·已被捕获",szContent="奇怪的包袱中的段氏腰牌已被好心侠士带走。"},
		},
		[152] = {
			{szTarget="%",tCountdown={{nFrame=4,nClass=14,nIcon=13,szName="{$sender}·已经刷新",nTime=10,key="监狱事件"}},szContent="监狱中的蝼蚁，看我这次怎么虐杀你们！"},
			{szTarget="%",tCountdown={{nFrame=4,nClass=14,nIcon=13,szName="{$sender}·已击伤",nTime=10,key="监狱事件"}},szContent="各位少侠饶命,我这有一批消罪状,可消减少许各位身上的杀气！"},
		},
