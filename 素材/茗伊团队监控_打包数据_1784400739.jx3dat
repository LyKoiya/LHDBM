			{tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="门派事件1·红袖飞花·结束",nTime=5,key="门派事件1"}},szContent="【七秀·红袖飞花】事件已经结束，由于你没有贡献，没有获得奖励。"},
