		[247] = {
			{szContent="张大眼似乎在找你",tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="结局·[铁血黎明]·达成分支",nTime=3600,key="铁血黎明1"},{nIcon=13,nClass=14,nFrame=6,szName="前往·土地庙·对话·张大眼",nTime=600,key="任务提示1"}},szNote="结局·[铁血黎明]·达成分支",[14]={bCenterAlarm=true}},
			{szNote="不打疯子",szContent="不好，这疯子发疯开始攻击你，而且功夫不一般。",[14]={bCenterAlarm=true},tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="[害人害己]·被疯子打死",nTime=600,key="任务提示1"},{nIcon=13,nClass=14,nFrame=6,szName="[害人害己]·关武学助手",nTime=600,key="任务提示2"}}},
			{tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="[易道殊途]·对话·受伤的路人",nTime=60,key="易道殊途1"},{nFrame=5,nClass=14,nIcon=13,szName="[易道殊途]·莫雨·选项·1·2",nTime=60,key="易道殊途2"},{nIcon=13,nClass=14,nFrame=5,szName="[路止狂童]·同上·但被莫雨重伤",nTime=60,key="路止狂童1"},{nIcon=13,nClass=14,nFrame=5,szName="[路止狂童]·不打莫雨·得脱装备",nTime=60,key="路止狂童2"},{nFrame=7,nClass=14,nIcon=13,szName="[刘洋好感]·选1·相信莫雨",nTime=60,key="刘洋好感1"}},szContent="似乎有人在呼救，去四周看看。"},
			{szTarget="莫雨",tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="结局·[易道殊途]·分支达成",nTime=600,key="任务提示1"},{nIcon=13,nClass=14,nFrame=6,szName="继续·进行主线任务",nTime=600,key="任务提示2"}},szContent="啊！不是我不是我不是我！！！"},
			{szTarget="莫雨",tCountdown={{nIcon=13,nClass=14,nFrame=7,szName="刘洋好感·受伤的路人·选1信莫雨",nTime=30,key="刘洋好感1"}},szContent="谢谢大侠！"},
			{szTarget="咸鱼",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="任务提示1",nTime=0,key="任务提示1"},{nIcon=13,nClass=14,nFrame=5,szName="任务提示2",nTime=0,key="任务提示2"}},szContent="好功夫！"},
			{szTarget="招财",tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="[杀手之路]·不打小怪·等神秘人",nTime=600,key="任务提示1"},{nIcon=13,nClass=14,nFrame=6,szName="若不小心打了·远离后重新刷新",nTime=600,key="任务提示2"}},szContent="站住！"},
			{szTarget="神秘人",tCountdown={{nIcon=13,nClass=14,nFrame=6,szName="[杀手之路]·拾取令牌·催雪",nTime=600,key="任务提示1"},{nIcon=13,nClass=14,nFrame=6,szName="继续·进行主线任务",nTime=600,key="任务提示2"}},szContent="年轻人好奇心这么重做什么，走吧走吧，该干什么干什么去。"},
			{[14]={bCenterAlarm=true},szContent="没想到你喂鸡还挺像样子的，孩子是不是以前干过农活儿啊？",szTarget="王婆婆",tCountdown={{nIcon=13,nClass=14,nFrame=7,szName="接取·喂鸡任务",nTime=30,key="喂鸡"}},szNote="接取·喂鸡任务"},
			{szNote="可用·王婆婆的炉子",tCountdown={{nIcon=13,nClass=14,nFrame=7,szName="可用·王婆婆的炉子",nTime=30,key="喂鸡"}},[14]={bCenterAlarm=true},szContent="可以使用【王婆婆的小火炉】了。"},
			{tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="董龙·剧情剩余",nTime=18,key="剧情提示"}},szContent="董龙就在前面，快去打败他！"},
			{tCountdown={{nFrame=3,nClass=14,nIcon=13,szName="[1]杖头·[2]亭高·[2]鲤鱼",nTime=600,key="咸鱼对诗1"},{nFrame=3,nClass=14,nIcon=13,szName="[2]麦秋·[2]镜湖·[2]飞珠",nTime=600,key="咸鱼对诗2"}},szContent="咸鱼的位置已经标记在地图中，打开地图查看。"},
			{szContent="大雕已经吃饱了，不远处的秋叶青好像有事找你。",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="[海外仙山]·继续【秋叶青】对话",nTime=600,key="任务提示1"},{nFrame=4,nIcon=13,szName="【大雕】好感已满",nTime=3600,nClass=14}},[14]={bCenterAlarm=true},szNote="【大雕】好感已满"},
			{[14]={bCenterAlarm=true},szContent="王婆婆现在对你亲密无间。",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="[杀手之路]·王婆婆·接任务",nTime=600,key="任务提示1"},{nFrame=6,nClass=14,nIcon=13,szName="[杀手之路]·捉鸡时不要打小怪",nTime=600,key="任务提示2"},{nFrame=4,nIcon=13,szName="【王婆婆】好感已满",nTime=3600,nClass=14}},szNote="【王婆婆】好感已满",bSearch=true},
			{[14]={bCenterAlarm=true},szContent="李复现在对你亲密无间。",[20]={bCenterAlarm=true},tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="[重写史篇]·紫晴满好感喂汤",nTime=600,key="任务提示1"},{nFrame=6,nClass=14,nIcon=13,szName="[何必执着]·紫晴不满好感喂汤",nTime=600,key="任务提示2"},{nFrame=4,nIcon=13,szName="【李复】好感已满",nTime=3600,nClass=14}},szNote="【李复】好感已满",bSearch=true},
			{[14]={bCenterAlarm=true},szContent="紫晴现在对你亲密无间。",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="[重写史篇]·李复满好感·喂汤",nTime=600,key="任务提示1"},{nFrame=6,nClass=14,nIcon=13,szName="[悬壶济世]·继续进行主线",nTime=600,key="任务提示2"},{nFrame=4,nIcon=13,szName="【紫晴】好感已满",nTime=3600,nClass=14}},szNote="【紫晴】好感已满",bSearch=true},
			{[14]={bCenterAlarm=true},szContent="小月现在对你亲密无间。",tCountdown={{nFrame=6,nClass=14,nIcon=13,szName="[重振药宗]·[舍身济世]·[俪影侠踪]",nTime=600,key="任务提示1"},{nFrame=6,nClass=14,nIcon=13,szName="拾取·苎麻·对话·织女·接任务",nTime=600,key="任务提示2"},{nFrame=4,nIcon=13,szName="【小月】好感已满",nTime=3600,nClass=14}},szNote="【小月】好感已满",bSearch=true},
			{szContent="刘洋现在对你亲密无间。",tCountdown={{nFrame=4,nIcon=13,szName="【刘洋】好感已满",nTime=3600,nClass=14}},szNote="【刘洋】好感已满",[14]={bCenterAlarm=true}},
			{[14]={bCenterAlarm=true},szContent="张忠现在对你亲密无间。",tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="[驭兽宗师]·继续主线任务",nTime=60,key="驭兽宗师1"},{nFrame=4,nIcon=13,szName="【张忠】好感已满",nTime=3600,nClass=14},{nFrame=5,nClass=14,nIcon=13,szName="兵不血刃1",nTime=-2,key="兵不血刃1"},{nFrame=5,nClass=14,nIcon=13,szName="兵不血刃2",nTime=-2,key="兵不血刃2"}},szNote="【张忠】好感已满",bSearch=true},
			{szContent="梁师农现在对你亲密无间。",tCountdown={{nRefresh=3600,nClass=14,nFrame=5,nIcon=13,szName="[猪运亨通]·继续主线任务",nTime=60,key="猪运亨通1"},{nFrame=4,nIcon=13,szName="【梁师农】好感已满",nTime=3600,nClass=14},{nIcon=13,nClass=14,nFrame=5,szName="兵不血刃1",nTime=-2,key="兵不血刃1"},{nIcon=13,nClass=14,nFrame=5,szName="兵不血刃2",nTime=-2,key="兵不血刃2"}},szNote="【梁师农】好感已满",bSearch=true},
			{tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="梁师农好感·村长·寻5只猪",nTime=60,key="梁师农好感1"}},szContent="不好，梁师农的猪看到陌生人吓得四散而逃，还是告知一下村长吧。"},
			{szTarget="董龙",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="董龙·剧情剩余",nTime=162,key="剧情提示"}},szContent="刘老头,你这阵仗是赶集呢？空冥决拿来了吗？"},
			{szTarget="秋叶青",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="秋叶青·剧情结束·再对话",nTime=15,key="剧情提示"}},szContent="好，谢谢你。这汤闻起来呀，可真像当年家里厨子的手艺。"},
			{szTarget="紫晴",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="结局·[何必执着]·剧情剩余",nTime=82,key="剧情提示"}},szContent="秋姑娘，你好好休息，李复先生很快便来看你了。"},
			{szTarget="紫晴",tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="结局·[长草萋萋]·剧情剩余",nTime=40,key="剧情提示"}},szContent="秋姑娘，李复先生……晚一些便会来了。"},
			{szTarget="李复",tCountdown={{nFrame=5,nClass=14,nIcon=13,szName="结局·[重写史篇]·剧情剩余",nTime=122,key="剧情提示"}},szContent="秋姑娘。"},
			{szTarget="张大眼",tCountdown={{nIcon=13,nClass=14,nFrame=5,szName="董龙·剧情剩余",nTime=87,key="剧情提示"}},szContent="董老大，就……就是这人，要……要把空冥决给您。"},
