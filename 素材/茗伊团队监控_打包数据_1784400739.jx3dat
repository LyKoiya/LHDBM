			{[14]={bCenterAlarm=true},szContent="^赤兔马已到达(.*)附近，有志于征服赤兔的侠士可速速赶去！",szTarget="方问",tCountdown={{nFrame=4,nClass=14,nIcon=5991,szName="赤兔·{$1}",nTime=240,key="赤兔"}},szNote="赤兔·{$1}",bReg=true},
			{[14]={bCenterAlarm=true},szContent="马中武神赤兔已正式出山！有卦文龟甲的侠士可以前去试图抓捕！",szTarget="方问",tCountdown={{nIcon=5991,nFrame=4,nClass=14,szName="赤兔·正式出山",nTime=180,key="赤兔"}},szNote="赤兔·正式出山"},
