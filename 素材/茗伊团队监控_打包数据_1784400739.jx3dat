		[666] = {
			{szContent="附近似乎有人在呼唤你。",tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·风花雪·蓝蓝;15,奇遇不封印·约10分钟完成",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·元五·出云寨与石林中间",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·段明燕·背后山顶的光圈",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·段明燕·前往·大理山庄",nTime=600,key="奇遇提示3"}}},
			{szContent="旁边似乎有人在欣赏风景，去问问看或许能得到线索。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·段明燕·前往大理山庄",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="交互·段明燕·身边·光圈点",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·段明燕·前往·晚山镇",nTime=600,key="奇遇提示3"}}},
			{szContent="你们找到了小猫的线索，但小猫仍然不见踪迹，不若再去问问一旁的段明燕。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·段明燕·前往·晚山镇",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·段明燕·身边·光圈点",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·段明燕·前往溶洞入口",nTime=600,key="奇遇提示3"}}},
			{szContent="苇草素白，与晚山镇的小桥流水交相映衬，但小猫仍不见踪影，还会去哪儿呢？不若再去与段明燕讨论一番。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·段明燕·前往溶洞入口",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="靠近·溶洞里面的石台·剧情",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·段明燕·返回·摸宠点",nTime=600,key="奇遇提示3"}}},
			{szContent="小猫咪静静地望着荧荧的湖水。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="对话·段明燕·返回·出云寨",nTime=120,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·元五·完成·宠物奇遇",nTime=120,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="获得·风花雪·小猫咪·蓝蓝",nTime=120,key="奇遇提示3"}}},
		},
		[697] = {
			{szTarget="谢烟客",tCountdown={{nFrame=7,nIcon=10449,nClass=14,nRefresh=2,szName="浩气盟·盘碣关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="吾奉盟主之令，特来镇守此处关隘。"},
			{szTarget="司空仲平",tCountdown={{nFrame=7,nClass=14,nIcon=10449,nRefresh=2,szName="浩气盟·回雁关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="司空仲平在此，尔等还不速速退去！"},
			{szTarget="穆玄英",tCountdown={{nFrame=7,nClass=14,nIcon=10449,nRefresh=2,szName="浩气盟·赤焰关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·浩气盟",nTime=-1,key="关隘·拾取·浩气盟"}},col={100,100,255},szContent="浩气盟，浩气长存！"},
			{szTarget="顾延恶",tCountdown={{nFrame=3,nClass=14,nIcon=10450,nRefresh=2,szName="恶人谷·盘碣关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="终于出趟谷，不容易呀！寒鸦大人请放心，第一关隘就交给我吧！"},
			{szTarget="陶寒亭",tCountdown={{nFrame=3,nIcon=10450,nClass=14,nRefresh=2,szName="恶人谷·回雁关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nIcon=13,nClass=14,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="此处关隘，至关重要，谷主请放心！"},
			{szTarget="白某",tCountdown={{nFrame=3,nClass=14,nIcon=10450,nRefresh=2,szName="恶人谷·赤焰关·拾取剩余",nTime=179,key="关隘宝箱"},{nFrame=-1,nClass=14,nIcon=13,nRefresh=1,szName="关隘·拾取·恶人谷",nTime=-1,key="关隘·拾取·恶人谷"}},col={255,100,100},szContent="承让了！恶人谷众兄弟们，安心开采矿产。"},
			{tCountdown={{nFrame=7,nIcon=13,key="恶人·矿车",szName="浩气·劫车奖励",nTime=59,nClass=14}},col={255,100,100},szContent="【恶人·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。"},
			{tCountdown={{nIcon=13,nFrame=3,key="浩气·矿车",szName="恶人·劫车奖励",nTime=59,nClass=14}},col={100,100,255},szContent="【浩气·运送物资】事件已经结束，由于你没有贡献，没有获得奖励。"},
			{szTarget="宋道希",tCountdown={{nRefresh=10,nFrame=7,nIcon=13,key="恶人·矿车",szName="浩气·劫车奖励",nTime=60,nClass=14}},col={255,100,100},szContent="不好！物资车被砸！这里不宜久留，大家先撤，待重整旗鼓再来一番！"},
			{szTarget="吴宿知",tCountdown={{nRefresh=10,nIcon=13,nFrame=3,key="浩气·矿车",szName="恶人·劫车奖励",nTime=60,nClass=14}},col={100,100,255},szContent="不好！物资车被劫！这里不宜久留，大家先撤，待重整旗鼓再来一番！"},
			{szTarget="宋道希",tCountdown={{nRefresh=10,nFrame=3,nIcon=13,key="恶人·矿车",szName="恶人·跟车奖励",nTime=90,nClass=14}},col={255,100,100},szContent="恶人谷的老伙计们！一路上可算没有出啥岔子。这是洒家给伙计们的报酬，且拿好。"},
			{szTarget="吴宿知",tCountdown={{nRefresh=10,nFrame=7,nIcon=13,key="浩气·矿车",szName="浩气·跟车奖励",nTime=90,nClass=14}},col={100,100,255},szContent="浩气盟的众兄弟们，辛苦了！这是盟里给众兄弟们的奖赏，请各位收下。"},
			{szTarget="宋道希",tCountdown={{nFrame=3,nIcon=13,key="恶人·矿车",szName="恶人·护送矿车",nTime=292,nClass=14}},col={255,100,100},szContent="老伙计们！这一车可得小心点，这路上可有不少浩气盟的探子，有劲的一会使出来！"},
			{szTarget="吴宿知",tCountdown={{nFrame=7,nIcon=13,key="浩气·矿车",szName="浩气·护送矿车",nTime=292,nClass=14}},col={100,100,255},szContent="诸位兄弟们，这些银钱可壮大我方势力，请与我一道运送回浩气盟！"},
		},
		[444] = {
			{szTarget="落难侠客",tCountdown={{nFrame=6,nIcon=726,key="落难侠客",szName="落难侠客·奖励包裹·出现",nTime=20,nClass=14}},szNote="落难侠客·奖励包裹",szContent="多谢各位仗义相助，在下的伤已经好的差不多了！"},
