			{szContent="顺着阿泥洞口的轨迹，找到阿什利的藏身之处吧！",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="跟随·阿泥·阿泥的痕迹",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·阿泥·沿着峡谷走",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="等待剧情·对话·阿什利",nTime=600,key="奇遇提示3"}}},
			{szContent="前方发生争斗。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="等待·剧情·对话·阿什利",nTime=120,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·伊吾城·东门·车夫",nTime=120,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·宋怀预·对话·阿什利",nTime=120,key="奇遇提示3"}}},
			{tCountdown={{nRefresh=0,key="奇遇提示0",nFrame=0,nIcon=12373,szName="奇遇提示0",nTime="5,恭喜触发·语不休·絮絮;15,奇遇不封印·约10分钟完成",nClass=14},{nIcon=12373,key="奇遇提示1",nFrame=7,szName="前往·敦煌城·左下角·阿巴斯",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="返回·瓜果盘处·对话·说书人",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="前往·敦煌城南门外·对话伊连",nTime=600,nClass=14}},szContent="箭上绑了一封信，打开看看。"},
			{tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="前往·敦煌城·右上角·曹成",nTime=600,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="神行·大地图中偏左·沸沙狱",nTime=600,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="交互·光圈·等待·剧情结束",nTime=600,nClass=14}},szContent="去曹府看看"},
			{tCountdown={{nIcon=12373,key="奇遇提示1",nFrame=7,szName="对话·狱卒·神行·敦煌城",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示2",nFrame=7,szName="返回·敦煌城左下·阿巴斯",nTime=600,nClass=14},{nIcon=12373,key="奇遇提示3",nFrame=7,szName="交互·光圈·等待剧情结束",nTime=600,nClass=14}},szContent="去问问狱卒能否把它带走吧。"},
			{szTarget="阿瓦尔",tCountdown={{nFrame=7,key="奇遇提示1",nIcon=12373,szName="对话·秋山雨·完成奇遇",nTime=60,nClass=14},{nFrame=7,key="奇遇提示2",nIcon=12373,szName="获得·宠物奇遇·语不休",nTime=60,nClass=14},{nFrame=7,key="奇遇提示3",nIcon=12373,szName="获得·宠物·絮絮·鹦鹉",nTime=60,nClass=14}},szContent="我去把那狗鼠辈给砍了！"},
			{szContent="去问问宁清寒该做些什么吧！",tCountdown={{nIcon=12373,nClass=14,nFrame=0,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·故人愿·阿稳;15,奇遇不封印·约15分钟完成",key="奇遇提示0"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·宁清寒·交互·兰花",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·宁清寒·出门右光圈",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="使用·兰花·返回·宁清寒",nTime=600,key="奇遇提示3"},{nIcon=12373,nClass=14,nFrame=7,szName="出门·交互左光圈·宁清寒",nTime=600,key="奇遇提示4"},{nIcon=12373,nClass=14,nFrame=7,szName="出门·直走右拐对话·康荣",nTime=600,key="奇遇提示5"},{nIcon=12373,nClass=14,nFrame=7,szName="返回·宁清寒查看兰花光圈",nTime=600,key="奇遇提示6"}}},
			{szContent="原本放着兰花的地方只剩下水渍和残破的兰花根，好像被什么东西咬了……赶紧找找附近的线索吧！",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="前往·城西南·水池·水豚",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·水豚·返回·宁清寒",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·万花·落星湖·宇晴",nTime=600,key="奇遇提示3"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示4",nTime=-1,key="奇遇提示4"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示5",nTime=-1,key="奇遇提示5"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示6",nTime=-1,key="奇遇提示6"}}},
			{szContent="万花谷最了解花儿的人，或许知道哪里有最适合的兰花。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,bHold=true,szName="前往·万花·落星湖·宇晴",nTime=180,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="返回·宁清寒·对话宁清寒",nTime=180,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="完成·奇遇·故人愿·阿稳",nTime=180,key="奇遇提示3"}}},
			{[14]={bCenterAlarm=true},szContent="啊！这夺目的光辉，这耀眼的锋芒！难道{$me}大侠找到的，就是传说中所向披靡的真·河西飞剑吗！",szTarget="左渊",tCountdown={{nFrame=2,nIcon=2876,szName="获得·真·河西飞剑",nTime=20,nClass=14}},szNote="获得·真·河西飞剑"},
