		[299] = {
			{tCountdown={{nFrame=0,nClass=14,nIcon=12372,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·绝世奇遇·济苍生;15,奇遇至少封印5日;30,前往战乱洛阳·风雨镇·孙妈妈",key="奇遇提示0"}},szNote="济苍生",szContent="似乎有个小男孩在和你说话。"},
