			{szContent="小狗朝你吠叫了两声，奔跑起来，似乎想要你跟上去。",tCountdown={{nFrame=0,nClass=14,nIcon=12373,nRefresh=0,szName="奇遇提示0",nTime="5,恭喜触发·枉叹恨·错错;15,奇遇不封印·约10分钟完成",key="奇遇提示0"},{nFrame=7,nClass=14,nIcon=12373,szName="跟随·错错·交互·光圈",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="打开·背包·使用·盒子",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="前往·茶馆·对话·陈氏",nTime=600,key="奇遇提示3"}}},
			{szContent="去挖出银子的地方看看吧。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="返回·天都镇·对话·行医学徒",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·砍柴人·对话·老妪",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="前往·天都镇·南门·光圈",nTime=600,key="奇遇提示3"}}},
			{szContent="跟上小狗。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="跟随·错错·交互·尸体",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·茶馆·对话·陈氏",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="完成·宠物奇遇·枉叹恨",nTime=600,key="奇遇提示3"}}},
			{szContent="带上和离书去找陈氏吧。",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="返回·茶馆·对话·陈氏",nTime=60,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="完成·宠物奇遇·枉叹恨",nTime=60,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="获得·奇遇·奖励·错错",nTime=60,key="奇遇提示3"}}},
