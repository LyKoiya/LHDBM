			{szTarget="宋旅",szContent="前程皆坦途，何须石问路。",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·宋旅·前往·乾坤港西",nTime=600,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="对话·顽童·QTE·对话顽童",nTime=600,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="返回·宋旅·交互·小龟",nTime=600,key="奇遇提示3"}}},
			{szContent="你在顽童面前露了一手功夫，看得他叫好连连！",tCountdown={{nIcon=12373,nClass=14,nFrame=7,szName="返回·宋旅·交互·小龟",nTime=600,key="奇遇提示1"},{nIcon=12373,nClass=14,nFrame=7,szName="对话·宋旅·前往·海边",nTime=600,key="奇遇提示2"},{nIcon=12373,nClass=14,nFrame=7,szName="交互·小龟·对话·宋旅",nTime=600,key="奇遇提示3"}}},
			{szTarget="小龟",szContent="%#&*！",tCountdown={{nFrame=7,nClass=14,nIcon=12373,szName="对话·宋旅·获得·石小小",nTime=30,key="奇遇提示1"},{nFrame=7,nClass=14,nIcon=12373,szName="完成·宠物·奇遇·路投石",nTime=30,key="奇遇提示2"},{nFrame=7,nClass=14,nIcon=12373,szName="奇遇提示3",nTime=0,key="奇遇提示3"}}},
			{szContent="你记得易珍集那里有个伙房，不如去试试。",tCountdown={{nIcon=13,key="奇遇·滴水恩·提示1",nFrame=7,szName="易珍集·蒋大厨·灶台",nTime=20,nClass=14},{nIcon=13,key="奇遇·滴水恩·提示2",nFrame=7,szName="不要点太快·避免错选5k金",nTime=20.1,nClass=14},{nIcon=13,key="奇遇·滴水恩·提示3",nFrame=7,szName="可直接交互·灶台",nTime=20.1,nClass=14},{nIcon=13,key="奇遇·滴水恩·提示4",nFrame=7,szName="烹饪专精|95级以上·六炉金龙丹",nTime=20.1,nClass=14}}},
