			{tCountdown={{nTime=180,nFrame=3,nClass=14,key="关隘宝箱",szName="恶人谷·拾取·赤岩关·宝堆",nIcon=10450,nRefresh=2},{nTime=-1,nFrame=-1,nClass=14,key="关隘·拾取·恶人谷",szName="关隘·拾取·恶人谷",nIcon=13,nRefresh=1}},szContent="阁下好武艺。",szTarget="穆玄英",col={100,100,255}},
			{tCountdown={{nTime=180,nFrame=3,nClass=14,key="关隘宝箱",szName="恶人谷·拾取·隐樵关·宝堆",nIcon=10450,nRefresh=2},{nTime=-1,nFrame=-1,nClass=14,key="关隘·拾取·恶人谷",szName="关隘·拾取·恶人谷",nIcon=13,nRefresh=1}},szContent="终于出趟谷，不容易呀！寒鸦大人请放心，第一关隘就交给我吧！",szTarget="顾延恶",col={255,100,100}},
			{tCountdown={{nTime=180,nFrame=7,nClass=14,key="关隘宝箱",szName="浩气盟·拾取·隐樵关·宝堆",nIcon=10449,nRefresh=2},{nTime=-1,nFrame=-1,nClass=14,key="关隘·拾取·浩气盟",szName="关隘·拾取·浩气盟",nIcon=13,nRefresh=1}},szContent="待我唤我平安客栈众兄弟们前来支援，哼，暂且后退！",szTarget="顾延恶",col={255,100,100}},
