		[159] = {
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·美酒飘香·备材·开启"}},szContent="请大家稍事休息，老夫这就酿下一桶！",szTarget="蒋方文"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·美酒飘香·酿酒·开启"}},szContent="感谢大家鼎力相助，老夫这就开始用内功催发酒力。不过此处经常会有棕熊前来偷酒，还请各位相助一二。",szTarget="蒋方文"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·美酒飘香·酿酒·结束"}},szContent="哈哈哈！这酒算是成了！感谢各位的鼎力相助，蒋某不胜感激！",szTarget="蒋方文"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·刺客来袭·开启"}},szContent="有刺客！！！保护师父！！",szTarget="郭岩"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·沈眠风之乱·开启"}},szContent="师弟，此处就交于我，你且护着师父师母退后！",szTarget="郭岩"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·沈眠风之乱·结束"}},szContent="我们追！",szTarget="尹放"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·洞庭虹影·开启"}},szContent="各位可以来我这里领取钓竿，然后就在我身边的浅滩上垂钓，莫要走远了。钓到了鱼儿便放入我身边的鱼篓中即可！",szTarget="尹小荷"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·洞庭虹影·斩龟"}},szContent="相传这水中有一只万年巨龟，莫不是惊动了它？真是天助我也，大家齐心斩了这巨龟，将其龟甲献给老帮主定是极好的！",szTarget="尹小荷"},
			{tCountdown={{nTime=5,nFrame=2,nClass=14,key="钓鱼提示",nIcon=2678,szName="快收杆"}},szContent="好像有鱼儿上钩了，快收杆！",[14]={bCenterAlarm=true},szNote="有鱼咬钩"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·郭珠·前往·关帝庙岛"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·龙俊华·前往·龙涎泉"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·洪笑尘·快捷商店·酒"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="赠予·今朝醉·送六炉金龙丹"}},szContent="突然之间，你面前闪过一道黑影！"},
			{tCountdown={{nTime=300,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·面前美酒·等待·剧情"},{nTime=300,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·郭珠·获得鲜美的小鱼"},{nTime=300,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="选中·小鳄鱼投喂鲜美的小鱼"},{nTime=300,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="对话·郭珠·完成奇遇醉烟波"}},szContent="与面前的美酒交互即可饮酒。"},
			{tCountdown={{nTime=30,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·郭珠·完成宠物奇遇"},{nTime=30,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="宠物·奇遇·醉烟波·饿饿"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="奇遇提示4"}},szContent="小鳄鱼一口吃掉了小鱼，看起来很开心。"},
		},
		[243] = {
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件·{$N55356}",nIcon=13,szName="门派事件·{$N55356}·出现"}},szContent="霜林出现了厉害的吊睛白虎，正在狩猎的侠士们可以找到这猛兽一试身手！",szTarget="柳辰苇"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·杀意四伏·结束"}},szContent="你获得了事件【霸刀·杀意四伏】的奖励。"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·机关重重·唐花"}},szContent="可惜尔等管了这不该管的闲事，我便留不得你们了！",szTarget="唐花"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·机关重重·结束"}},szContent="咳咳……",szTarget="唐花"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·星暗长林·重楼子"}},szContent="说甚么胡话！唐家妹子，你且先去！速速将此处情形告知蛇仙！咱尚能抵得一时！",szTarget="重楼子"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件3·星暗长林·结束"}},szContent="咳咳……",szTarget="重楼子"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·蛇魅狼影·蛇仙女"}},szContent="哎呀哎呀，将军不要那么凶嘛。",szTarget="蛇仙女"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·蛇魅狼影·结束"}},szContent="哎呀哎呀，原来是夫人来了。",szTarget="蛇仙女"},
			{tCountdown={{nTime="5,恭喜触发·太行道·阳阳;15,奇遇封印65分钟·约80分钟完成;30,需提前准备·商道全套书籍;60,帮会领地·帮会书童·可购买;90,额外交付商道第三章;120,奖励五级五行石x3",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nRefresh=0,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·边澈·前往·太极镇南"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·掌柜的·返回·边澈"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="准备·商道全套书·帮会书童"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",bHold=true,nIcon=12373,szName="返回·边澈·对话·掌柜的"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示5",bHold=true,nIcon=12373,szName="对话·边澈·前往太原东山矿场"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示6",bHold=true,nIcon=12373,szName="对话·边澈·前往牛廷阶营寨北"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示7",bHold=true,nIcon=12373,szName="寻找·被抢夺矿石箱·返回边澈"}},szContent="霸刀弟子边澈好像有话对你说。"},
