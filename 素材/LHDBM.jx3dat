			{col={255,100,100},tCountdown={{nTime=347,nFrame=3,nClass=14,key="通用·矿车",nIcon=13,szName="恶人·护送矿车"}},szContent="老伙计们！这一车可得小心点，这路上可有不少浩气盟的探子，有劲的一会使出来！",szTarget="纪平",szNote="恶人·出车"},
