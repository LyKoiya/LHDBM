			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·荡除心魔·东瀛的自傲"}},szContent="好个金刚伏魔阵！可能及我万一！",szTarget="东瀛的自傲"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·东瀛的自傲·结束"}},szContent="不！",szTarget="东瀛的自傲"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·荡除心魔·武士的尊严"}},szContent="笑话，心境澄明之人世间又有几个！",szTarget="武士的尊严"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·武士的尊严·结束"}},szContent="这怎么可能！",szTarget="武士的尊严"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件4",nIcon=13,szName="门派事件4·荡除心魔·一刀流的荣耀"}},szContent="一刀流岂是尔等所能企及！",szTarget="一刀流的荣耀"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件4",nIcon=13,szName="门派事件4·一刀流的荣耀·结束"}},szContent="就这么......结束了么......",szTarget="一刀流的荣耀"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件5",nIcon=13,szName="门派事件5·荡除心魔·禅武的执念"}},szContent="论禅论武，我都绝对不会输！",szTarget="禅武的执念"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件5",nIcon=13,szName="门派事件5·禅武的执念·结束"}},szContent="一念......放下......",szTarget="禅武的执念"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·道知·后方田里·清礼"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·齐华村·采集·青菜*3"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·清礼·屋檐对话·蒋瀚"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="对话·慧毅·田里对话·清礼"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="前往·院外西北·对话·慧博"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示6",nIcon=12373,szName="返回·清礼·伙房后用·薪柴"}},szContent="少林寺伙房弟子道知似是有话要对你说。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·慧博·返回·清礼"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="返回·慧博·返回·清礼"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="等待·剧情·获得·饭盒"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="奇遇提示4"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="奇遇提示5"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示6",nIcon=12373,szName="奇遇提示6"}},szContent="你已点燃了木柴，快去请慧博师伯吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·长老·品尝·斋饭"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="澄通·澄信·澄正·澄理"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·清礼·等待·剧情"}},szContent="哼，我也接着回屋顶晒太阳。",szTarget="蒋瀚"},
			{tCountdown={{nTime=20,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="完成奇遇·烹调法·将军客"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="清礼这孩子聪明伶俐，只是年纪尚幼缺些磨砺。麻烦了施主这么久，小僧这里道谢了。阿弥陀佛！至于这只小蟹，留在我少林寺伙房也多有不便，它亦是施主相助所救，皆为缘法！不如便交由施主保管吧！阿弥陀佛！",szTarget="慧博"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·查小娘·斜后草垛·貉"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·闰水·返回·查小娘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·桥边树下·对话·闰水"}},szContent="查小娘似乎有话想对你说。"},
			{tCountdown={{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·查小娘·完成奇遇"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="查小娘来了，她和闰水似乎彼此认识，去问问查小娘怎么回事吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·闰水·后方山坡·水豚"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·齐华村·对话·查小娘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·闰水·前往·桥边树下"}},szContent="闰水似乎有话想对你说。"},
			{tCountdown={{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·闰水·完成奇遇"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="闰水来了，他和查姑娘似乎彼此认识，去问问闰水怎么回事吧。"},
		},
		[6] = {
			{tCountdown={{nTime=5,nFrame=4,nClass=14,key="狮王争霸战",nIcon=22,szName="狮王争霸战·已经结束"}},szContent="本次狮王争霸战已结束。各位勇士大可勤加苦练，下次卷土重来。",szTarget="陈昊"},
			{tCountdown={{nTime=30,nFrame=4,nClass=14,key="狮王争霸战",nIcon=22,szName="狮王争霸战·结束剩余"}},szContent="本次狮王争霸战还有30秒结束，各位勇士可要加把劲了！",szTarget="陈昊"},
			{tCountdown={{nTime=20,nFrame=4,nClass=14,key="狮王争霸战",nIcon=22,szName="狮王争霸战·开启"}},szContent="狮王争霸，能者独尊！陌路英雄八方临，以武会友天下名。十年苦修寒暑意，鱼跃龙门气冲庭！现在，狮王争霸战正式开始！大家准备！",szTarget="陈昊"},
			{tCountdown={{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·沈云鸢·前往·杂货区"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="对话·钱万和·前往·技艺区"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="对话·沈云鸢·交互·小鹿摇"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12371,szName="码头·对话沈云鸢·食肆当家"}},szContent="给钱！",szTarget="沈云鸢"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",szName="返回·枫叶泊·1号宅邸·桥头",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",szName="使用·鸟笼·跟随·小寿带鸟",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",szName="前往·3号宅邸方向·大树下",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",szName="交互·小寿带鸟·完成奇遇",nIcon=12373,bHold=true}},szContent="返回枫叶泊放飞这只鸟儿吧。"},
			{tCountdown={{nTime="5,恭喜触发·江湖录·香香;15,奇遇不封印·约3分钟完成",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·几页书稿·对话·苏拂衣"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·再来镇南边·对话·老仆"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="完成·宠物奇遇·江湖录·小羽"}},szContent="小羽听到你的哨声飞了回来，还叼回了几页书稿，掉落在地上。"},
			{tCountdown={{nTime="5,恭喜触发·谜书生·小苗苗;15,奇遇不封印·约5分钟完成;40,1.交互带血的金钗·跟随血迹;60,2.前往西南树下·对话谢长安;120,3.前往再来镇药店·交易冯德;180,4.购买上品止血散·返回荀鸢;210,5.前往冯德身后·对话药店掌柜;240,6.前往武器商人·对话谢长安;270,7.前往萧白胭附近·对话荀鸢;300,8.前往扬州码头·对话荀鸢;320,完成奇遇·谜书生·小苗苗",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·带血的金钗·跟随·血迹"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·西南树下·对话·谢长安"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·再来镇药店·交易·冯德"}},szContent="这只毛丝鼠身上好像掉落了一支金钗。"},
			{tCountdown={{nTime="20,2.前往西南树下·对话谢长安;80,3.前往再来镇药店·交易冯德;140,4.购买上品止血散·返回荀鸢;170,5.前往冯德身后·对话药店掌柜;200,6.前往武器商人·对话谢长安;230,7.前往萧白胭附近·对话荀鸢;260,8.前往扬州码头·对话荀鸢;280,完成奇遇·谜书生·小苗苗",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·西南树下·对话·谢长安"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·再来镇药店·交易·冯德"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="购买·上品止血散·返回·荀鸢"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="前往·冯德身后·对话药店掌柜"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="前往·武器商人·对话·谢长安"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示6",nIcon=12373,szName="前往·萧白胭附近·对话·荀鸢"}},szContent="这金钗上带着血迹，地上也有……顺着血迹去看看发生了什么吧。"},
			{tCountdown={{nTime="30,8.前往扬州码头·对话荀鸢;50,完成奇遇·谜书生·小苗苗",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·扬州码头·对话·荀鸢"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="完成·奇遇·谜书生·小苗苗"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="奇遇提示4"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="奇遇提示5"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示6",nIcon=12373,szName="奇遇提示6"}},szContent="现在去扬州码头送别荀鸢姑娘吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·罗岩成·对话·大怪鼠"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="击败·大怪鼠·对话·罗岩成"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="对话·大怪鼠·完成·拜春擂"}},szContent="不走是吧？！小五、小六，拿家伙什儿来，把它架走！",szTarget="罗岩成"},
			{tCountdown={{nTime=30,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·罗岩成·对话·大怪鼠"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="奇遇提示3"}},szContent="那个……鹿鼠兄？你输了，可以下场了。",szTarget="罗岩成"},
			{tCountdown={{nTime=300,nFrame=6,nClass=14,key="奇遇提示2",szName="再次对话·赤兔",nIcon=12371,bHold=true},{nTime=300,nFrame=6,nClass=14,key="奇遇提示3",szName="对话完成·回到家园·裴草",nIcon=12371,bHold=true}},szContent="小浮云你刚才找我了吗？",szTarget="赤兔",szNote="白日梦"},
			{tCountdown={{nTime=300,nFrame=7,nClass=14,key="奇遇提示3",szName="马商附近·使用·游梦仙枕",nIcon=12371,bHold=true}},szContent="还未到达指定地点！",szNote="白日梦"},
			{tCountdown={{szName="奇遇提示0",nTime="30,4.前往·藏剑·虎跑山庄·卿重;60,5.返回·七秀·卢蓉;90,6.返回·藏剑·卿重;100,完成奇遇·烟花戏·秋·瑞瑞",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,bHold=true},{nTime=300,nFrame=7,nClass=14,bHold=true,szName="前往·藏剑·虎跑山庄·卿重",nIcon=12373,key="奇遇提示1"},{nTime=300,nFrame=7,nClass=14,bHold=true,szName="返回·七秀·卢蓉",nIcon=12373,key="奇遇提示2"},{nTime=300,nFrame=7,nClass=14,bHold=true,szName="返回·藏剑·卿重",nIcon=12373,key="奇遇提示3"}},szContent="你发现了卿重的玉佩。"},
			{tCountdown={{nTime="10,蹲宠·蟹马·蓝·已捕获;20,蟹马·蓝·CD·3-4小时",nFrame=7,nClass=14,key="蹲宠提示2",szName="蹲宠提示0",nRefresh=0,nIcon=6989}},szContent="不知道是谁丢失的《象棋谱·凡仙局下部》，已被好心侠士带走。",szTarget="神秘人",szNote="蹲宠·蟹马·蓝·已被捕获"},
			{tCountdown={{nTime="10,蹲宠·蟹卒·已捕获;20,蟹卒·CD·1.5-2小时",nFrame=7,nClass=14,key="蹲宠提示1",szName="蹲宠提示0",nRefresh=0,nIcon=6111}},szContent="我要去找螃蟹了，回头再见吧。",szTarget="横小五",szNote="蹲宠·蟹卒·已被捕获"},
			{tCountdown={{nTime="10,蹲宠·蟹卒·已捕获;20,蟹卒·CD·1.5-2小时",nFrame=7,nClass=14,key="蹲宠提示1",szName="蹲宠提示0",nRefresh=0,nIcon=6111}},szContent="蟹卒已被好心侠士带走照顾。",szNote="蹲宠·蟹卒·已被捕获",szTarget="神秘人"},
			{tCountdown={{nTime="10,蹲宠·大哈·已捕获;20,大哈·CD·1小时",nFrame=7,nClass=14,key="蹲宠提示0",szName="蹲宠提示0",nRefresh=0,nIcon=6100}},szContent="大哈已被好心侠士带走。",szNote="蹲宠·大哈·已被捕获",szTarget="神秘人"},
			{tCountdown={{nTime=20,nFrame=0,nClass=14,key="奇遇·攻略1",nIcon=13,szName="金水镇·成步堂"}},szContent="赶紧将听到的消息转述给成步堂吧。"},
			{tCountdown={{nTime=30,nFrame=4,nClass=14,key="{$2}·{$4}",nIcon=3140,nRefresh=2,szName="{$3}·{$2}·[{$1}/{$4}]"},{nTime=-2,nClass=14,key="{$2}·0",nIcon=13,szName="{$2}·0"},{nTime=30,nFrame=2,nClass=14,key="{$2}·{$4}",nIcon=3140,nRefresh=1,szName="{$3}·{$2}·已达上限"}},szContent="本次活动获得(%d-)份(.-)，今年(.-)还可通过活动获得(%d-)份(.-)。",bReg=true},
