		[150] = {
			{tCountdown={{nTime=60,nFrame=6,nClass=14,key="任务提示1",nIcon=13,szName="对话·赫连别月·前往地图左下角"}},szContent="老伯似乎还有事相求。"},
			{tCountdown={{nTime=60,nFrame=6,nClass=14,key="任务提示1",nIcon=13,szName="返回·赫连别月·家里·继续对话"}},szContent="老伯似乎心神不宁，回家里陪他一下吧。"},
			{tCountdown={{nTime=20,nFrame=6,nClass=14,key="任务提示1",nIcon=13,szName="等等看·赫连鹰扬·是否回家"}},szContent="谢谢你吉言。",szTarget="赫连别月"},
			{tCountdown={{nTime=10,nFrame=6,nClass=14,key="任务提示1",nIcon=13,szName="赫连鹰扬·回家了"}},szContent="我，回来了。",szTarget="赫连鹰扬"},
			{tCountdown={{nTime=20,nClass=14,key="雪雪·旅行介绍1",nRefresh=15,nIcon=293,szName="三生树找·NPC波斯猫"},{nTime=20,nClass=14,key="雪雪·旅行介绍2",nRefresh=15,nIcon=293,szName="三生树东北找·两只贴贴的骆驼"}},szContent="一起去哪玩？",szTarget="雪雪"},
			{tCountdown={{nTime=20,nFrame=0,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·圣墓山·明尊大典·祈"}},szContent="如此，我们就同心相祈，大会这便开始。",szTarget="陆烟儿"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·圣墓山·宫觥"}},szContent="杀掉那些中原人！！",szTarget="宫觥"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·宫觥·结束"}},szContent="恐怕今日来的只是红衣教先遣教徒，明日还会有一场大战。",szTarget="丁君"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·三生树·血染红衣"}},szContent="果然不出所料，红衣教昨日只是派出刺客先行，捣乱祈愿大会。",szTarget="陆烟儿"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·血染红衣·结束"}},szContent="红衣教徒已尽数消灭，多谢各位侠士仗义援手！",szTarget="陆烟儿"},
		},
		[151] = {
			{tCountdown={{nTime=102,nFrame=3,nClass=14,key="公共事件2",nIcon=13,szName="曹炎烈·激活剩余"}},szContent="来者可是藏剑的叶凡叶五少爷？果然大家之子，气度不凡。叶家五少真是名不虚传啊。",szTarget="曹炎烈"},
			{tCountdown={{nTime=300,nFrame=3,nClass=14,key="公共事件2",nIcon=13,szName="曹炎烈·免死剩余"}},szContent="可惜可惜！",szTarget="曹炎烈"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="公共事件2",nIcon=13,szName="曹炎烈·已击退"}},szContent="你已招架不住，还不束手就擒？",szTarget="叶凡"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="公共事件1",nIcon=13,szName="公共事件1·护卫除追兵·结束"}},szContent="多谢诸位侠士护送，我们在此稍作整顿即可自行前往目的地了。",szTarget="藏剑弟子"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="公共事件1",nIcon=13,szName="公共事件1·护卫除追兵·结束"}},szContent="多谢诸位侠士护送，我们在此稍作整顿即可自行前往目的地了。",szTarget="高级藏剑弟子"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="公共事件1",nIcon=13,szName="公共事件1·护卫除追兵·结束"}},szContent="你获得了事件【护送除追兵】的奖励。"},
			{tCountdown={{nTime=0,nFrame=0,nClass=14,key="茶馆成就",nIcon=13,szName="成就·心慈手软·放走妇人"}},szContent="多谢大侠饶命！多谢大侠饶命！",szTarget="求助的流民"},
			{tCountdown={{nTime=15.3,nFrame=0,nClass=14,key="茶馆成就",nIcon=13,szName="成就·心慈手软·放走妇人"}},szContent="啊……",szTarget="求助的流民"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="洛阳·战乱·洛阳城门"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="茶馆附近·对话·神秘人"}},szContent="茶馆这么多人，要找谁打听呢……",szTarget="阎规"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="依次对话·阎规·鲁小兔"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="结束对话后前往山顶结拜"}},szContent="你的朋友已经先过去了。",szTarget="神秘人"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="背对神秘人·走台阶·佛塔"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="再次对话·鲁小兔·QTE"}},szContent="东西我都准备妥当就差人了，快跟我来山顶。",szTarget="鲁小兔"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="结束QTE·再次对话·鲁小兔"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="奇遇封印·次日7时"}},szContent="咕噜…",szTarget="阎规"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="棚子后面小山丘·山谷中间"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="对话·鲁小兔·QTE"}},szContent="我在山下的小山谷当大侠，快来~",szTarget="鲁小兔"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="再次对话·鲁小兔"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="奇遇封印·次日7时"}},szContent="举手之劳，何足挂齿！日后你再被人劫道，报本女侠的大名就好！",szTarget="鲁小兔"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="棚子后面小山丘·下方"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="对话·鲁小兔·QTE"}},szContent="擂台就在山下，跟我来。",szTarget="鲁小兔"},
			{tCountdown={{bHold=true,nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12372,nRefresh=600,szName="佛塔·右后方"},{bHold=true,nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12372,nRefresh=600,szName="对话·鲁小兔·使用包裹"}},szContent="我选的山头在这边，跟我来。",szTarget="鲁小兔"},
			{tCountdown={{nTime=-2,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="奇遇提示2"},{nTime=-2,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="奇遇提示3"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12372,szName="再次对话·鲁小兔"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12372,szName="随后对话·阎规"}},szContent="嗯嗯不错不错，江湖儿女鲁小兔今日就正式退出江湖啦~",szTarget="鲁小兔"},
			{tCountdown={{bHold=true,nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12372,nRefresh=600,szName="对话·阎规"},{bHold=true,nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12372,nRefresh=600,szName="次日7时·再来此处"}},szContent="鲁小兔的两位结拜好兄弟，今日就到此处吧，两位明日来此墓前，小兔有要事相托。",szTarget="鲁小兔"},
			{tCountdown={{nTime="10,蹲宠·阿里·已捕获;20,奇怪的包袱·CD·2-3小时",nFrame=7,nClass=14,key="蹲宠提示0",szName="蹲宠提示0",nIcon=1898,nRefresh=0}},szContent="奇怪的包袱中的段氏腰牌已被好心侠士带走。",szTarget="神秘人",szNote="蹲宠·阿里·已被捕获"},
			{tCountdown={{nTime=0,nClass=14,key="任务提示1",nIcon=13,szName="任务提示1"}},szContent="我不怕，娘说那些狼不会咬我！",szTarget="苏恨林",szNote="隐藏任务"},
