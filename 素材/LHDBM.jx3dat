			{tCountdown={{nTime="751,柴钗·采货剩余;760,柴钗·即将归来;856,柴钗·休息剩余;865,柴钗·休息结束",nFrame=7,nClass=14,key="柴钗采货",szName="柴钗",nIcon=13,nRefresh=0}},szContent="小红，我要出门啦！外面太冷了你就乖乖在这里等我回来哦！",szTarget="柴钗"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="特产提示",szName="盐雁·特产总管·缺货",nIcon=13,nRefresh=900}},szContent="土特产，土特殊，你们这特产是真的很土……已经卖光？那我岂不是失去了土的机会？",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="特产提示",szName="盐雁·特产总管·缺货",nIcon=13,nRefresh=900}},szContent="家里还嘱咐我买点特产回去，结果竟然没有了？",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="药材提示",szName="苦酷·药材总管·缺货",nIcon=13,nRefresh=900}},szContent="竟然连药包都没有？这儿是不是快要倒闭了啊……",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="药材提示",szName="苦酷·药材总管·缺货",nIcon=13,nRefresh=900}},szContent="卖光了？！你们真的很不会做生意诶，我这样的人来买药包，是难得的好吗？！",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="药材提示",szName="苦酷·药材总管·缺货",nIcon=13,nRefresh=900}},szContent="哎……没有药包就算了吧，想花银子都花不出去。",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="药材提示",szName="苦酷·药材总管·缺货",nIcon=13,nRefresh=900}},szContent="汤药都没有你们还想不想做生意了？！",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="衣饰提示",szName="酸狻·衣饰总管·缺货",nIcon=13,nRefresh=900}},szContent="你们这毫无设计感的衣服都能卖光？世间之大，无奇不有，绝了。",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="茶水提示",szName="茶姹·茶水总管·缺货",nIcon=13,nRefresh=900}},szContent="连水都没有？！啊，我缺水了，有没有人给我浇浇水啊……",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="茶水提示",szName="茶姹·茶水总管·缺货",nIcon=13,nRefresh=900}},szContent="没水喝吗？要渴死了！",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="酒水提示",szName="醋簇·酒水总管·缺货",nIcon=13,nRefresh=900}},szContent="来两斤不掺水的好酒？啥？酒卖光了？行吧，你开心就好，再见吧。",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="酒水提示",szName="醋簇·酒水总管·缺货",nIcon=13,nRefresh=900}},szContent="酒都没有，真无趣。",szTarget="游客"},
			{tCountdown={{nTime=10,nFrame=4,nClass=14,key="厨房提示",szName="辛杏·厨房小吃·缺货",nIcon=13,nRefresh=900}},szContent="没吃的了吗？好饿啊。",szTarget="游客"},
