			{tCountdown={{nTime="30,7.对话龙俊华·等待剧情;90,8.对话龙俊华·前往车夫北面溪水;120,9.交互光圈·交互鸟笼;150,10.对话龙俊华·对话槲生;170,完成奇遇·故岁辞·岁岁",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·龙俊华·等待·剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="出门·龙俊华·交互·光圈"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="光圈·车夫北面溪水·附近"}},szContent="何人在此鬼鬼祟祟！",szTarget="龙俊华"},
			{tCountdown={{nTime="30,8.对话龙俊华·前往车夫北面溪水;90,9.交互光圈·交互鸟笼;120,10.对话龙俊华·对话槲生;140,完成奇遇·故岁辞·岁岁",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="光圈·车夫北面溪水·附近"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="交互·鸟笼·对话·龙俊华"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·槲生·完成·故岁辞"}},szContent="爹娘也不会乐意我执着于仇恨的，那太傻了，人还是活的洒脱点好。",szTarget="龙俊华"},
			{tCountdown={{nTime=0,nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,szName="奇遇提示0"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·鸟笼·对话·龙俊华"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·槲生·完成·故岁辞"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="这么多东西居然只有这几个人护送，也真够心大的。我不擅长匿形，把他们都打一顿算了，我来牵制看守，你去释放鸟兽？",szTarget="龙俊华"},
			{tCountdown={{nTime="5,恭喜触发·侠者成歌;15,奇遇不封印·约10分钟完成;30,1.对话封演·前往晟江茶馆;120,2.对话纪小橙·前往兴威寨;150,3.靠近司空淮·攻击喽啰;160,4.对话司空淮·前往白菰里;210,5.名望区域信使旁·寻找苏舒;240,6.进入光圈·对话苏舒;420,7.对话苏舒·等待剧情;450,8.返回黄槲镇·对话封演;470,完成奇遇·侠者成歌",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12371},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·纪小橙·前往·兴威寨"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="靠近·司空淮·攻击·喽啰"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="对话·司空淮·前往·白菰里"}},szContent="此后我也到了差不多能收个徒弟的年纪，虽然没有名气响亮的门派，我自己也没有厉害的称号，但我运气可好了，收到了一大堆不嫌弃我的徒弟。",szTarget="纪小橙"},
			{tCountdown={{nTime="10,4.对话司空淮·前往白菰里;60,5.名望区域信使旁·寻找苏舒;90,6.进入光圈·对话苏舒;270,7.对话苏舒·等待剧情;300,8.返回黄槲镇·对话封演;320,完成奇遇·侠者成歌",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12371},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·司空淮·前往·白菰里"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="寻找·苏舒·名望区域信使旁"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="进入·光圈·对话·苏舒"}},szContent="打不过！快跑！",szTarget="喽啰"},
			{tCountdown={{nTime="30,6.进入光圈·对话苏舒;210,7.对话苏舒·等待剧情;240,8.返回黄槲镇·对话封演;260,完成奇遇·侠者成歌",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12371},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="对话·苏舒·等待剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="返回·黄槲镇·封演"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="完成·奇遇·侠者成歌"}},szContent="哎……别提了……",szTarget="苏舒"},
			{tCountdown={{nTime="30,8.返回黄槲镇·对话封演;50,完成奇遇·侠者成歌",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12371},{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12371,szName="返回·黄槲镇·封演"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12371,szName="完成·奇遇·侠者成歌"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12371,szName="奇遇提示3"}},szContent="将收集到的三个故事交给封演。"},
		},
		[215] = {
			{tCountdown={{nTime="5,恭喜触发·胜负局·螃胜螃负;10,宠物奖励·螃胜螃负·需要驯养;15,奇遇封印3日·每日约5分钟完成;30,1.对话·航小婷;90,2.前往·隐贤居·封博安;120,3.对话·封博安;150,4.交互·棋盘;180,5.对话·云定风;210,6.对话·封博安;220,第一日·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·航小婷·隐贤居·封博安"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·封博安·交互·棋盘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·云定风·对话·封博安"}},szContent="你很厉害，不过不知道象棋是不是也厉害呢？",szTarget="航小婷"},
			{tCountdown={{nTime="30,4.交互·棋盘;60,5.对话·云定风;90,6.对话·封博安;100,第一日·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·棋盘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·云定风"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·封博安"}},szContent="开局。",szTarget="封博安"},
			{tCountdown={{nTime="30,5.对话·云定风;60,6.对话·封博安;70,第一日·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·云定风"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·封博安"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="为兄惭愧……但永王恳切，云兄何不考虑考虑？",szTarget="封博安"},
			{tCountdown={{nTime=0,nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,szName="奇遇提示0"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·封博安·第一日·结束"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="第二日·前往·隐贤居"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="第二日·交互·棋局"}},szContent="哎，云兄，若我们能共享富贵，何必下棋争这一壶浊酒呢？",szTarget="封博安"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·封博安·贺城·封博安"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·封博安·对话·邢簿征"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·云定风·对话·邢簿征"}},szContent="局中棋势策略均无破绽，为何有……",szTarget="封博安"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·邢簿征·前往·贺城东"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·云定风·获得·流云局"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·邢簿征·结束·第二日"}},szContent="这……容我三思……",szTarget="封博安"},
			{tCountdown={{nTime=20,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="第二日·结束·明日七时·解封"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="第三日·前往·贺城东南·亭子"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="第三日·对话·封博安·封博安"}},szContent="封先生，这位侠士为云定风带话，明天棋局改在城外草亭。",szTarget="邢簿征"},
			{tCountdown={{nTime=300,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·封博安·等待·剧情"},{nTime=300,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·封博安·等待·剧情"}},szContent="云兄，你来了。",szTarget="封博安"},
			{tCountdown={{nTime=20,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·封博安·完成奇遇"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="获得·蟹胜蟹负·需驯养"}},szContent="哈哈，看来日后我想赢酒，又要难了。",szTarget="云定风"},
			{tCountdown={{nTime="5,恭喜触发·风雨意·迟迟;15,奇遇不封印·约15分钟完成;120,1.对话·刘安·钱滚滚·刘安;150,2.前往龙泉府·宁晚镇·冯六;180,3.对话刘平·交互·一桌酒席;210,4.等待剧情·交互·书信;230,5.前往·千岛湖·贺城;270,6.使用·有些发旧的地图;300,7.对话刘平·获得易容丸;310,8.使用·有些发旧的地图;360,9.前往光圈点·嗷呜附近;450,10.使用易容丸·等待剧情;460,11.使用·有些发旧的地图;560,12.对话刘平·紧紧跟随刘平;570,13.使用·有些发旧的地图;630,14.前往车夫附近·对话刘平;650,15.前往龙泉府·白霜谷刘平;680,16.使用·有些发旧的地图;720,17.对话·白霜谷·刘平;750,18.返回千岛湖·小岛刘安;780,完成奇遇·风雨意·迟迟",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·刘安·钱滚滚·刘安"},{nTime=600,nFrame=7,nClass=14,bHold=true,szName="前往·龙泉府·宁晚镇·冯六",nIcon=12373,key="奇遇提示2"},{nTime=600,nFrame=7,nClass=14,bHold=true,szName="对话·刘平·交互·一桌酒席",nIcon=12373,key="奇遇提示3"}},szContent="你可收好啦，这封信！",szTarget="曙曙"},
			{tCountdown={{nTime="50,9.前往光圈点·嗷呜附近;140,10.使用易容丸·等待剧情;150,11.使用·有些发旧的地图;250,12.对话刘平·紧紧跟随刘平;260,13.使用·有些发旧的地图;320,14.前往车夫附近·对话刘平;340,15.前往龙泉府·白霜谷刘平;370,16.使用·有些发旧的地图;410,17.对话·白霜谷·刘平;440,18.返回千岛湖·小岛刘安;470,完成奇遇·风雨意·迟迟",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·光圈点·嗷呜·附近"},{nTime=600,nFrame=7,nClass=14,szName="使用·易容丸·等待·剧情",nIcon=12373,key="奇遇提示2"},{nTime=600,nFrame=7,nClass=14,szName="使用·有些发旧的地图",nIcon=12373,key="奇遇提示3"},{nTime=0,nFrame=7,nClass=14,szName="奇遇提示4",nIcon=12373,key="奇遇提示4"}},szContent="原来是在那里。"},
			{tCountdown={{nTime="50,9.前往光圈点·嗷呜附近;140,10.使用易容丸·等待剧情;150,11.使用·有些发旧的地图;250,12.对话刘平·紧紧跟随刘平;260,13.使用·有些发旧的地图;320,14.前往车夫附近·对话刘平;340,15.前往龙泉府·白霜谷刘平;370,16.使用·有些发旧的地图;410,17.对话·白霜谷·刘平;440,18.返回千岛湖·小岛刘安;470,完成奇遇·风雨意·迟迟",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·光圈点·嗷呜·附近"},{nTime=600,nFrame=7,nClass=14,szName="使用·易容丸·等待·剧情",nIcon=12373,key="奇遇提示2"},{nTime=600,nFrame=7,nClass=14,szName="使用·有些发旧的地图",nIcon=12373,key="奇遇提示3"},{nTime=0,nFrame=7,nClass=14,szName="奇遇提示4",nIcon=12373,key="奇遇提示4"}},szContent="可打开地图探查学堂位置。"},
