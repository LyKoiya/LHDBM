			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·修复机甲·结束"}},szContent="无乐，我方制造的机甲已成型，你可莫要逃了。",szTarget="唐无寻"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·唐家堡·机甲对决"}},szContent="呵呵，大言不惭。胜负成败，就看此一战。上吧！",szTarget="唐无寻"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·机甲对决·结束"}},szContent="竟是输你一成……没想到大哥你的机甲制造术又精进不少。",szTarget="唐无乐"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·唐家堡·对抗狼牙"}},szContent="哼！诸位侠士请助我们护住机甲。",szTarget="唐无寻"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·对抗狼牙·御敌·结束"}},szContent="好！多亏诸位侠士相助，机甲已经休整完毕，狼牙的末日到了！",szTarget="唐无乐"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件1·唐家堡·对抗狼牙·斩首"}},szContent="看看是谁在说大话！",szTarget="跋野古寒"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2·提示",nIcon=13,szName="机甲自爆·远离"}},szContent="诸位侠士当心！机甲将会在十秒后自爆，唐门所属！准备撤！",szTarget="唐无寻"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·对抗狼牙斩首·结束"}},szContent="啊，我不甘心啊。",szTarget="跋野古寒"},
			{tCountdown={{nTime="5,恭喜触发·龟影锋·小师父;15,奇遇不封印·约15分钟完成",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",szName="对话·唐素娘·前往·饮露峡",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",szName="对话·唐幺曲·沿水流方向走",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",szName="对话·唐幺曲·等待剧情结束",nIcon=12373}},szContent="唐素娘似乎遇到了难事，不妨询问一二。",szNote="触发·宠物奇遇·龟影锋·小师父"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",szName="对话·唐幺曲·交互·草丛",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",szName="交互·石头·对话·唐幺曲",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",szName="前往·三岔路口·触发剧情",nIcon=12373}},szContent="陆龟依旧埋于龟壳内，直至狐狸松懈回身，陆龟骤然探头，迅疾闪避。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",szName="对话·唐门侍女·对话·唐幺曲",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",szName="返回·唐家集·对话·唐素娘",nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",szName="完成·宠物奇遇·龟影锋小师父",nIcon=12373}},szContent="身旁的唐门侍女，站姿沉稳，不疾不徐地开口替你们解围。"},
			{tCountdown={{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",szName="返回·唐家集·对话·唐素娘",nIcon=12373},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",szName="完成·奇遇·龟影锋·小师父",nIcon=12373},{nTime=-1,nFrame=7,nClass=14,key="奇遇提示3",szName="奇遇提示3",nIcon=12373}},szContent="送唐幺曲回唐家集食摊。",szNote="完成·宠物奇遇·龟影锋·小师父"},
			{tCountdown={{nTime="5,恭喜触发·烟花戏·风·鸿鸿;15,奇遇不封印·约5分钟完成",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·唐御御·前往·紫树下"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="拾取·竹叶青·返回·唐御御"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·嘉陵江水井·交互土堆"}},szContent="女侠，今夜月色正好，你我相逢也是有缘，何不把酒一叙？",szTarget="唐御御"},
			{tCountdown={{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·小狗·返回·唐御御"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·唐御御·释放·烟花"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="完成·烟花戏·获得·鸿鸿"}},szContent="一只小狗跑了过来，试图阻止你继续翻找。"},
