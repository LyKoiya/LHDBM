		[7] = {
			{tCountdown={{nTime=20,nClass=14,key="雪雪·旅行介绍3",nRefresh=15,nIcon=293,szName="太极广场东南·亭子·触发命途"}},szContent="我们去旁边那个亭子看看嘛。",szTarget="雪雪"},
			{tCountdown={{nTime=20,nClass=14,key="雪雪·旅行介绍1",nRefresh=15,nIcon=293,szName="太极广场·于睿"},{nTime=20,nClass=14,key="雪雪·旅行介绍2",nRefresh=15,nIcon=293,szName="太极广场东南·亭子·触发命途"}},szContent="一起去哪玩？",[14]={bTeamChannel=true},szTarget="雪雪"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·西昇大典·结束"}},szContent="多谢诸位侠士，我和二位师弟先行回大殿议事。",szTarget="李忘生"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·地图标记·攻击BOSS"}},szContent="各位侠士请帮我们灭掉星宿据点！",szTarget="于睿"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·千秋子·刷新"}},szContent="区区星野剑阵，不过浪得虚名，如何能与我星宿派武侯移星术相比？",szTarget="千秋子"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·千秋子·已刷新"}},szContent="我修习上古毒经与武侯移星术，今已大成，你们尽管一起上吧！哈哈哈哈！",szTarget="千秋子"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·地图标记·攻击BOSS"}},szContent="此等恶人不除不快，诸位侠士，还请助我纯阳守护剑阵，灭了此人威风！",szTarget="卓凤鸣"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·星野剑阵·结束"}},szContent="多谢各位侠士仗义出手。",szTarget="李忘生"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",szName="门派事件1·星野剑阵·天玑剑",nIcon=13,nRefresh=300}},szContent="各位侠士需以自身精气养之，才可触发天玑剑气。",szTarget="李忘生"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",szName="门派事件1·星野剑阵·玉衡剑",nIcon=13,nRefresh=300}},szContent="有劳各位侠士将吾身后剑匣中剑置于玉衡剑阵眼旁，让玉衡剑吸收其中罡气。",szTarget="李忘生"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",szName="门派事件1·星野剑阵·摇光剑",nIcon=13,nRefresh=300}},szContent="还请诸位侠士相助，取三清符，然后到至高处汲取天地元气，并贴于摇光剑身，以激活摇光剑气。",szTarget="李忘生"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·山门卫道·结束"}},szContent="多谢各位侠士！下一批物资将会在稍后运送！",szTarget="祁进"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·山门卫道·太极广场"}},szContent="我纯阳宫运送西昇祭的物资车在往太极广场的路上，麻烦各位侠士前往护送！",szTarget="祁进"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·山门卫道·老君宫"}},szContent="我纯阳宫运送西昇祭的物资车应该在往老君宫的路上，麻烦各位侠士前往护送！",szTarget="祁进"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·山门卫道·纯阳宫正门"}},szContent="我纯阳宫运送西昇祭的物资车应该在往纯阳宫正门的路上，麻烦各位侠士前往护送！",szTarget="祁进"},
			{tCountdown={{nTime=2,nFrame=3,nClass=14,key="门派事件1",szName="门派事件·山门卫道·拾取物资",nIcon=13,nRefresh=120}},szContent="不好！马车受了惊吓，劳烦各位侠士帮我们拾取掉落在地上的物资！",szTarget="纯阳弟子"},
			{tCountdown={{key="奇遇提示0",nTime="5,恭喜触发·白雪忆·丰丰;15,奇遇不封印·全程5-10分钟;60,1.对话步虚尘·往纯阳宫方向;120,2.对话苏卿若·返回步虚尘;180,3.前往巴陵·巴陵镇·说书人;210,4.油菜花田·季妍华·取灵芝;300,5.往苍山洱海方向山上·颜谷芝;360,6.对话叶颢轩·返回季妍华;420,7.返回纯阳·对话步虚尘·结束",nFrame=0,nClass=14,bHold=true,nIcon=12373,nRefresh=0,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="1.对话步虚尘·往纯阳宫方向"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="2.对话苏卿若·返回步虚尘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="3.前往巴陵·巴陵镇·说书人"},{nTime=600,nFrame=7,nClass=14,bHold=true,key="奇遇提示4",nIcon=12373,szName="4.油菜花田·季妍华·取灵芝"},{nTime=600,nFrame=7,nClass=14,bHold=true,key="奇遇提示5",nIcon=12373,szName="5.往苍山洱海方向山上·颜谷芝"},{nTime=600,nFrame=7,nClass=14,bHold=true,key="奇遇提示6",nIcon=12373,szName="6.对话叶颢轩·返回季妍华"},{nTime=600,nFrame=7,nClass=14,bHold=true,key="奇遇提示7",nIcon=12373,szName="7.返回纯阳·对话步虚尘·结束"}},szContent="纯阳弟子步虚尘好像有话对你说。"},
			{szTarget="步虚尘",szContent="十年离乱后，长大一相逢……"},
			{tCountdown={{szName="奇遇提示0",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nTime=0},{nTime=0,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="奇遇提示1"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="奇遇提示4"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="奇遇提示5"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示6",nIcon=12373,szName="奇遇提示6"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示7",nIcon=12373,szName="奇遇提示7"}},szContent="宠物已成功添加。"},
		},
		[8] = {
			{tCountdown={{nTime="5,恭喜触发·义千金·兰兰;15,奇遇不封印·约10分钟完成",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nRefresh=0,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·娜姿·前往·风啸林"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待·剧情·对话·张野"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="带着·小驴·前往·风雨镇"}},szContent="你打算再叫一盘，却看掌柜娜姿愁容满面，并没有注意到你。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·张野·带着·小驴"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="缓慢·前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="大、大哥，这个人看起来是个能打的……",szTarget="王开"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="带着·小驴·缓慢·移动"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="小驴很开心的跟着你。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·小驴·缓慢·移动"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="小驴停下脚步，它可能需要更多的鼓励，跟它聊聊天吧。",[14]={bCenterAlarm=true},szNote="交互·小驴"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="带着·小驴·缓慢·移动"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="小驴很开心，你去哪，它也去哪。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·张野·寻找·小驴"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="小驴跟丢了。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·张野·寻找·小驴"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·风雨镇·入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="进入·剧情·对话·兰伊"}},szContent="小驴跑远了，不见踪影，再回去找找吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·兰伊·返回·娜姿"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·兰伊·对话·方旬"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="交互·秘方·对话·娜姿"}},szContent="兰伊似乎有些不情愿，不若再与她谈谈。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·方旬·交互·秘方"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·娜姿·等待·剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·方旬·返回·兰伊"}},szContent="兰伊擦着眼泪去找兰兰告别，不远处的一位白衣侠客却示意你过去。"},
			{tCountdown={{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·方旬·返回·兰伊"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·兰伊·完成·奇遇"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇·义千金·宠物兰兰"}},szContent="娜姿生怕方旬反悔，当即在契上画了押，拿了金子。"},
			{tCountdown={{nTime="10,蹲宠·稻稻·已捕获;20,果子狸·CD·1小时",nFrame=7,nClass=14,key="蹲宠提示0",szName="蹲宠提示0",nRefresh=0,nIcon=4989}},szContent="稻稻已被好心侠士带走。",szTarget="神秘人",szNote="蹲宠·稻稻·已被捕获"},
			{tCountdown={{nTime=-1,nFrame=-1,nClass=14,key="比武·{$1}",nIcon=13,nRefresh=300,szName="比武·{$1}"},{nTime=-1,nFrame=-1,nClass=14,key="比武·{$2}",nIcon=13,nRefresh=300,szName="比武·{$2}"},{nTime=0,nFrame=-1,nClass=14,key="比武·{$me}",nIcon=1465,szName="比武·{$me}"},{nTime=5.25,nFrame=1,nClass=14,key="比武·{$1}",nIcon=1276,nRefresh=1,szName="【{$1}】·守擂开启"},{nTime=5.25,nFrame=1,nClass=14,key="比武·{$2}",nIcon=1276,nRefresh=1,szName="【{$2}】·挑战开启"}},szContent="(.-)和(.-)在擂台比武，有兴趣的侠士可前往观看。",szTarget="擂台裁判",bReg=true},
			{tCountdown={{nTime=42,nFrame=6,nClass=14,key="比武·{$me}",nIcon=1952,szName="洛阳擂台·挑战间隔"}},szContent="{$me}在比武中技高一筹，各位向她祝贺。",szTarget="擂台裁判"},
		},
		[9] = {
			{[14]={bCenterAlarm=true},tCountdown={{nTime=300,nFrame=6,nClass=14,key="急报成就",nIcon=13,szName="急报·沐云冲·拾取剩余"}},szContent="随着沐云冲被击退，地上出现了一块尘封之石，似乎记录着一些遗失的隐元秘鉴。",szNote="急报成就·沐云冲",szTarget="%"},
			{tCountdown={{nTime="5,恭喜触发·红衣歌·红绸;15,奇遇不封印·约15分钟完成;30,1.对话·老不知;90,2.前往·天罚林·莫清尘;120,3.对话·莫清尘·寻找·水井;150,4.水井在东北方·泥娃娃树下;160,5.使用·一只小陶罐;180,6.返回·莫清尘·对话·墨漓;240,7.前往·洛道上游瀑布·打水;300,8.返回·墨漓·对话·莫清尘;360,9.寻找·小泥娃娃·东北方向;390,10.对话·小貂儿;450,11.赎罪林·桥下·墨漓;480,12.返回·莫清尘·返回·墨漓;540,13.返回·莫清尘·返回·老不知;600,14.返回·莫清尘·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·老不知·天罚林·莫清尘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·莫清尘·寻找·水井"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·莫清尘·寻找·净水"}},szContent="哈哈，出窑了！你烧了个不错的陶罐子。",szTarget="老不知"},
			{tCountdown={{nTime="30,3.对话·莫清尘·寻找·水井;90,4.水井在东北方·泥娃娃树下;120,5.使用·一只小陶罐;150,6.返回·莫清尘·对话·墨漓;240,7.前往·洛道上游瀑布·打水;300,8.返回·墨漓·对话·莫清尘;360,9.寻找·小泥娃娃·东北方向;390,10.对话·小貂儿;450,11.赎罪林·桥下·墨漓;480,12.返回·莫清尘·返回·墨漓;540,13.返回·莫清尘·返回·老不知;600,14.返回·莫清尘·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="水井在东北方·泥娃娃树下"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="使用·一只小陶罐"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·莫清尘·对话·墨漓"}},szContent="水……水……",szTarget="莫清尘"},
			{tCountdown={{nTime="5,恭喜触发·胜负局·蟹胜;15,奇遇封印3日·每日约5分钟完成;30,1.对话·航小婷;90,2.前往·隐贤居·封博安;120,3.对话·封博安;150,4.交互·棋盘;180,5.对话·云定风;210,6.对话·封博安;220,第一日·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·洛道上游瀑布·打水"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="返回·墨漓·对话·莫清尘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="寻找·小泥娃娃·东北方向"}},szContent="这症状……你，你竟然给清尘喝了井水！！",szTarget="墨漓"},
			{tCountdown={{nTime="60,9.寻找·小泥娃娃·东北方向;90,10.对话·小貂儿;180,11.赎罪林·桥下·墨漓;240,12.返回·莫清尘·返回·墨漓;300,13.返回·莫清尘·返回·老不知;330,14.返回·莫清尘·结束",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·莫清尘·寻找·小泥娃娃"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·莫清尘·对话·小貂儿"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="赎罪林桥下·墨漓·返回莫清尘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="返回·墨漓·返回·莫清尘"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示5",nIcon=12373,szName="返回·老不知·返回·莫清尘"}},szContent="{$me}，清尘就拜托你了！我寻解药去去就回！",szTarget="墨漓"},
