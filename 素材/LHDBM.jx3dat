			{tCountdown={{nTime=10,nClass=14,key="小猪快跑",nIcon=3730,szName="帮会领地·小猪快跑·活动开启"}},szContent="【小猪快跑】活动正式开启，请众位侠士速回帮会协助三石叔赶回窜逃的小猪。若帮会总积分达到500分，则帮会和个人均会获得大量奖励！",szTarget="%",szNote="帮会领地·小猪快跑·活动开启"},
			{tCountdown={{nTime=10,nFrame=6,nClass=14,key="钓鱼活动",nIcon=3781,szName="帮会领地·钓鱼活动·40分钟"}},szContent="天上掉馅饼，鱼池落珍宝！刚得到可靠消息，韩非子夜观天象算准了在接下来的40分钟内，于唱晚池钓到稀有物品的概率将大幅增长，机不可失失不再来啊，速回帮会寻珍觅宝钓大鱼吧！",szTarget="%",szNote="帮会领地·钓鱼活动·正式开启"},
			{tCountdown={{nTime=10,nFrame=6,nClass=14,key="钓鱼活动",nIcon=3781,szName="帮会领地·钓鱼活动·20分钟"}},szContent="据韩非子最新消息，唱晚池将于20分钟后归于平静。在此之前于唱晚池钓到稀有物品的概率将大幅增长，机不可失失不再来啊。",szTarget="%",szNote="帮会领地·钓鱼活动·已经开启"},
			{tCountdown={{nTime=10,nFrame=6,nClass=14,key="菜园保卫战",nIcon=3766,szName="帮会领地·祝融山·猪九戒出现"}},szContent="猪九戒出现祝融山，请大家速去阻止它破坏农田。",szTarget="%",szNote="菜园保卫战·祝融山·猪九戒·出现"},
			{tCountdown={{nTime=20,nFrame=6,nClass=14,key="菜园保卫战",nIcon=3766,szName="帮会领地·菜园保卫战·完满达成"}},szContent="本周帮会菜园保卫战完满达成，增加了70000点不占周上限的帮会资金。",szTarget="%",szNote="帮会领地·菜园保卫战·完满达成"},
