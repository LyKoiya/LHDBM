			{tCountdown={{nTime=10,nFrame=0,nClass=20,key="门派事件1",nIcon=13,szName="五毒·门派事件·五毒总坛"}},szContent="原来是乌缇夜昨夜趁乱乔装混入五毒总坛，用天一教邪术催熟血魂巨蚊虫卵，引来嗜食血蚊的植兽“噬魂金虎”，愿侠士出手相助，将此邪恶之物铲除。\
"},
