			{col={100,100,255},tCountdown={{nTime=0,nClass=14,key="通用·矿车",nIcon=13,szName="通用·矿车"},{nTime=90,nFrame=7,nClass=14,key="浩气·矿车",szName="浩气·跟车奖励",nIcon=13,nRefresh=5}},szContent="浩气盟的众兄弟们，辛苦了！这是盟里给众兄弟们的奖赏，请各位收下。",szTarget="周也",szNote="浩气·跟车奖励"},
