			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="雪雪·剧情",nIcon=13,szName="雪雪·剧情阶段3·停云居门口河边"}},szContent="啊，雪雪的发簪不见了，可能是玩耍的时候弄丢了，雪雪要回去找找。大姐姐若是要找我的话，我就在停云居门口。",szTarget="雪雪"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="雪雪·剧情",nIcon=13,szName="雪雪·剧情阶段2·停云居门口河边"}},szContent="啊，雪雪突然想起来还有件要紧的事情要做。大姐姐若是要找我的话，我就在停云居门口的河边。",szTarget="雪雪"},
