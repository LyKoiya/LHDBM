			{tCountdown={{szName="等待·剧情·约3分钟",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=10}},szContent="恭喜侠士，成功冲破内府限制！"},
			{tCountdown={{szName="奇遇提示0",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nRefresh=0,nTime="15,互动·小牛;30,等待进度·归去来;60,前往摸宠点附近·盆盆船;90,盆盆船附近·交互·光圈;120,等待剧情·结束"},{szName="互动·小牛",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="等待进度·归去来·前往摸宠点",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="你冲破了无名毒药的束缚！趁此机会快去右边带着小牛前往白水村乘盆盆船逃跑吧！"},
			{tCountdown={{szName="奇遇提示0",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nTime=0},{szName="宠物奇遇·乱红鸾·结束",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=10},{szName="奇遇提示2",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=0}},szContent="嘁，燕燕，走了。",szTarget="孙千琳"},
			{tCountdown={{nTime="5,恭喜触发·寓天涯·莓莓;15,奇遇不封印·约10分钟完成;30,1.对话·附近·老书生;90,2.前往·流木村·阿玉;150,3.前往·白水村·对话·老书生;210,4.礼礼附近黄圈·寻找海螺壳;240,5.返回白水村·交互莓莓;300,6.进入老书生家里等待剧情;330,7.杂货商卢芦取药返回老书生;360,8.附近靠近阿玉等待剧情;420,9.返回老书生家里等待剧情;440,完成奇遇·寓天涯·莓莓",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·老书生·流木村·阿玉"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·白水村·对话·老书生"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="寻找·海螺壳·礼礼附近黄圈"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="返回·白水村·交互·莓莓"}},szContent="咳咳……咳……你们！",szTarget="老书生"},
			{tCountdown={{nTime="60,6.进入老书生家里等待剧情;90,7.杂货商卢芦取药返回老书生;120,8.附近靠近阿玉等待剧情;180,9.返回老书生家里等待剧情;200,完成奇遇·寓天涯·莓莓",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="进入·老书生家里·等待剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="附近·卢芦·取药·老书生"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="附近·阿玉·返回·老书生"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="等待·剧情·完成·寓天涯"}},szContent="王老先生，我方才在船上干活，没看好阿玉。没承想这孩子居然又闯下祸事，是我疏忽了，平日没将他教好。在这儿给您赔罪了。",szTarget="阿香"},
			{tCountdown={{nTime="30,7.杂货商卢芦取药返回老书生;90,8.附近靠近阿玉等待剧情;120,9.返回老书生家里等待剧情;140,完成奇遇·寓天涯·莓莓",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="附近·卢芦·取药·老书生"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="附近·阿玉·返回·老书生"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="等待·剧情·完成·寓天涯"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="奇遇提示4"}},szContent="只会告状，有本事你便和我打一架！",szTarget="阿玉"},
			{tCountdown={{nTime="90,9.返回老书生家里等待剧情;110,完成奇遇·寓天涯·莓莓",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nRefresh=0,nIcon=12373},{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·老书生·等待·剧情"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="消消气儿消消气儿，您可千万别发火，（扯上同伴）咱们这就走，这就走。",szTarget="黄崎帮帮众"},
			{tCountdown={{nTime=0,nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,szName="奇遇提示0"},{nTime=20,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="完成奇遇·寓天涯·莓莓"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="有意气才可行江湖，待变成我这般枯槁老头子便来不及了……我时日不多，莓莓便托付给你照顾了。你云游四方，便带着它一同见识天涯海角盛景吧，它见了，便等同于我也见了……",szTarget="老书生"},
		},
