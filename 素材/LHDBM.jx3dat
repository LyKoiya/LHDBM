		[49] = {
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件2·抵御狼牙·慕容枯"}},szContent="众弟子，随我迎敌！",szTarget="叶凡"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·名剑新生·开启"}},szContent="大胆狂徒！今日天下英雄尽聚于此，尔等焉敢猖狂，众弟子迎敌！",szTarget="叶炜"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·以贼试剑·慕容枯"}},szContent="都来了？也好，让我领教领教藏剑山庄的绝技。",szTarget="慕容古"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·以贼试剑·结束"}},szContent="这是……什么剑法……",szTarget="慕容古"},
			{tCountdown={{nTime="300,奇遇·三尺青锋·等待剧情;310,三尺青锋·对话·叶泊秋",nFrame=7,nClass=14,key="奇遇提示",nIcon=12372,nRefresh=600,szName="三尺青锋·等待剧情"}},szContent="你等速速前去禀告二庄主，请他带人查阅我藏剑典籍，查找天外陨石熔炼之法！",szTarget="叶泊秋"},
			{tCountdown={{nTime=-2,nClass=14,key="奇遇提示",nIcon=12372,szName="奇遇提示"},{nTime="30,对话·叶芳忠·一直加火;900,原地挂机·等待叶晖;1200,原地挂机·等待叶晖;1210,对话叶晖·选择橙武 ",nFrame=7,nClass=14,key="奇遇提示",nIcon=12372,nRefresh=1210,szName="三尺青锋·等待剧情"}},szContent="剑庐的叶芳忠乃我叶家控火第一人，少侠快协助他控制炉火吧",szTarget="叶泊秋"},
			{tCountdown={{nTime=-1,nClass=14,key="奇遇提示",nRefresh=99999,nIcon=12372,szName="奇遇提示"}},szContent="好剑！",szTarget="叶晖",szNote="完成奇遇·三尺青锋"},
			{tCountdown={{nTime="5,恭喜触发·归乡路·小蟹·童心客;15,奇遇不封印·约15分钟完成;30,需喂养·童心客·鱼虾类饲料",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·铸剑大师·前往·满陇东村"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·丁大力·被欺负的村民"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·藏剑山庄·对话·叶薇儿"}},szContent="天才！天才啊！",szTarget="铸剑大师"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·藏剑山庄·对话·叶薇儿"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·名华嫂·返回·叶薇儿"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·藏剑山庄桥上·丁大力"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示4",nIcon=12373,szName="返回·叶薇儿·神行·无量山"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示5",szName="前往·天下第一楼·梅陇镇镇民",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示6",szName="宇文述学·李虎子·糖葫芦贩子",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示7",szName="丁老爹·返回·叶薇儿·丁大力",nIcon=12373,bHold=true},{nTime=600,nFrame=7,nClass=14,key="奇遇提示8",szName="对话·叶薇儿·完成奇遇",nIcon=12373,bHold=true}},szContent="哼，我们走着瞧",szTarget="丁大力"},
			{tCountdown={{nTime="5,恭喜触发·莫贪杯·雀斑;15,奇遇不封印·但需做7天日常;30,给叶然送醒酒汤;40,期间不影响触发其他奇遇",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0}},szContent="行，那你帮我送送汤吧。",szTarget="王厨娘"},
			{tCountdown={{nTime="5,恭喜触发·莫贪杯·雀斑;15,奇遇不封印·约10分钟完成",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·叶然·获得·特供醒酒汤"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·虎跑山庄·西边·顾诗梵"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="等待·剧情结束·对话·顾诗梵"}},szContent="藏剑山庄的叶然好像有话对你说。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·顾诗梵·选中叶麟"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="使用·道具·特供醒酒汤"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·顾诗梵·等待剧情"}},szContent="禀夫人，还没有。",szTarget="侍女"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="等待·剧情·对话·叶蒙"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="交互·水缸·对话·叶蒙"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="选中·叶麟·使用一桶水"}},szContent="醒酒汤看起来对叶麟毫无用处，快去回禀顾夫人吧！"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·叶蒙·前往·南边房子"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待·剧情结束·对话·叶蒙"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="获得·干净的衣服·返回叶麟"}},szContent="看起来叶麟的酒醒了，快些回复叶蒙吧！"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·叶蒙·返回·叶麟"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·虎跑山庄·东北方"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·叶麟·捕捉·薮猫"}},szContent="叶麟的五十遍风来吴山已经练习完毕，快回去告诉叶蒙吧！"},
			{tCountdown={{nTime=60,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="等待·剧情·对话·顾诗梵"},{nTime=60,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="完成·奇遇·莫贪杯·雀斑"},{nTime=-1,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="麟儿！",szTarget="顾诗梵"},
			{tCountdown={{nTime=0,nFrame=0,nClass=14,szName="奇遇提示0",nIcon=12373,key="奇遇提示0"},{nTime=0,nFrame=7,nClass=14,szName="奇遇提示1",nIcon=12373,key="奇遇提示1"},{nTime=0,nFrame=7,nClass=14,szName="奇遇提示2",nIcon=12373,key="奇遇提示2"},{nTime=0,nFrame=7,nClass=14,szName="奇遇提示3",nIcon=12373,key="奇遇提示3"}},szContent="宠物已成功添加。",szNote="宠物奇遇·烟花戏·秋·瑞瑞"},
		},
