			{tCountdown={{nTime="30,前往思齐书院·对话高跖;40,可提前打开快捷商城准备;60,各购买1个·[浣花笺][朱砂墨];90,可额外获得·六炉金龙丹;120,注意提交材料时选对选项",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·思齐书院·对话·高跖"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待·剧情结束·对话·高跖"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="准备·浣花笺·朱砂墨·高跖"}},szContent="那人似乎是往思齐书院的方向去了，快快去追"},
