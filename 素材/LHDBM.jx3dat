			{tCountdown={{bHold=true,szName="恭喜触发奇遇·白日梦",nFrame=0,nClass=14,key="奇遇监控0",nIcon=12373,nRefresh=0,nTime="5,恭喜触发·破巧言·蛋黄;15,奇遇不封印·约20分钟完成;30,1.对话·宋子尧·等待剧情;120,2.对话·宋子尧身后·赵诚;150,3.对话·客栈角落·大汉;180,4.返回·对话·宋子尧;300,5.前往·客栈外山崖·宋子尧;360,6.往孙易云方向走·等待剧情;420,7.前往对面山崖·对话·胡商;480,8.跟随·胡商·别跳崖;540,9.拾取·包裹·返回·客栈内;600,10.对话·宋子尧·对话·赵诚;660,11.前往·长生雪野·长生右边;720,12.两个帐篷前光圈·捕获小鸟边;780,13.使用·精致的盒子·跟随小鸟;840,13.前往·山洞·直行;900,14.对话·宋子尧·王必言;930,15.返回·客栈·闻千瞬;960,16.对话·闻千瞬·结束"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="对话·宋子尧·等待剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="对话·宋子尧身后·赵诚"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·客栈角落·大汉"}},szContent="我给你说！你猜我在客栈看到谁了？金虚子卓凤鸣！不过他身边跟着好多弟子，只能远远看一眼。有生之年居然能亲见武林高人风姿，真是不愧此行啊！",szNote="破巧言",szTarget="宋子尧"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="对话·宋子尧身后·赵诚"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="对话·客栈角落·大汉"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="返回·对话·宋子尧"}},szContent="算了算了，还是去问问那位公子哥吧！",szNote="破巧言"},
			{tCountdown={{key="奇遇监控0",nTime="30,4.返回·对话·宋子尧;150,5.前往·客栈外山崖·宋子尧;240,6.往孙易云方向走·等待剧情;300,7.前往对面山崖·对话·胡商;480,8.跟随·胡商·别跳崖;540,9.拾取·包裹·返回·客栈内;600,10.对话·宋子尧·对话·赵诚;660,11.前往·长生雪野·长生右边;720,12.两个帐篷前光圈·捕获小鸟边;780,13.使用·精致的盒子·跟随小鸟;840,13.前往·山洞·直行;900,14.对话·宋子尧·王必言;930,15.返回·客栈·闻千瞬;960,16.对话·闻千瞬·结束",nFrame=0,nClass=14,bHold=true,nRefresh=0,nIcon=12373,szName="奇遇监控0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="返回·对话·宋子尧"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="前往·客栈外山崖·宋子尧"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="往孙易云方向走·等待剧情"}},szContent="这王二很可疑！回去找宋子尧再商讨商讨。",szNote="破巧言"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="等待剧情·前往对面山崖"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="大石头后·等假药商人·胡商"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·假药商人·胡商"}},szContent="你是谁？",szNote="破巧言",szTarget="孙易云"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="前往对面山崖·大石头后"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="等假药商人·胡商"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·假药商人·胡商"}},szContent="驼背……胡商……！莫非正是那王二！不若前去看看。",szNote="破巧言"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="跟随·胡商·别跳崖"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="拾取·包裹·返回·客栈内"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·宋子尧·对话·赵诚"}},szContent="暗号没对上，胡商跑了，快去追他！",szNote="破巧言"},
			{tCountdown={{bHold=true,szName="奇遇监控0",nFrame=0,nClass=14,key="奇遇监控0",nIcon=12373,nRefresh=0,nTime="30,9.拾取·包裹·返回·客栈内;60,10.对话·宋子尧·对话·赵诚;120,11.前往·长生雪野·长生右边;240,12.两个帐篷前光圈·捕获小鸟边;360,13.使用·精致的盒子·跟随小鸟;420,13.前往·山洞·直行;480,14.对话·宋子尧·王必言;540,15.返回·客栈·闻千瞬;600,16.对话·闻千瞬·结束"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="拾取·包裹·返回·客栈内"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="对话·宋子尧·对话·赵诚"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·宋子尧·前往长生雪野"}},szContent="悬崖边上似乎有个精致的盒子，是胡商不小心落下的……",szNote="破巧言"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="前往·长生雪野·长生右边"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="两个帐篷前·光圈·捕获小鸟"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="使用·精致的盒子·跟随小鸟"}},szContent="我打听得知那鸟经常出现在长生雪野附近，你先过去，我随后就来。",szNote="破巧言",szTarget="宋子尧"},
			{tCountdown={{key="奇遇提示0",nTime="120,13.使用·精致的盒子·跟随小鸟;180,13.前往·山洞·直行;210,14.对话·宋子尧·王必言;240,15.返回·客栈·闻千瞬;300,16.对话·闻千瞬·结束",nFrame=0,nClass=14,bHold=true,nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="与小鸟·保持4-15尺"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="山洞在·生字左侧"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="前往·山洞·直行"}},szContent="小胖鸟好像要离开！和宋子尧一起跟随鸟儿",szNote="破巧言"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",bHold=true,nIcon=12373,szName="山洞在·生字左侧"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="前往·山洞·直行"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="对话·宋子尧·王必言"}},szContent="小胖鸟和宋子尧往那边山洞去了，不若前去看看。",szNote="破巧言"},
