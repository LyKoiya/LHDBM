		[158] = {
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·药师观·接应阶苔"}},szContent="走吧，曹将军还在等我们。",szTarget="阶苔"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·接应阶苔·结束"}},szContent="多谢诸位侠士鼎立相助，阶苔在此谢过。",szTarget="阶苔"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·药师观·刺客袭击"}},szContent="请诸位侠士为我守护片刻。",szTarget="阶苔"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·药师观·游龙先生"}},szContent="大好头颅在此，尽管来拿！",szTarget="阶苔"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·游龙先生·结束"}},szContent="人多势众，算什么好汉！我隐元会不会放弃的！",szTarget="游龙先生"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·药师观·击退无名"}},szContent="有点本事，那我来亲自会会你。",szTarget="无名"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·击退无名·结束"}},szContent="今天我奈何不得你天策府，自然不会再纠缠此事。不过，我却做不了安将军的主，就此告辞。",szTarget="无名"},
			{tCountdown={{nTime=30,nClass=14,key="任务提示1",nIcon=947,szName="攻击·阿飞·接取任务"}},szContent="阿飞似乎嗅到了什么，吠叫着向你冲来……"},
			{tCountdown={{nTime="10,蹲宠·阿飞·已捕获;20,士兵的包裹·CD·2-3小时",nFrame=7,nClass=14,key="蹲宠提示0",szName="蹲宠提示0",nRefresh=0,nIcon=4937}},szContent="士兵的包裹中的染血护甲残片已被好心侠士带走。",szNote="蹲宠·阿飞·已被捕获",szTarget="神秘人"},
		},
