			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·段明燕·前往·晚山镇"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="交互·段明燕·身边·光圈点"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·段明燕·前往溶洞入口"}},szContent="你们找到了小猫的线索，但小猫仍然不见踪迹，不若再去问问一旁的段明燕。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·段明燕·前往溶洞入口"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="靠近·溶洞里面的石台·剧情"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·段明燕·返回·摸宠点"}},szContent="苇草素白，与晚山镇的小桥流水交相映衬，但小猫仍不见踪影，还会去哪儿呢？不若再去与段明燕讨论一番。"},
			{tCountdown={{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·段明燕·返回·出云寨"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·元五·完成·宠物奇遇"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="获得·风花雪·小猫咪·蓝蓝"}},szContent="小猫咪静静地望着荧荧的湖水。"},
		},
