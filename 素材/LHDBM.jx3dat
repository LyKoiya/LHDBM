			{tCountdown={{nTime=10,nClass=14,key="宇文画·刷新",nIcon=4891,szName="宇文画·已刷新"}},szContent="那个东瀛的小子你给我出来，带着人在我十二连环坞的地头上装神弄鬼，搞什么呢，弟兄们，砸了他们的场子！",szTarget="宇文画"},
