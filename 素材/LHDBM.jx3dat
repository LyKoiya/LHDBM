			{tCountdown={{nTime=202,nFrame=4,nClass=14,key="公共事件1",nIcon=13,szName="李怀仙|正直·刷新剩余"}},szContent="你获得了事件【进击·史朝义营寨！】的奖励",szNote="公共事件"},
			{szNote="公共事件",szContent="你获得了事件【援助晋祠】的奖励"},
			{tCountdown={{nTime=10,nClass=14,key="公共事件1",nIcon=13,szName="李怀仙|正直·刷新"}},szContent="狼牙军又来骚扰晋祠了，请侠士们帮助我们消灭他们！",szNote="公共事件",szTarget="王岳明"},
			{szNote="公共事件",szContent="快点快点，早点儿走到高大帅的营寨还能赶上开伙吃饭！",szTarget="王苍浪"},
			{szNote="公共事件",szContent="不好了！狼牙军又想占领杏花村了！快来人帮帮我们呀！",szTarget="温茹"},
			{tCountdown={{nTime=20,nFrame=6,nClass=14,key="落难侠客",nIcon=726,szName="落难侠客·奖励包裹·出现"}},szContent="多谢各位仗义相助，在下的伤已经好的差不多了！",szTarget="落难侠客",szNote="落难侠客·奖励包裹"},
			{[14]={bCenterAlarm=true},tCountdown={{nTime=60,nFrame=0,nClass=14,key="奇遇提示0",nIcon=13,szName="苍云·明教·放过分支·4千侠行点"}},szContent="至于我，就随你们处置好了。",szNote="苍云·明教·放过分支·4千侠行点",szTarget="秋画扇"},
			{tCountdown={{nTime="5,恭喜触发·雁难归·穗悠悠;15,奇遇不封印·约10分钟完成",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·流民老奶奶·向北城门"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·路平安·上城墙·东面"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·老雁·旧木笛·兵牌"}},szContent="流民老奶奶似有话想对你说。",szNote="恭喜触发·宠物奇遇·雁难归·穗悠悠"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·路平安·对话·奚知明"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待·剧情·对话·老雁两次"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="背对·城墙·大树下拾取木料"}},szContent="兵牌和木笛的组合还挺奇怪，不若跟路平安再讨论一番。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="背对·城墙·大树下拾取木料"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·奚知明·对话·老雁"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="剧情·QTE·对话·老雁"}},szContent="老丈似有意动，再跟他聊聊。"},
			{tCountdown={{nTime=30,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·老雁·完成·奇遇"},{nTime=30,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="宠物奇遇·雁难归·穗悠悠"},{nTime=-1,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="过奖过奖。",szTarget="路平安"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·被抢夺的矿石箱"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·史思明营寨西北帐篷"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·边澈·返回·矿场"}},szContent="半个时辰过去了，边澈还没有回来，还是去牛廷阶营寨看一下吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="交互·被抢夺的矿石箱"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="前往·史思明营寨西北帐篷"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·边澈·返回·矿场"}},szContent="你没有看到边澈，只看到一串血迹往史思明营寨方向。"},
