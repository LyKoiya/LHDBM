		[193] = {
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·养兵千日·结束"}},szContent="今日收获了如此之多的寒冰雪莲，众将士辛苦了！不过大敌当前，仍需加紧训练！",szTarget="燕安"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件·养兵千日·开启"}},szContent="探子来报，奚人近日恐是要进攻了，大家务必抓紧训练！通过苍云堡内的训练可获寒冰雪莲，上缴者有赏！",szTarget="燕安"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·地图标记·萨楚日"}},szContent="我萨楚日率兵前来攻城！苍云小儿若是快快打开城门就放你们一条生路！哈哈哈哈！",szTarget="萨楚日"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·萨楚日·结束"}},szContent="今日东陉关得守，不仅是众苍云将士之功，更要多谢各位武林豪杰相助！",szTarget="申屠远"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件2·地图标记·塔拉"}},szContent="想不到你们在如此情况下还能坚持这么久，看来是我们小瞧了你们！",szTarget="塔拉"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件2·塔拉·结束"}},szContent="多谢各路英豪前来相助，苍云的众将士也打起精神来，务必要守住这东陉关！",szTarget="申屠远"},
			{tCountdown={{nTime=20,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件3·地图标记·唐和斯"}},szContent="萨楚日和塔拉那两个废物真是给奚人丢脸，哼，受死吧！",szTarget="唐和斯"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·锡喇·锡尔哈·结束"}},szContent="真是废物，连这种小事都做不好！哼！",szTarget="库莫"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件2·地图标记·库莫"}},szContent="废话还真是多！众将士听令！",szTarget="长孙忘情"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件2·库莫·结束"}},szContent="哼！就凭你们便妄图灭我苍云军？真是自不量力！全军听令！今日便让这狂妄之徒有来无回！",szTarget="长孙忘情"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·锡喇·锡尔哈·结束"}},szContent="胆敢前来犯我苍云军者，诛！",szTarget="长孙忘情"},
			{tCountdown={{nTime=10,nClass=14,key="奇遇提示0",szName="左边·第一排·第二个",nIcon=13,nRefresh=5}},szContent="再靠近秋叶华的墓碑一点。",szNote="故园风雨"},
			{tCountdown={{nTime=10,nClass=14,key="奇遇提示0",szName="左边·第一排·第二个",nIcon=13,nRefresh=5}},szContent="请在秋叶华附近使用。",szNote="故园风雨"},
			{tCountdown={{nTime=0,nClass=14,key="奇遇提示0",nIcon=13,szName="奇遇提示0"}},szContent="你埋下了一个香囊。",[14]={bCenterAlarm=true},szNote="返回·沈园地牢·对话·受伤的女子"},
			{tCountdown={{key="奇遇提示0",nTime="5,恭喜触发·戎马边·贵贵;15,奇遇封印3日;30,对话白芷沅·获得未完成的地图;180,前往以下地图·使用未完成的地图;600,前往太原·怀德门·栾志辉",nFrame=0,nClass=14,bHold=true,nIcon=12373,nRefresh=0,szName="奇遇提示0"},{nTime=1200,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·白芷沅·20分钟内完成"},{nTime=1200,nFrame=7,nClass=14,key="奇遇提示2",bHold=true,nIcon=12373,szName="神行·龙门荒漠·玉门关"},{nTime=1200,nFrame=7,nClass=14,key="奇遇提示3",bHold=true,nIcon=12373,szName="神行·阴山大草原·沼泽驿站"},{nTime=1200,nFrame=7,nClass=14,key="奇遇提示4",bHold=true,nIcon=12373,szName="神行·黑戈壁·黑水城"}},szContent="不错不错，你很有画地图的天赋。",szTarget="白芷沅"},
		},
