			{tCountdown={{nTime="5,恭喜触发·授太平·十四;15,奇遇不封印·约10分钟完成",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nRefresh=0,szName="奇遇提示0"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·姜堰·前往·山阳村内"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="交互·光圈·等待·剧情结束"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·姜通·交互·严辽"}},szContent="今天姜堰似乎还有很多话想同你说，再和他聊聊吧。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="前往·山阳村内·交互·光圈"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待·剧情结束·对话·姜通"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="交互·严辽·等待·剧情结束"}},szContent="远处忽然传来吵闹声，去看看。"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·姜通·交互·严辽"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="等待剧情·对话·韦应物"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="前往·江天夜宴·沧浪洲"}},szContent="山阳村竟敢杀害朝廷命官，弟兄们，快回去禀告刺史！撤！",szTarget="随行小吏"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·韦应物·前往·江天夜宴"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="神行·江天夜宴·车夫·沧浪洲"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="交互·光圈点·等待·剧情结束"}},szContent="那真是可惜。",szTarget="陌生男子"},
			{tCountdown={{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·翼奴·前往·住宅东南"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·镜归渊·等待剧情结束"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·山阳村内·对话·姜堰"}},szContent="让贵人放心便是。",szTarget="翼奴"},
			{tCountdown={{nTime=75,nClass=14,key="奇遇提示0",nIcon=13,szName="剧情·结束剩余"}},szContent="在下韦应物。",szTarget="韦应物"},
			{tCountdown={{nTime=120,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="返回·山阳村·对话·姜堰"},{nTime=120,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="完成·奇遇·授太平·十四"},{nTime=-1,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="奇遇提示3"}},szContent="先生所求，当会如愿。",szTarget="镜归渊"},
			{tCountdown={{szName="奇遇提示0",nFrame=0,nClass=14,key="奇遇提示0",nRefresh=0,nIcon=12373,nTime="5,恭喜触发夜哀鸣;15,奇遇不封印·约15分钟完成;30,1.西南方·寻找·晚霖;60,2.树下光圈蹲点·交互·猴子;120,3.对话·晚霖·找段方北;150,4.采摘·止血草并使用;180,5.武狱黑牢山顶·寻找·和光;240,6.武狱黑牢东北·采摘·甜果;300,7.返回山顶·领狐猴·使用甜果;360,8.对话·和光·交互·领狐猴;390,9.对话·和光;400,夜哀鸣·结束"},{szName="1.西南方·寻找·晚霖",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="2.树下光圈蹲点·交互·猴子",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="我回忆了一下，似乎……确实有可怕的声音，会不会是闹鬼呀！我们一起去找晚霖姐姐吧。",szTarget="逗逗"},
			{tCountdown={{szName="3.对话·晚霖·找段方北",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="4.找止血草并使用·再找和光",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="你捉住了这只小家伙，带给晚霖看看吧"},
			{tCountdown={{szName="5.武狱黑牢山顶·寻找·和光",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="6.武狱黑牢东北·采摘·甜果",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="段方北建议你带着猴儿去找和光。"},
			{tCountdown={{szName="6.武狱黑牢东北·采摘·甜果",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="7.返回山顶·领狐猴·使用甜果",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="但修习如何医治动物，又何须血脉？",szTarget="和光"},
			{tCountdown={{szName="8.对话·和光·交互·领狐猴",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=60},{szName="9.对话·和光·结束",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=60}},szContent="小猴果然被甜果吸引"},
			{tCountdown={{szName="奇遇提示0",nFrame=0,nClass=14,key="奇遇提示0",nIcon=12373,nTime=0},{szName="奇遇提示1",nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,nTime=0},{szName="奇遇提示2",nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,nTime=0}},szContent="宠物已成功添加。"},
