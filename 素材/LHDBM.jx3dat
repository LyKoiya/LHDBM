			{[14]={bCenterAlarm=true,bScreenHead=true},col={0,255,0},szTarget="李龟年",szContent="龟年被困多日，最遗憾的是还没有将平生所长整理成籍，造福后人。幸得侠士相救！",szNote="李龟年·已解救"},
			{[14]={bCenterAlarm=true,bScreenHead=true},col={0,255,0},szTarget="舒尽忠",szContent="救命之恩，日后定当相报，多谢！",szNote="舒尽忠·已解救"},
