			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件1",nIcon=13,szName="门派事件1·音律之试·结束"}},szContent="壁垒的坚固程度往往与抚琴者的内力相合。众位侠士花了这许时间才破除壁垒，可见贤弟的弦歌比几月前又精进了。",szTarget="杨青月"},
			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件2",nIcon=13,szName="门派事件2·音律之试·幻影·开启"}},szContent="好，这就开始。随我来!",szTarget="赵宫商"},
