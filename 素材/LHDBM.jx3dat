			{tCountdown={{nTime=10,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·音律之试·幻影·开启"}},szContent="宫商的《清弦引梦》现进入第二阶段，我们继续跟着。",szTarget="杨青月"},
			{tCountdown={{nTime=5,nFrame=3,nClass=14,key="门派事件3",nIcon=13,szName="门派事件3·音律之试·结束"}},szContent="嗯，待他从梦境中醒来细聊。",szTarget="杨青月"},
			{tCountdown={{nTime="5,恭喜触发·儿女事·小乌龟·星辰;15,奇遇不封印·约10分钟完成;45,1.对话阿秋·对话邓斌;90,2.前往怀仁斋·对话杜甫王维;120,3.前往碑铭·琴声十六法卷三·张九龄;150,4.前往翠湄居·对话崖牙;180,5.返回邓斌·获得地图和隐匿机关;210,6.打开背包使用地图;300,前往标记点·小地图有绿点",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·阿秋·对话·邓斌"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="崖牙·张九龄·杜甫·王维"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="返回·邓斌·使用·地图"}},szContent="侠士留步，我看看你钓上来的小乌龟。",szTarget="阿秋"},
