			{tCountdown={{nTime="5,恭喜触发·故岁辞·岁岁;15,奇遇不封印·约10分钟完成;30,1.对话槲生·寻找散落的羽毛;60,2.羽毛在东南方屋子下;90,3.返回对话槲生;180,4.对话赵永·潘春·何实;210,5.对话槲生·前往光圈;240,6.光圈在散落的羽毛附近;300,7.对话龙俊华·等待剧情;330,8.对话龙俊华·前往车夫北面溪水;360,9.交互光圈·交互鸟笼;390,10.对话龙俊华·对话槲生;410,完成奇遇·故岁辞·岁岁",nFrame=0,nClass=14,key="奇遇提示0",szName="奇遇提示0",nIcon=12373,nRefresh=0},{nTime=600,nFrame=7,nClass=14,key="奇遇提示1",nIcon=12373,szName="对话·槲生·寻找·散落的羽毛"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示2",nIcon=12373,szName="对话·槲生·对话·赵永"},{nTime=600,nFrame=7,nClass=14,key="奇遇提示3",nIcon=12373,szName="对话·潘春·对话·何实"}},szContent="大侠，岁岁不见了！",szTarget="槲生"},
