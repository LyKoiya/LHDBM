		[122] = {
			{tCountdown={{nTime=10,nFrame=0,nClass=20,key="门派事件1",nIcon=13,szName="唐门·门派事件·唐家堡"}},szContent="唐门的机甲之战方告一段落，今日狼牙军官拔野古寒上唐门欲取订好的机关暗器，只是唐门已无备好的暗器，此事要如何了结？诸位侠士可去唐家堡获知此事结果。\
"},
			{tCountdown={{nTime=10,nFrame=0,nClass=20,key="门派事件1",nIcon=13,szName="唐门·门派事件·唐家堡"}},szContent="安禄山在范阳举起反旗，天下人人侧目。唐门门主唐傲天却甘冒天下之大不韪，偷偷贩售门中机关暗器予狼牙军和唐军两者，获得大批钱财。唐傲侠发现了他私底下的交易，不耻唐傲天所为，派大儿子唐无寻破坏门主准备好的机关。此事亦被掌管暗器的唐无乐发觉，两兄弟在唐门唐家堡用机甲对决，诸位侠士可前去一观输赢。\
"},
