			{[14]={bCenterAlarm=true},bReg=true,tCountdown={{nTime=30,nFrame=6,nClass=14,key="门派日常",nIcon=13,szName="拾取·{$1}"}},szContent="我知道我知道，先生说的是(.-)！",szNote="拾取·{$1}",szTarget="睿儿"},
