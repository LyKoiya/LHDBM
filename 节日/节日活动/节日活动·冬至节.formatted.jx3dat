			{[14]={bCenterAlarm=true},szContent="门客栖迟加入队伍！",szNote="万灵·栖迟·输出·外功",szTarget="%",tCountdown={{key="门客·栖迟",nClass=14,nFrame=7,nIcon=19598,nTime=10,szName="万灵·栖迟·输出·外功"}}},
			{[14]={bCenterAlarm=true},szContent="门客段树加入队伍！",szNote="段氏·段树·输出·混元",szTarget="%",tCountdown={{key="门客·段树",nClass=14,nFrame=7,nIcon=22814,nTime=10,szName="段氏·段树·输出·混元"}}},
			{[14]={bCenterAlarm=true},szContent="门客闻苗加入队伍！",szNote="丐帮·闻苗·输出·外功",szTarget="%",tCountdown={{key="门客·闻苗",nClass=14,nFrame=7,nIcon=4892,nTime=10,szName="丐帮·闻苗·输出·外功"}}},
			{[14]={bCenterAlarm=true},szContent="门客叶方卉加入队伍！",szNote="藏剑·叶方卉·输出·外功",szTarget="%",tCountdown={{key="门客·叶方卉",nClass=14,nFrame=7,nIcon=7502,nTime=10,szName="藏剑·叶方卉·输出·外功"}}},
			{[14]={bCenterAlarm=true},bReg=true,szContent="^门客(.-)身负重伤，不能再战，先行撤退",szNote="门客·{$1}·重伤",tCountdown={{key="门客·{$1}",nClass=14,nFrame=1,nIcon=13,nRefresh=1,nTime=2,szName="门客·{$1}·重伤"}}},
			{[14]={bCenterAlarm=true},bReg=true,szContent="^门客(.-)提升到了第(.-)。",szNote="门客·{$1}·{$2}",szTarget="%"},
			{[14]={bCenterAlarm=true},szContent="在下先行撤退！",szNote="门客·{$sender}·撤退",szTarget="%",tCountdown={{key="门客·{$sender}",nClass=14,nFrame=1,nIcon=13,nRefresh=1,nTime=2,szName="门客·{$sender}·撤退"}}},
			{szContent="小红，我要出门啦！外面太冷了你就乖乖在这里等我回来哦！",szTarget="柴钗",tCountdown={{key="柴钗采货",nClass=14,nFrame=7,nIcon=13,nRefresh=0,nTime="751,柴钗·采货剩余;760,柴钗·即将归来;856,柴钗·休息剩余;865,柴钗·休息结束",szName="柴钗"}}},
			{szContent="土特产，土特殊，你们这特产是真的很土……已经卖光？那我岂不是失去了土的机会？",szTarget="游客",tCountdown={{key="特产提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="盐雁·特产总管·缺货"}}},
			{szContent="家里还嘱咐我买点特产回去，结果竟然没有了？",szTarget="游客",tCountdown={{key="特产提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="盐雁·特产总管·缺货"}}},
			{szContent="竟然连药包都没有？这儿是不是快要倒闭了啊……",szTarget="游客",tCountdown={{key="药材提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="苦酷·药材总管·缺货"}}},
			{szContent="卖光了？！你们真的很不会做生意诶，我这样的人来买药包，是难得的好吗？！",szTarget="游客",tCountdown={{key="药材提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="苦酷·药材总管·缺货"}}},
			{szContent="哎……没有药包就算了吧，想花银子都花不出去。",szTarget="游客",tCountdown={{key="药材提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="苦酷·药材总管·缺货"}}},
			{szContent="汤药都没有你们还想不想做生意了？！",szTarget="游客",tCountdown={{key="药材提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="苦酷·药材总管·缺货"}}},
			{szContent="你们这毫无设计感的衣服都能卖光？世间之大，无奇不有，绝了。",szTarget="游客",tCountdown={{key="衣饰提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="酸狻·衣饰总管·缺货"}}},
			{szContent="连水都没有？！啊，我缺水了，有没有人给我浇浇水啊……",szTarget="游客",tCountdown={{key="茶水提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="茶姹·茶水总管·缺货"}}},
			{szContent="没水喝吗？要渴死了！",szTarget="游客",tCountdown={{key="茶水提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="茶姹·茶水总管·缺货"}}},
			{szContent="来两斤不掺水的好酒？啥？酒卖光了？行吧，你开心就好，再见吧。",szTarget="游客",tCountdown={{key="酒水提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="醋簇·酒水总管·缺货"}}},
			{szContent="酒都没有，真无趣。",szTarget="游客",tCountdown={{key="酒水提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="醋簇·酒水总管·缺货"}}},
			{szContent="没吃的了吗？好饿啊。",szTarget="游客",tCountdown={{key="厨房提示",nClass=14,nFrame=4,nIcon=13,nRefresh=900,nTime=10,szName="辛杏·厨房小吃·缺货"}}},
		},
	},
